---
interface Props {
  value: number;
  max?: number;
  label?: string;
  showValue?: boolean;
  tone?: 'primary' | 'sky' | 'success' | 'gold';
  size?: 'sm' | 'md' | 'lg';
}

const {
  value,
  max = 100,
  label = 'Progress belajar',
  showValue = true,
  tone = 'primary',
  size = 'md',
} = Astro.props;

const percentage = Math.max(0, Math.min(100, Math.round((value / Math.max(max, 1)) * 100)));
---

<div class="progress-wrap">
  {(label || showValue) && (
    <div class="progress-meta">
      <span>{label}</span>
      {showValue && <strong>{percentage}%</strong>}
    </div>
  )}
  <div
    class:list={['progress-track', `is-${size}`]}
    role="progressbar"
    aria-label={label}
    aria-valuemin="0"
    aria-valuemax={max}
    aria-valuenow={value}
  >
    <span class:list={['progress-fill', `is-${tone}`]} style={`width: ${percentage}%`}></span>
  </div>
</div>

<style>
  .progress-wrap { width: 100%; }
  .progress-meta { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 0.5rem; color: var(--color-muted); font-size: 0.82rem; font-weight: 700; }
  .progress-meta strong { color: var(--color-ink); font-family: var(--font-heading); }
  .progress-track { overflow: hidden; width: 100%; border-radius: 999px; background: #dfebf8; box-shadow: inset 0 1px 2px rgba(8, 26, 58, 0.08); }
  .progress-track.is-sm { height: 0.45rem; }
  .progress-track.is-md { height: 0.7rem; }
  .progress-track.is-lg { height: 0.95rem; }
  .progress-fill { display: block; height: 100%; min-width: 0; border-radius: inherit; transition: width 400ms ease; }
  .progress-fill.is-primary { background: var(--color-phinisi-600); }
  .progress-fill.is-sky { background: var(--color-sky); }
  .progress-fill.is-success { background: var(--color-success); }
  .progress-fill.is-gold { background: var(--color-gold); }
</style>
