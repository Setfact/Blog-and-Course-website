---
interface Props {
  href?: string;
  variant?: 'default' | 'soft' | 'navy' | 'success' | 'danger' | 'gold';
  padding?: 'sm' | 'md' | 'lg';
  interactive?: boolean;
  class?: string;
}

const {
  href,
  variant = 'default',
  padding = 'md',
  interactive = Boolean(href),
  class: className,
} = Astro.props;

const classes = ['ph-card', `is-${variant}`, `pad-${padding}`, interactive && 'is-interactive', className];
---

{href ? (
  <a href={href} class:list={classes}><slot /></a>
) : (
  <article class:list={classes}><slot /></article>
)}

<style>
  .ph-card {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: white;
    color: var(--color-ink);
    text-decoration: none;
  }

  .pad-sm { padding: 1rem; }
  .pad-md { padding: 1.4rem; }
  .pad-lg { padding: clamp(1.5rem, 4vw, 2.25rem); }

  .is-soft { background: var(--color-section); }
  .is-navy { border-color: var(--color-navy-soft); background: var(--color-navy); color: white; }
  .is-success { border-color: #b9e6c9; background: var(--color-success-soft); }
  .is-danger { border-color: #ffc8cc; background: var(--color-danger-soft); }
  .is-gold { border-color: #f5d98f; background: var(--color-gold-soft); }

  .is-interactive {
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .is-interactive:hover {
    transform: translateY(-2px);
    border-color: var(--color-phinisi-300);
    box-shadow: var(--shadow-soft);
  }
</style>
