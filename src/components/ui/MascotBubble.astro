---
interface Props {
  title?: string;
  message: string;
  mood?: 'welcome' | 'hint' | 'success' | 'warning';
  imageSrc?: string;
  imageAlt?: string;
  compact?: boolean;
  class?: string;
}

const {
  title = 'Nisi bilang:',
  message,
  mood = 'welcome',
  imageSrc,
  imageAlt = 'Nisi, maskot Phinisi Learn',
  compact = false,
  class: className,
} = Astro.props;
---

<aside class:list={['mascot-bubble', `is-${mood}`, compact && 'is-compact', className]}>
  <div class="mascot-frame">
    {imageSrc ? (
      <img src={imageSrc} alt={imageAlt} loading="eager" />
    ) : (
      <div class="mini-router" aria-hidden="true">
        <span class="sail"></span>
        <span class="eyes">⌒‿⌒</span>
        <span class="lights"><i></i><i></i><i></i></span>
      </div>
    )}
  </div>
  <div class="bubble-copy">
    <strong>{title}</strong>
    <p>{message}</p>
    <slot />
  </div>
</aside>

<style>
  .mascot-bubble { position: relative; display: grid; grid-template-columns: minmax(120px, 0.72fr) minmax(0, 1.28fr); align-items: center; gap: 1rem; overflow: hidden; border: 1px solid var(--color-phinisi-200); border-radius: 1.5rem; padding: 0.85rem 1.1rem 0.85rem 0.75rem; background: white; box-shadow: var(--shadow-card); }
  .mascot-bubble::after { position: absolute; right: -35px; bottom: -50px; width: 130px; height: 130px; border-radius: 50%; background: var(--color-sky-soft); content: ''; opacity: 0.65; }
  .mascot-frame { position: relative; z-index: 1; overflow: hidden; aspect-ratio: 1; border-radius: 1.15rem; background: #fffaf2; }
  .mascot-frame img { width: 100%; height: 100%; object-fit: cover; }
  .bubble-copy { position: relative; z-index: 1; }
  .bubble-copy strong { color: var(--color-phinisi-700); font-family: var(--font-heading); font-size: 0.82rem; font-weight: 800; }
  .bubble-copy p { margin: 0.35rem 0 0; color: var(--color-ink); font-family: var(--font-heading); font-size: clamp(0.95rem, 2.4vw, 1.12rem); font-weight: 700; line-height: 1.42; }
  .is-success { border-color: #b9e6c9; background: var(--color-success-soft); }
  .is-success .bubble-copy strong { color: #13783d; }
  .is-warning { border-color: #f5d98f; background: var(--color-gold-soft); }
  .is-warning .bubble-copy strong { color: #8a5b00; }
  .is-hint { border-color: #a8e7ff; background: var(--color-sky-soft); }
  .is-compact { grid-template-columns: 84px 1fr; border-radius: 1.15rem; }
  .mini-router { position: absolute; inset: 27% 9% 10%; display: grid; place-items: center; border: 4px solid var(--color-navy); border-radius: 42%; background: var(--color-phinisi-600); color: var(--color-sky); }
  .sail { position: absolute; bottom: 88%; left: 28%; width: 47%; height: 60%; border: 3px solid #a46711; background: #fff0cc; clip-path: polygon(45% 0, 100% 100%, 0 100%); }
  .eyes { font-family: var(--font-heading); font-size: 0.95rem; font-weight: 800; }
  .lights { position: absolute; bottom: 13%; display: flex; gap: 4px; }
  .lights i { width: 4px; height: 4px; border-radius: 50%; background: var(--color-sky); }
  .lights i:nth-child(2) { background: var(--color-success); }
  .lights i:nth-child(3) { background: var(--color-gold); }
  @media (max-width: 560px) { .mascot-bubble { grid-template-columns: 100px 1fr; } }
</style>
