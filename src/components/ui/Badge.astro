---
interface Props {
  tone?: 'primary' | 'sky' | 'success' | 'danger' | 'gold' | 'navy' | 'neutral';
  size?: 'sm' | 'md';
  icon?: string;
  class?: string;
}

const { tone = 'primary', size = 'sm', icon, class: className } = Astro.props;
---

<span class:list={['ph-badge', `is-${tone}`, `is-${size}`, className]}>
  {icon && <span class="material-symbols-outlined badge-icon" aria-hidden="true">{icon}</span>}
  <slot />
</span>

<style>
  .ph-badge {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-weight: 800;
    line-height: 1;
    white-space: nowrap;
  }

  .is-sm { padding: 0.3rem 0.55rem; font-size: 0.66rem; }
  .is-md { padding: 0.42rem 0.7rem; font-size: 0.75rem; }
  .is-primary { border-color: var(--color-phinisi-200); background: var(--color-phinisi-50); color: var(--color-phinisi-700); }
  .is-sky { border-color: #a8e7ff; background: var(--color-sky-soft); color: #0b5270; }
  .is-success { border-color: #b9e6c9; background: var(--color-success-soft); color: #13783d; }
  .is-danger { border-color: #ffc8cc; background: var(--color-danger-soft); color: #a12b31; }
  .is-gold { border-color: #f5d98f; background: var(--color-gold-soft); color: #8a5b00; }
  .is-navy { border-color: var(--color-navy-soft); background: var(--color-navy); color: white; }
  .is-neutral { border-color: var(--color-line); background: #f4f7fb; color: var(--color-muted); }
  .badge-icon { font-size: 1rem; }
</style>
