---
import { categoryLabels, loadCourses, type Language } from '../data/learning';

interface Props { language?: Language; }

const { language = 'id' } = Astro.props;
const isEnglish = language === 'en';
const prefix = isEnglish ? '/en' : '';
const courses = await loadCourses();
const requestedCategory = Astro.url.searchParams.get('category');
const activeFilter = ['networking', 'linux', 'automation', 'iot'].includes(requestedCategory ?? '') ? requestedCategory! : 'all';

const copy = isEnglish ? {
  title: 'Explore courses',
  description: 'Choose a practical course and build one skill at a time.',
  all: 'All', available: 'Available', planned: 'Coming soon', view: 'View course',
  beginner: 'Beginner', intermediate: 'Intermediate', hours: 'hours', modules: 'modules',
  filtersLabel: 'Filter courses by field', imageAlt: 'Course cover for',
} : {
  title: 'Jelajahi course',
  description: 'Pilih course praktik dan bangun satu skill pada satu waktu.',
  all: 'Semua', available: 'Tersedia', planned: 'Segera hadir', view: 'Lihat course',
  beginner: 'Pemula', intermediate: 'Menengah', hours: 'jam', modules: 'modul',
  filtersLabel: 'Filter course berdasarkan bidang', imageAlt: 'Cover course',
};

const filters = [
  { value: 'all', label: copy.all },
  { value: 'networking', label: 'Networking' },
  { value: 'linux', label: 'Linux' },
  { value: 'automation', label: 'Automation' },
  { value: 'iot', label: 'IoT' },
];
---

<main class="course-catalog" data-course-catalog>
  <div class="page-shell">
    <header class="catalog-header">
      <h1>{copy.title}</h1>
      <p>{copy.description}</p>
    </header>

    <nav class="course-filters" aria-label={copy.filtersLabel}>
      {filters.map((filter) => (
        <button type="button" data-course-filter={filter.value} aria-pressed={filter.value === activeFilter ? 'true' : 'false'}>
          {filter.label}
        </button>
      ))}
    </nav>

    <section class="course-grid" aria-label={isEnglish ? 'Course list' : 'Daftar course'}>
      {courses.map((course) => {
        const courseHref = prefix + '/courses/' + course.slug;
        const level = course.level === 'beginner' ? copy.beginner : copy.intermediate;
        const materialAvailable = Boolean(course.contentHref?.[language]);
        const learningHref = course.learningHref?.[language];
        return (
          <article
            class="course-card"
            data-course-card
            data-category={course.category}
            data-course={course.slug}
            data-total-lessons={course.lessonCount}
            data-learning-href={learningHref}
            hidden={activeFilter !== 'all' && activeFilter !== course.category}
          >
            <div class="course-cover">
              <img src={course.cover} alt={copy.imageAlt + ' ' + course.title} width="960" height="540" loading="lazy" decoding="async" />
              <span class:list={['course-status', { available: materialAvailable }]}>{materialAvailable ? copy.available : copy.planned}</span>
            </div>

            <div class="course-content">
              <span class="course-category">{categoryLabels[course.category][language]}</span>
              <h2><a href={courseHref} data-course-link>{course.title}</a></h2>
              <p>{course.description[language]}</p>

              <div class="course-meta">{level} · {course.moduleCount} {copy.modules} · ±{course.durationHours} {copy.hours}</div>

              <div class="local-progress" data-card-progress hidden>
                <div><span data-card-progress-label></span><strong data-card-progress-percent></strong></div>
                <span><i data-card-progress-fill></i></span>
              </div>

              <footer><strong data-course-action>{copy.view} →</strong></footer>
            </div>
          </article>
        );
      })}
    </section>
  </div>
</main>

<script>
  import { getCourseProgress } from '../scripts/learning-store';

  document.querySelectorAll<HTMLElement>('[data-course-catalog]').forEach((catalog) => {
    const buttons = catalog.querySelectorAll<HTMLButtonElement>('[data-course-filter]');
    const cards = catalog.querySelectorAll<HTMLElement>('[data-course-card]');

    const applyFilter = (filter: string) => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.courseFilter === filter)));
      cards.forEach((card) => { card.hidden = filter !== 'all' && card.dataset.category !== filter; });
    };

    const renderProgress = () => {
      cards.forEach((card) => {
        const learningHref = card.dataset.learningHref;
        if (!learningHref) return;
        const totalLessons = Number(card.dataset.totalLessons) || 0;
        const progress = getCourseProgress(card.dataset.course ?? '', totalLessons);
        if (progress.completedLessons === 0) return;

        const container = card.querySelector<HTMLElement>('[data-card-progress]');
        const label = card.querySelector<HTMLElement>('[data-card-progress-label]');
        const percent = card.querySelector<HTMLElement>('[data-card-progress-percent]');
        const fill = card.querySelector<HTMLElement>('[data-card-progress-fill]');
        const link = card.querySelector<HTMLAnchorElement>('[data-course-link]');
        const action = card.querySelector<HTMLElement>('[data-course-action]');
        if (container) container.hidden = false;
        if (label) label.textContent = progress.completedLessons + '/' + totalLessons + ' lesson';
        if (percent) percent.textContent = progress.percent + '%';
        if (fill) fill.style.width = progress.percent + '%';
        if (link) link.href = progress.resumeHref ?? learningHref;
        if (action) action.textContent = progress.percent === 100 ? 'Tinjau kembali →' : 'Lanjutkan course →';
      });
    };

    renderProgress();
    window.addEventListener('phinisi-progress-updated', renderProgress);

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.courseFilter ?? 'all';
        applyFilter(filter);
        const url = new URL(window.location.href);
        if (filter === 'all') url.searchParams.delete('category');
        else url.searchParams.set('category', filter);
        window.history.replaceState({}, '', url);
      });
    });
  });
</script>

<style>
  .course-catalog { min-height: 70vh; padding: clamp(3.5rem, 7vw, 5.5rem) 0 clamp(5rem, 8vw, 7rem); background: var(--color-canvas); }
  .catalog-header { max-width: 680px; }
  .catalog-header h1 { margin: 0; color: var(--color-navy); font-family: var(--font-heading); font-size: clamp(2.7rem, 6vw, 4.3rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.12; }
  .catalog-header p { margin: 0.85rem 0 0; color: var(--color-muted); font-size: 1rem; line-height: 1.65; }
  .course-filters { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 2rem 0 1.5rem; }
  .course-filters button { min-height: 36px; border: 1px solid var(--color-line); border-radius: 999px; padding: 0.4rem 0.8rem; background: #fff; color: var(--color-muted); font-family: var(--font-heading); font-size: 0.72rem; font-weight: 600; cursor: pointer; }
  .course-filters button[aria-pressed='true'] { border-color: var(--color-primary); background: var(--color-primary); color: #fff; }
  .course-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.15rem; }
  .course-card { position: relative; overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: #fff; transition: border-color 160ms ease, box-shadow 160ms ease; }
  .course-card:hover { border-color: var(--color-phinisi-300); box-shadow: var(--shadow-soft); }
  .course-card[hidden] { display: none; }
  .course-cover { position: relative; overflow: hidden; aspect-ratio: 16 / 9; background: var(--color-section); }
  .course-cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .course-status { position: absolute; top: 0.65rem; right: 0.65rem; border: 1px solid rgba(8, 26, 58, 0.1); border-radius: 999px; padding: 0.28rem 0.5rem; background: rgba(255, 255, 255, 0.92); color: var(--color-muted); font-size: 0.6rem; font-weight: 850; }
  .course-status.available { color: var(--color-success); }
  .course-content { display: flex; min-height: 280px; flex-direction: column; padding: 1.25rem; }
  .course-category { color: var(--color-primary); font-size: 0.72rem; font-weight: 650; text-transform: uppercase; }
  .course-content h2 { margin: 0.45rem 0 0; color: var(--color-navy); font-family: var(--font-heading); font-size: 1.18rem; font-weight: 650; letter-spacing: -0.01em; line-height: 1.4; }
  .course-content h2 a { color: inherit; text-decoration: none; }
  .course-content h2 a::after { position: absolute; inset: 0; content: ''; }
  .course-content > p { display: -webkit-box; overflow: hidden; margin: 0.65rem 0 1rem; -webkit-box-orient: vertical; -webkit-line-clamp: 3; color: var(--color-muted); font-size: 0.86rem; line-height: 1.6; }
  .course-meta { margin-top: auto; color: var(--color-muted); font-size: 0.76rem; font-weight: 550; }
  .local-progress { margin-top: 0.8rem; }
  .local-progress[hidden] { display: none; }
  .local-progress > div { display: flex; justify-content: space-between; color: var(--color-muted); font-size: 0.6rem; }
  .local-progress > div strong { color: var(--color-primary); }
  .local-progress > span { display: block; height: 0.4rem; overflow: hidden; margin-top: 0.3rem; border-radius: 999px; background: var(--color-phinisi-100); }
  .local-progress i { display: block; width: 0; height: 100%; border-radius: inherit; background: var(--color-primary); }
  .course-content footer { margin-top: 0.9rem; border-top: 1px solid var(--color-line); padding-top: 0.8rem; color: var(--color-primary); font-size: 0.78rem; text-align: right; }

  @media (max-width: 900px) { .course-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) {
    .course-filters { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
    .course-filters button { flex: none; }
    .course-grid { grid-template-columns: 1fr; }
    .course-content { min-height: auto; }
  }
</style>
