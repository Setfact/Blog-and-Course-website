---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'id' ? '' : `/${lang}`;
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner page-shell">
    <div class="footer-brand">
      <a href={`${prefix}/`} class="brand" aria-label="Phinisi Learn — halaman utama">
        <img src="/Logo-Putih-Transparent.png" alt="Phinisi Learn" width="2170" height="725" />
      </a>
      <p>Tempat kamu berlayar dari rasa penasaran menuju skill IT yang siap bersaing di dunia industri.</p>
    </div>

    <div class="footer-links">
      <section>
        <h2>{t('footer.links')}</h2>
        <a href={`${prefix}/courses`}>{t('nav.courses')}</a>
        <a href={`${prefix}/learning-path`}>{t('nav.learningPath')}</a>
        <a href={`${prefix}/blog`}>{t('nav.blog')}</a>
      </section>
      <section>
        <h2>{t('footer.legal')}</h2>
        <a href={`${prefix}/privacy`}>{t('footer.privacy')}</a>
        <a href={`${prefix}/terms`}>{t('footer.terms')}</a>
      </section>
    </div>
  </div>
  <div class="footer-bottom page-shell">
    <p>&copy; {currentYear} Phinisi Learn. {t('footer.copyright')}</p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    margin-top: auto;
    overflow: hidden;
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: 1.5rem;
    background: var(--color-navy);
    color: #cbd5ec;
    border-top: 1px solid rgba(120, 233, 255, 0.18);
  }
  .footer-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .footer-brand { max-width: 480px; }
  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
  .brand img {
    display: block;
    width: 176px;
    height: auto;
    object-fit: contain;
  }
  .footer-brand > p {
    max-width: 430px;
    margin: 1rem 0 0;
    color: #b0c6e5;
    font-size: 0.92rem;
    line-height: 1.65;
  }
  .footer-links { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; }
  .footer-links section { display: flex; flex-direction: column; align-items: flex-start; gap: 0.75rem; }
  .footer-links h2 { margin: 0 0 0.4rem; color: #ffffff; font-family: var(--font-heading); font-size: 0.92rem; font-weight: 650; letter-spacing: 0.02em; }
  .footer-links a { color: #c4d7f2; font-size: 0.88rem; font-weight: 500; text-decoration: none; transition: color 150ms ease; }
  .footer-links a:hover { color: var(--color-sky); }
  .footer-bottom { position: relative; z-index: 1; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 1.2rem; color: #8fa7ca; font-size: 0.75rem; }
  .footer-bottom p { margin: 0; }
  @media (max-width: 720px) { .footer-inner { grid-template-columns: 1fr; } .footer-bottom { flex-direction: column; gap: 0.45rem; } }
</style>
