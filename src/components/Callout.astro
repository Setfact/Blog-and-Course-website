---
interface Props {
  type?: 'info' | 'warning' | 'danger' | 'success' | 'remember' | 'mistake';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const config = {
  info: { icon: 'info', title: 'Catatan', tone: 'info' },
  warning: { icon: 'warning', title: 'Perhatian', tone: 'warning' },
  danger: { icon: 'error', title: 'Peringatan', tone: 'danger' },
  success: { icon: 'check_circle', title: 'Berhasil', tone: 'success' },
  remember: { icon: 'lightbulb', title: 'Ingat Ini', tone: 'remember' },
  mistake: { icon: 'report', title: 'Kesalahan Umum', tone: 'mistake' },
} as const;

const callout = config[type];
const displayTitle = title ?? callout.title;
---

<aside class={`doc-callout doc-callout--${callout.tone}`} role="note" aria-label={displayTitle}>
  <span class="callout-icon material-symbols-outlined" aria-hidden="true">{callout.icon}</span>
  <div class="callout-content">
    <p class="callout-title">{displayTitle}</p>
    <div class="callout-body">
      <slot />
    </div>
  </div>
</aside>

<style>
  .doc-callout {
    --callout-accent: var(--color-primary);
    --callout-bg: var(--color-phinisi-50);
    --callout-border: var(--color-phinisi-200);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.8rem;
    margin: 1.75rem 0;
    border: 1px solid var(--callout-border);
    border-left: 5px solid var(--callout-accent);
    border-radius: 1rem;
    padding: 1rem 1.1rem;
    background: var(--callout-bg);
    color: var(--color-ink);
    box-shadow: 0 10px 28px rgba(8, 26, 58, 0.06);
  }

  .doc-callout--warning,
  .doc-callout--remember {
    --callout-accent: #c78308;
    --callout-bg: var(--color-gold-soft);
    --callout-border: #f2d585;
  }

  .doc-callout--danger,
  .doc-callout--mistake {
    --callout-accent: var(--color-danger);
    --callout-bg: var(--color-danger-soft);
    --callout-border: #f7bdc0;
  }

  .doc-callout--success {
    --callout-accent: var(--color-success);
    --callout-bg: var(--color-success-soft);
    --callout-border: #a8deb9;
  }

  .callout-icon {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    place-items: center;
    border-radius: 0.7rem;
    background: #fff;
    color: var(--callout-accent);
    font-size: 1.2rem;
    box-shadow: 0 4px 12px rgba(8, 26, 58, 0.08);
  }

  .callout-title {
    margin: 0 0 0.25rem;
    color: var(--callout-accent);
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  .callout-body {
    color: var(--color-ink);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .callout-body :global(p) { margin: 0.35rem 0; }
  .callout-body :global(ul),
  .callout-body :global(ol) { margin: 0.5rem 0; }

  @media (max-width: 520px) {
    .doc-callout { grid-template-columns: 1fr; }
  }
</style>
