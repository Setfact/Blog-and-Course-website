---
import { categoryLabels, getPathsForCourse, type Course, type Language } from '../data/learning';
import LearningStatus from './LearningStatus.astro';

interface Props { course: Course; language?: Language; }

const { course, language = 'id' } = Astro.props;
const isEnglish = language === 'en';
const prefix = isEnglish ? '/en' : '';
const materialHref = course.contentHref?.[language];
const learningHref = course.learningHref?.[language] ?? materialHref;
const relatedPaths = await getPathsForCourse(course.slug);

const copy = isEnglish ? {
  courses: 'Courses', available: 'Available', planned: 'Coming soon',
  beginner: 'Beginner', intermediate: 'Intermediate', hours: 'hours', modules: 'modules', lessons: 'lessons',
  pathLabel: 'Learning path', outcomes: 'What you will learn', syllabus: 'Course outline',
  syllabusDescription: 'Learn each module in order, then practice through short lessons and checks.',
  tools: 'Tools used', updated: 'Last updated', finalProject: 'Final project',
  start: 'Start course', preparingTitle: 'Lessons are being prepared.',
  preparingDescription: 'The course outline is ready and its position in the learning path is already visible.',
  back: 'Back to course catalog', module: 'Module',
} : {
  courses: 'Course', available: 'Tersedia', planned: 'Segera hadir',
  beginner: 'Pemula', intermediate: 'Menengah', hours: 'jam', modules: 'modul', lessons: 'lesson',
  pathLabel: 'Learning path', outcomes: 'Yang akan kamu kuasai', syllabus: 'Susunan course',
  syllabusDescription: 'Pelajari modul secara berurutan, lalu praktikkan melalui lesson dan quiz singkat.',
  tools: 'Tools yang digunakan', updated: 'Terakhir diperbarui', finalProject: 'Project akhir',
  start: 'Mulai course', preparingTitle: 'Lesson sedang disiapkan.',
  preparingDescription: 'Struktur course dan posisinya di learning path sudah dapat kamu lihat.',
  back: 'Kembali ke katalog course', module: 'Modul',
};

const level = course.level === 'beginner' ? copy.beginner : copy.intermediate;
const isPublished = course.status === 'published';
const isPlanned = course.status === 'planned';
const isDraft = course.status === 'draft';
const statusLabel = isPublished ? copy.available : isPlanned ? copy.planned : 'Draf';
const user = Astro.locals.user;
const isAdmin = user?.role === 'admin';
---

<main class="course-detail">
  <section class="course-hero">
    <div class="page-shell">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={prefix + '/courses'}>{copy.courses}</a><span>/</span><span>{course.title}</span>
      </nav>

      <div class="hero-grid">
        <div class="hero-copy">
          <div class="course-label">
            <span>{categoryLabels[course.category][language]}</span>
            <i aria-hidden="true">·</i>
            <strong class:list={{ available: isPublished, planned: isPlanned, draft: isDraft }}>{statusLabel}</strong>
          </div>
          <h1>{course.title}</h1>
          <p>{course.description[language]}</p>
          <div class="course-meta">{level} · {course.moduleCount} {copy.modules} · {course.lessonCount} {copy.lessons} · ±{course.durationHours} {copy.hours}</div>
          <div class="updated-at">{copy.updated}: {new Intl.DateTimeFormat(isEnglish ? 'en-US' : 'id-ID', { dateStyle: 'medium' }).format(new Date(course.updatedAt))}</div>

          {isPublished && materialHref && language === 'id' && <LearningStatus courseSlug={course.slug} totalLessons={course.lessonCount} />}

          {isPublished && learningHref ? (
            <a
              class="primary-action"
              href={learningHref}
              data-course-start
              data-course={course.slug}
              data-total-lessons={course.lessonCount}
            ><span data-course-start-label>{copy.start}</span> →</a>
          ) : (
            <div class="preparing-note">
              <strong>{isDraft ? 'Kursus Masih Berstatus Draf' : copy.preparingTitle}</strong>
              <span>{isDraft ? 'Materi kursus ini dalam tahap penyusunan dan hanya dapat diakses oleh Administrator.' : copy.preparingDescription}</span>
            </div>
          )}

          {isAdmin && (
            <div class="admin-detail-tools">
              <a href={`/admin/courses/${course.slug}/edit`} class="admin-edit-course-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                <span>Edit Kursus di Studio Admin</span>
              </a>
            </div>
          )}
        </div>

        <img class="course-image" src={course.cover} alt="" width="960" height="540" />
      </div>
    </div>
  </section>

  <section class="course-body page-shell">
    <div class="syllabus">
      <header>
        <h2>{copy.syllabus}</h2>
        <p>{copy.syllabusDescription}</p>
      </header>
      <ol class="module-list">
        {course.modules.map((module, index) => (
          <li><span>{index + 1}</span><div><small>{copy.module} {index + 1}</small><strong>{module.title[language]}</strong>{module.lessonCount > 0 && <em>{module.lessonCount} lesson</em>}</div></li>
        ))}
      </ol>
      {course.projectTitle && (
        <section class="final-project">
          <span>{copy.finalProject}</span>
          <h3>{course.projectTitle}</h3>
          {course.projectDescription && <p>{course.projectDescription}</p>}
        </section>
      )}
    </div>

    <aside class="course-sidebar">
      <section class="outcomes">
        <h2>{copy.outcomes}</h2>
        <ul>{course.outcomes.map((outcome) => <li>{outcome[language]}</li>)}</ul>
      </section>

      {course.tools.length > 0 && (
        <section class="course-tools">
          <h2>{copy.tools}</h2>
          <div>{course.tools.map((tool) => <span>{tool}</span>)}</div>
        </section>
      )}

      {relatedPaths.length > 0 && (
        <section class="related-paths">
          <span>{copy.pathLabel}</span>
          {relatedPaths.map((path) => (
            <a href={'/learning-path/' + path.slug}>
              <strong>{path.title[language]}</strong>
              <small>Course {path.courseSlugs.indexOf(course.slug) + 1} dari {path.courseSlugs.length}</small>
            </a>
          ))}
        </section>
      )}

      <a class="back-link" href={prefix + '/courses'}>← {copy.back}</a>
    </aside>
  </section>
</main>

<script>
  import { getCourseProgress } from '../scripts/learning-store';

  document.querySelectorAll<HTMLAnchorElement>('[data-course-start]').forEach((link) => {
    const totalLessons = Number(link.dataset.totalLessons) || 0;
    const progress = getCourseProgress(link.dataset.course ?? '', totalLessons);
    const label = link.querySelector<HTMLElement>('[data-course-start-label]');
    if (progress.resumeHref) link.href = progress.resumeHref;
    if (label && progress.completedLessons > 0) label.textContent = progress.percent === 100 ? 'Tinjau kembali course' : 'Lanjutkan course';
  });
</script>

<style>
  .course-detail { background: #f8fbff; }
  .course-hero {
    border-bottom: 3px solid rgba(34, 211, 238, .35);
    padding: 2rem 0 clamp(3.5rem, 6vw, 5rem);
    background: linear-gradient(160deg, #04122b 0%, #082d68 50%, #0a4a9c 100%);
    color: #ffffff;
  }
  .breadcrumb { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 1.75rem; color: #a8d4f5; font-size: 0.78rem; }
  .breadcrumb a { color: #67e8f9; font-weight: 700; text-decoration: none; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.85fr); align-items: center; gap: clamp(2rem, 5vw, 4.5rem); }
  .course-label { display: flex; align-items: center; gap: 0.55rem; color: #67e8f9; font-size: 0.72rem; font-weight: 750; letter-spacing: .06em; text-transform: uppercase; }
  .course-label i { color: rgba(103, 232, 249, .4); font-style: normal; }
  .course-label strong { color: #cbd5e1; }
  .course-label strong.available { color: #34d399; }
  .course-label strong.planned { color: #fbbf24; }
  .course-label strong.draft { color: #94a3b8; }
  .hero-copy h1 { max-width: 740px; margin: 0.6rem 0 0; color: #ffffff; font-family: var(--font-heading); font-size: clamp(2.4rem, 4.8vw, 3.8rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.12; }
  .hero-copy > p { max-width: 670px; margin: 1rem 0 0; color: #d0edff; font-size: 1.02rem; line-height: 1.65; }
  .course-meta { margin-top: 1.25rem; color: #78e9ff; font-size: 0.82rem; font-weight: 700; }
  .updated-at { margin-top: 0.35rem; color: #94a3b8; font-size: 0.75rem; }
  .primary-action {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: .5rem;
    margin-top: 1.5rem;
    border-radius: .7rem;
    padding: 0.8rem 1.4rem;
    background: #facc15;
    box-shadow: 0 4px 0 #c68a08, 0 16px 30px rgba(5, 42, 85, .25);
    color: #082852;
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease, background 180ms ease;
  }
  .primary-action:hover { transform: translateY(-3px); background: #ffe36a; }
  .preparing-note { display: grid; gap: 0.2rem; max-width: 600px; margin-top: 1.4rem; border-left: 3px solid #facc15; padding-left: 0.85rem; color: #cbd5e1; font-size: 0.8rem; }
  .preparing-note strong { color: #ffffff; }
  .admin-detail-tools { margin-top: 1.25rem; }
  .admin-edit-course-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(103, 232, 249, 0.4);
    color: #67e8f9;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 180ms ease;
  }
  .admin-edit-course-btn:hover {
    background: rgba(103, 232, 249, 0.2);
    border-color: #67e8f9;
    color: #ffffff;
  }
  .course-image { display: block; width: 100%; aspect-ratio: 3 / 2; border: 1px solid rgba(103, 232, 249, .3); border-radius: 20px; object-fit: cover; box-shadow: 0 20px 40px rgba(2, 14, 40, .4); }

  .course-body { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr); gap: clamp(2.5rem, 6vw, 5rem); padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .syllabus header h2, .outcomes h2 { margin: 0; color: #061d3f; font-family: var(--font-heading); font-size: 1.6rem; font-weight: 700; }
  .syllabus header p { margin: 0.45rem 0 0; color: #526984; font-size: 0.9rem; line-height: 1.6; }
  .module-list { margin: 1.5rem 0 0; border: 1px solid rgba(40, 201, 232, 0.25); border-radius: 18px; padding: 0; background: #ffffff; list-style: none; overflow: hidden; box-shadow: 0 10px 30px rgba(8, 42, 81, .05); }
  .module-list li { display: grid; grid-template-columns: 44px 1fr; align-items: center; gap: 1rem; padding: 1.1rem 1.25rem; }
  .module-list li + li { border-top: 1px solid rgba(226, 232, 240, .8); }
  .module-list li > span {
    display: inline-flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: radial-gradient(circle at center, #ffffff 30%, #e0f2fe 100%);
    border: 1px solid rgba(56, 189, 248, .35);
    color: #0284c7;
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
  }
  .module-list li div { display: grid; gap: 0.15rem; }
  .module-list small { color: #0284c7; font-size: 0.64rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  .module-list strong { color: #061d3f; font-size: 0.95rem; font-weight: 650; }
  .module-list em { color: #64748b; font-size: 0.76rem; font-style: normal; }

  .final-project { margin-top: 2rem; border: 1px solid rgba(40, 201, 232, 0.3); border-radius: 18px; padding: 1.35rem; background: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 100%); box-shadow: 0 8px 24px rgba(14, 116, 180, .08); }
  .final-project span { color: #0284c7; font-size: .68rem; font-weight: 750; text-transform: uppercase; letter-spacing: .05em; }
  .final-project h3 { margin: .35rem 0 0; color: #061d3f; font-size: 1.15rem; font-weight: 700; }
  .final-project p { margin: .45rem 0 0; color: #374e6c; font-size: .88rem; line-height: 1.6; }

  .course-sidebar { display: grid; align-content: start; gap: 1.5rem; }
  .outcomes { border: 1px solid rgba(40, 201, 232, 0.25); border-top: 4px solid #0284c7; border-radius: 18px; padding: 1.35rem; background: #ffffff; box-shadow: 0 10px 30px rgba(8, 42, 81, .05); }
  .outcomes h2 { font-size: 1.15rem; }
  .outcomes ul { display: grid; gap: 0.75rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .outcomes li { position: relative; padding-left: 1.1rem; color: #374e6c; font-size: 0.84rem; line-height: 1.55; }
  .outcomes li::before { position: absolute; top: 0.45em; left: 0; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: #059669; content: ''; }

  .course-tools { border: 1px solid rgba(40, 201, 232, 0.25); border-radius: 18px; padding: 1.25rem; background: #ffffff; box-shadow: 0 8px 24px rgba(8, 42, 81, .04); }
  .course-tools h2 { margin: 0; color: #061d3f; font-size: 1rem; font-weight: 700; }
  .course-tools > div { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: .8rem; }
  .course-tools span { border: 1px solid rgba(148, 163, 184, .25); border-radius: 999px; padding: .35rem .7rem; background: #f8fafc; color: #334155; font-size: .75rem; font-weight: 600; }

  .related-paths { display: grid; gap: 0.6rem; border: 1px solid rgba(40, 201, 232, 0.25); border-radius: 18px; padding: 1.25rem; background: #ffffff; box-shadow: 0 8px 24px rgba(8, 42, 81, .04); }
  .related-paths > span { color: #64748b; font-size: 0.68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }
  .related-paths a { display: grid; gap: 0.18rem; color: #061d3f; text-decoration: none; }
  .related-paths strong { font-size: 0.88rem; color: #0284c7; }
  .related-paths small { color: #64748b; font-size: 0.72rem; }
  .back-link { display: inline-flex; align-items: center; color: #0284c7; font-size: 0.82rem; font-weight: 700; text-decoration: none; transition: transform 180ms ease; }
  .back-link:hover { transform: translateX(-3px); }

  @media (max-width: 900px) { .hero-grid, .course-body { grid-template-columns: 1fr; } .course-image { max-width: 720px; } }
</style>
