---
import Search from 'astro-pagefind/components/Search.astro';
import { getRankTier } from '../lib/rank';

const user = Astro.locals.user;
const rankTier = user ? getRankTier(user.xp) : null;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const showSearch = pathname.startsWith('/docs') || pathname.startsWith('/blog');

const navItems = [
  { href: '/courses', label: 'Kursus' },
  { href: '/learning-path', label: 'Alur Belajar' },
  { href: '/community', label: 'Komunitas' },
  { href: '/blog', label: 'Blog' },
];

const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Phinisi Learn — halaman utama">
      <img src="/Logo Phinisi Learn.png" alt="Phinisi Learn" width="2170" height="725" />
    </a>

    <nav class="desktop-nav" aria-label="Navigasi utama">
      {navItems.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      {showSearch && (
        <div class="search-wrap">
          <Search instance="search" className="pagefind-ui" searchboxOptions={{ showImages: false }} />
        </div>
      )}

      {user ? (
        <div class="user-menu-wrap">
          <details class="user-menu-dropdown">
            <summary class="user-avatar-btn" aria-label="Menu akun pengguna">
              {user.avatar_url ? (
                <img src={user.avatar_url} alt={user.full_name} class="user-avatar-img" width="36" height="36" />
              ) : (
                <span class="user-avatar-fallback">{user.full_name.slice(0, 1).toUpperCase()}</span>
              )}
            </summary>
            <div class="user-dropdown-panel">
              <div class="dropdown-user-header">
                <strong class="user-name-text">{user.full_name}</strong>
                <span class="user-email-text">{user.email}</span>
                {rankTier && (
                  <div class="user-header-badges">
                    <span class="rank-tag">
                      <span class="material-symbols-outlined icon-micro">{rankTier.icon}</span>
                      <span>{rankTier.name}</span>
                    </span>
                    <span class="xp-tag">{user.xp} XP</span>
                  </div>
                )}
                {user.role === 'admin' && <span class="badge-admin">Admin</span>}
              </div>

              <hr class="dropdown-divider" />
              <a href="/dashboard" class="dropdown-item">
                <span class="material-symbols-outlined">dashboard</span>
                <span>Dashboard Siswa</span>
              </a>
              <a href="/community" class="dropdown-item">
                <span class="material-symbols-outlined">forum</span>
                <span>Komunitas</span>
              </a>
              {user.role === 'admin' && (
                <a href="/admin" class="dropdown-item highlight-admin">
                  <span class="material-symbols-outlined">admin_panel_settings</span>
                  <span>Panel Administrator</span>
                </a>
              )}
              <hr class="dropdown-divider" />
              <a href="/api/auth/signout" class="dropdown-item text-danger">
                <span class="material-symbols-outlined">logout</span>
                <span>Keluar</span>
              </a>
            </div>
          </details>
        </div>
      ) : (
        <div class="auth-nav-group">
          <a href="/login" class="login-nav-btn">Masuk</a>
          <a href="/register" class="register-nav-btn">Daftar</a>
        </div>
      )}

      <details class="mobile-menu">
        <summary aria-label="Buka menu"><span class="material-symbols-outlined">menu</span></summary>
        <nav aria-label="Navigasi mobile">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
          <hr class="mobile-divider" />
          {user ? (
            <>
              <a href="/dashboard">Dashboard ({user.full_name})</a>
              {user.role === 'admin' && <a href="/admin" class="mobile-admin-link">Panel Admin</a>}
              <a href="/api/auth/signout" class="mobile-danger-link">Keluar</a>
            </>
          ) : (
            <div class="mobile-auth-links">
              <a href="/login">Masuk</a>
              <a href="/register" class="mobile-register-link">Daftar Akun Baru</a>
            </div>
          )}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; z-index: 50; top: 0; border-bottom: 1px solid var(--color-line); background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(14px); }
  .header-inner { display: flex; width: 100%; max-width: 100%; min-height: 70px; align-items: center; justify-content: space-between; gap: 1.25rem; padding-inline: 1.75rem; }
  .brand { display: inline-flex; flex: 0 0 auto; align-items: center; color: var(--color-navy); text-decoration: none; }
  .brand img { display: block; width: 146px; height: 49px; object-fit: contain; }
  .desktop-nav { display: flex; align-items: center; gap: 0.35rem; }
  .desktop-nav a { border-radius: 0.65rem; padding: 0.58rem 0.72rem; color: var(--color-muted); font-family: var(--font-heading); font-size: 0.84rem; font-weight: 600; text-decoration: none; transition: background 150ms ease, color 150ms ease; }
  .desktop-nav a:hover, .desktop-nav a.active { background: var(--color-phinisi-50); color: var(--color-phinisi-700); }
  .header-actions { display: flex; align-items: center; gap: 0.85rem; }
  .search-wrap { position: relative; width: 220px; }

  /* Auth nav buttons (Masuk & Daftar) */
  .auth-nav-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .login-nav-btn {
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    transition: all 150ms ease;
  }
  .login-nav-btn:hover {
    background: var(--color-phinisi-50);
    color: var(--color-phinisi-700);
  }
  .register-nav-btn {
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 800;
    color: #ffffff;
    background: var(--color-phinisi-600);
    text-decoration: none;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    box-shadow: 0 2px 8px rgba(20, 91, 215, 0.2);
    transition: all 150ms ease;
  }
  .register-nav-btn:hover {
    background: var(--color-phinisi-700);
    box-shadow: 0 4px 12px rgba(20, 91, 215, 0.3);
    transform: translateY(-1px);
  }

  /* User Menu Dropdown */
  .user-menu-wrap {
    position: relative;
  }
  .user-menu-dropdown {
    position: relative;
  }
  .user-avatar-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    list-style: none;
    border: 2px solid var(--color-phinisi-200);
    background: var(--color-phinisi-100);
    transition: border-color 150ms ease, transform 150ms ease;
  }
  .user-avatar-btn::-webkit-details-marker { display: none; }
  .user-avatar-btn:hover {
    border-color: var(--color-phinisi-500);
    transform: scale(1.04);
  }
  .user-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .user-avatar-fallback {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-phinisi-700);
  }
  .user-dropdown-panel {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: 240px;
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(8, 26, 58, 0.1);
    padding: 0.75rem 0.5rem;
    display: flex;
    flex-direction: column;
    z-index: 100;
  }
  .dropdown-user-header {
    padding: 0.4rem 0.75rem 0.6rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .user-name-text {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--color-navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .user-email-text {
    font-size: 0.74rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .user-header-badges {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    flex-wrap: wrap;
  }
  .rank-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: #fef3c7;
    color: #92400e;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
  }
  .xp-tag {
    background: var(--color-phinisi-50);
    color: var(--color-phinisi-700);
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
  }
  .icon-micro {
    font-size: 0.85rem;
  }
  .badge-admin {
    display: inline-block;
    align-self: flex-start;
    margin-top: 0.25rem;
    background: #fee2e2;
    color: #991b1b;
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    text-transform: uppercase;
  }
  .dropdown-divider {
    border: none;
    border-top: 1px solid var(--color-line);
    margin: 0.4rem 0;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border-radius: 0.65rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 120ms ease;
  }
  .dropdown-item:hover {
    background: var(--color-phinisi-50);
    color: var(--color-phinisi-700);
  }
  .dropdown-item .material-symbols-outlined {
    font-size: 1.15rem;
    color: var(--color-muted);
  }
  .dropdown-item:hover .material-symbols-outlined {
    color: var(--color-phinisi-700);
  }
  .dropdown-item.highlight-admin {
    color: #991b1b;
  }
  .dropdown-item.highlight-admin .material-symbols-outlined {
    color: #991b1b;
  }
  .dropdown-item.highlight-admin:hover {
    background: #fee2e2;
  }
  .dropdown-item.text-danger {
    color: var(--color-danger);
  }
  .dropdown-item.text-danger .material-symbols-outlined {
    color: var(--color-danger);
  }
  .dropdown-item.text-danger:hover {
    background: var(--color-danger-soft);
  }

  /* Mobile menu */
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid var(--color-line); border-radius: 0.8rem; background: white; color: var(--color-navy); cursor: pointer; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu nav { position: absolute; top: calc(100% + 0.75rem); right: 0; display: grid; min-width: 210px; gap: 0.25rem; border: 1px solid var(--color-line); border-radius: 1rem; padding: 0.6rem; background: white; box-shadow: var(--shadow-card); z-index: 100; }
  .mobile-menu nav a { border-radius: 0.65rem; padding: 0.75rem; color: var(--color-ink); font-family: var(--font-heading); font-weight: 600; text-decoration: none; }
  .mobile-menu nav a:hover { background: var(--color-phinisi-50); color: var(--color-phinisi-700); }
  .mobile-divider { border: none; border-top: 1px solid var(--color-line); margin: 0.35rem 0; }
  .mobile-admin-link { color: #991b1b !important; font-weight: 700 !important; }
  .mobile-danger-link { color: var(--color-danger) !important; }
  .mobile-auth-links { display: flex; flex-direction: column; gap: 0.25rem; }
  .mobile-register-link { color: var(--color-phinisi-600) !important; font-weight: 800 !important; }


  :global(.search-wrap) { --pagefind-ui-scale: 0.72; --pagefind-ui-primary: #145bd7; --pagefind-ui-text: #5f6f89; --pagefind-ui-background: #f5f9ff; --pagefind-ui-border: #dce7f5; --pagefind-ui-border-width: 1px; --pagefind-ui-border-radius: 14px; --pagefind-ui-font: 'Inter', sans-serif; }
  :global(.search-wrap .pagefind-ui__search-input) { min-height: 44px !important; font-weight: 500 !important; box-shadow: none !important; }
  :global(.search-wrap .pagefind-ui__drawer) { position: absolute; top: calc(100% + 0.6rem); right: 0; left: auto; width: min(420px, 85vw); max-height: 480px; overflow: auto; border: 1px solid var(--color-line); border-radius: 1rem; padding: 1rem; background: white; box-shadow: var(--shadow-card); }
  :global(.pagefind-ui__result-link) { color: var(--color-phinisi-700) !important; }
  :global(.pagefind-ui__result-excerpt mark) { background: var(--color-phinisi-100) !important; color: var(--color-phinisi-800) !important; }

  @media (max-width: 1080px) { .search-wrap { display: none; } }
  @media (max-width: 820px) { .desktop-nav { display: none; } .mobile-menu { display: block; } }
  @media (max-width: 560px) { .header-inner { min-height: 68px; gap: 0.6rem; } .header-actions { gap: 0.55rem; } .brand img { width: 124px; height: 42px; } }
</style>
