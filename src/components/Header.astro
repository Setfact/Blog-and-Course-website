---
// src/components/Header.astro
import Search from "astro-pagefind/components/Search.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'id' ? '' : `/${lang}`;
---

<header class="border-b border-slate-200 bg-white relative z-50">
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-4 sm:px-6">
    <!-- Logo -->
    <div class="flex items-center">
      <a href={`${prefix}/`} class="flex items-center gap-3 font-['Hanken_Grotesk'] text-xl font-bold tracking-tight text-slate-900">
        <img src="/logo.png" alt="Phinisi Network Logo" class="h-14 w-auto" />
        Phinisi Network
      </a>
    </div>

    <!-- Navigation -->
    <nav class="hidden md:flex items-center space-x-8">
      <a href={`${prefix}/courses`} class="font-['Inter'] text-sm font-medium text-slate-600 transition-colors hover:text-slate-900">{t('nav.courses')}</a>
      <a href={`${prefix}/learning-path`} class="font-['Inter'] text-sm font-medium text-slate-600 transition-colors hover:text-slate-900">{t('nav.learningPath')}</a>
      <a href={`${prefix}/blog`} class="font-['Inter'] text-sm font-medium text-slate-600 transition-colors hover:text-slate-900">{t('nav.blog')}</a>
    </nav>

    <!-- Right Side: Search, Language -->
    <div class="flex items-center space-x-6 md:space-x-8">
      <div class="relative hidden sm:block w-64 pagefind-custom-container">
        <Search id="search" className="pagefind-ui" uiOptions={{ showImages: false }} />
      </div>
      
      <!-- Language Switcher -->
      <div class="flex items-center space-x-2 text-sm font-['Inter'] text-slate-600">
        <a href={Astro.url.pathname.replace(/^\/en/, '') || '/'} class={lang === 'id' ? 'font-bold text-slate-900' : 'hover:text-slate-900'}>ID</a>
        <span>|</span>
        <a href={`/en${Astro.url.pathname.replace(/^\/en/, '')}`} class={lang === 'en' ? 'font-bold text-slate-900' : 'hover:text-slate-900'}>EN</a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  /* Custom Pagefind UI Styling */
  .pagefind-custom-container {
    --pagefind-ui-scale: 0.75;
    --pagefind-ui-primary: #0056B3;
    --pagefind-ui-text: #475569;
    --pagefind-ui-background: #f8fafc;
    --pagefind-ui-border: #e2e8f0;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.25rem;
    --pagefind-ui-font: 'Inter', sans-serif;
  }
  
  /* Make the input look exactly like the old static one */
  .pagefind-custom-container .pagefind-ui__search-input {
    font-weight: 400 !important;
    color: #0f172a !important; /* slate-900 */
    background-color: #f8fafc !important; /* slate-50 */
    transition: all 0.2s;
  }
  .pagefind-custom-container .pagefind-ui__search-input:focus {
    border-color: #0056B3 !important;
    background-color: #ffffff !important;
    outline: none !important;
  }

  /* Style the dropdown results */
  .pagefind-custom-container .pagefind-ui__drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin-top: 0.5rem;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.25rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    z-index: 100;
    max-height: 400px;
    overflow-y: auto;
    padding: 1rem;
  }
  
  .pagefind-ui__result-link {
    color: #0056B3 !important;
  }
  .pagefind-ui__result-excerpt mark {
    background-color: rgba(0, 86, 179, 0.1) !important;
    color: #0056B3 !important;
    font-weight: 600;
  }
  
  /* Hide the clear button if it looks weird */
  .pagefind-ui__search-clear {
    padding: 0 !important;
    width: 30px !important;
  }
</style>
