---
import Search from 'astro-pagefind/components/Search.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import Button from './ui/Button.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const prefix = lang === 'id' ? '' : `/${lang}`;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const showSearch = pathname.startsWith(prefix + '/docs') || pathname.startsWith(prefix + '/blog');

const navItems = [
  { href: `${prefix}/courses`, label: t('nav.courses') },
  { href: `${prefix}/learning-path`, label: t('nav.learningPath') },
  { href: `${prefix}/blog`, label: t('nav.blog') },
];

const isActive = (href: string) => pathname === href || (href !== '/' && pathname.startsWith(`${href}/`));
---

<header class="site-header">
  <div class="header-inner page-shell">
    <a href={`${prefix}/`} class="brand" aria-label="Phinisi Learn — halaman utama">
      <img src="/Logo Phinisi Learn.png" alt="Phinisi Learn" width="2170" height="725" />
    </a>

    <nav class="desktop-nav" aria-label="Navigasi utama">
      {navItems.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      {showSearch && (
        <div class="search-wrap">
          <Search instance="search" className="pagefind-ui" searchboxOptions={{ showImages: false }} />
        </div>
      )}

      <div class="language-switcher" aria-label="Pilih bahasa">
        <a href={Astro.url.pathname.replace(/^\/en/, '') || '/'} class:list={{ active: lang === 'id' }}>ID</a>
        <span>/</span>
        <a href={`/en${Astro.url.pathname.replace(/^\/en/, '')}`} class:list={{ active: lang === 'en' }}>EN</a>
      </div>

      <Button href={`${prefix}/courses`} size="sm" class="header-cta">{lang === 'id' ? 'Mulai Belajar' : 'Start Learning'}</Button>

      <details class="mobile-menu">
        <summary aria-label="Buka menu"><span class="material-symbols-outlined">menu</span></summary>
        <nav aria-label="Navigasi mobile">
          {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header { position: sticky; z-index: 50; top: 0; border-bottom: 1px solid var(--color-line); background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(14px); }
  .header-inner { display: flex; min-height: 70px; align-items: center; justify-content: space-between; gap: 1.25rem; }
  .brand { display: inline-flex; flex: 0 0 auto; align-items: center; color: var(--color-navy); text-decoration: none; }
  .brand img { display: block; width: 146px; height: 49px; object-fit: contain; }
  .desktop-nav { display: flex; align-items: center; gap: 0.35rem; }
  .desktop-nav a { border-radius: 0.65rem; padding: 0.58rem 0.72rem; color: var(--color-muted); font-family: var(--font-heading); font-size: 0.84rem; font-weight: 600; text-decoration: none; transition: background 150ms ease, color 150ms ease; }
  .desktop-nav a:hover, .desktop-nav a.active { background: var(--color-phinisi-50); color: var(--color-phinisi-700); }
  .header-actions { display: flex; align-items: center; gap: 0.85rem; }
  .search-wrap { position: relative; width: 220px; }
  .language-switcher { display: flex; align-items: center; gap: 0.25rem; color: #9aa9bc; font-size: 0.72rem; }
  .language-switcher a { color: var(--color-muted); font-weight: 700; text-decoration: none; }
  .language-switcher a.active { color: var(--color-phinisi-600); }
  .mobile-menu { display: none; position: relative; }
  .mobile-menu summary { display: grid; width: 42px; height: 42px; place-items: center; border: 1px solid var(--color-line); border-radius: 0.8rem; background: white; color: var(--color-navy); cursor: pointer; list-style: none; }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .mobile-menu nav { position: absolute; top: calc(100% + 0.75rem); right: 0; display: grid; min-width: 210px; gap: 0.25rem; border: 1px solid var(--color-line); border-radius: 1rem; padding: 0.6rem; background: white; box-shadow: var(--shadow-card); }
  .mobile-menu nav a { border-radius: 0.65rem; padding: 0.75rem; color: var(--color-ink); font-family: var(--font-heading); font-weight: 600; text-decoration: none; }
  .mobile-menu nav a:hover { background: var(--color-phinisi-50); color: var(--color-phinisi-700); }

  :global(.search-wrap) { --pagefind-ui-scale: 0.72; --pagefind-ui-primary: #145bd7; --pagefind-ui-text: #5f6f89; --pagefind-ui-background: #f5f9ff; --pagefind-ui-border: #dce7f5; --pagefind-ui-border-width: 1px; --pagefind-ui-border-radius: 14px; --pagefind-ui-font: 'Inter', sans-serif; }
  :global(.search-wrap .pagefind-ui__search-input) { min-height: 44px !important; font-weight: 500 !important; box-shadow: none !important; }
  :global(.search-wrap .pagefind-ui__drawer) { position: absolute; top: calc(100% + 0.6rem); right: 0; left: auto; width: min(420px, 85vw); max-height: 480px; overflow: auto; border: 1px solid var(--color-line); border-radius: 1rem; padding: 1rem; background: white; box-shadow: var(--shadow-card); }
  :global(.pagefind-ui__result-link) { color: var(--color-phinisi-700) !important; }
  :global(.pagefind-ui__result-excerpt mark) { background: var(--color-phinisi-100) !important; color: var(--color-phinisi-800) !important; }

  @media (max-width: 1080px) { .search-wrap { display: none; } }
  @media (max-width: 820px) { .desktop-nav { display: none; } .mobile-menu { display: block; } }
  @media (max-width: 560px) { .header-inner { min-height: 68px; gap: 0.6rem; } .header-actions { gap: 0.55rem; } .language-switcher { display: none; } .brand img { width: 124px; height: 42px; } :global(.header-cta) { min-height: 36px; padding: 0.55rem 0.75rem; font-size: 0.75rem; } }
</style>
