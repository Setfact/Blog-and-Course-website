---
import BaseLayout from '../layouts/BaseLayout.astro';
import DashboardSidebar from '../components/dashboard/DashboardSidebar.astro';
import { loadCourses } from '../data/learning';
import { createSupabaseServerClient } from '../lib/supabase';
import { getRankTier, BADGE_DEFINITIONS, TIERS } from '../lib/rank';
import { getXpHistory } from '../lib/xp';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/dashboard');
}

const errorParam = Astro.url.searchParams.get('error');
let errorNotice = '';
if (errorParam === 'unauthorized_keystatic') {
  errorNotice = 'Halaman Keystatic CMS dikhususkan untuk Administrator (Superadmin). Anda telah dialihkan ke Dasbor Siswa.';
} else if (errorParam === 'unauthorized_admin') {
  errorNotice = 'Halaman Administrator hanya dapat diakses oleh akun pengelola yang berwenang.';
}

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

// Ambil data progres belajar dan pengumuman platform
const completedLessonsSet = new Set<string>();
let activeAnnouncement = null;

if (supabase) {
  try {
    const [progressRes, announceRes] = await Promise.all([
      supabase.from('user_lesson_progress').select('course_slug, lesson_id').eq('user_id', user.id),
      supabase.from('platform_announcements').select('*').eq('is_active', true).order('created_at', { ascending: false }).limit(1).maybeSingle(),
    ]);

    if (progressRes.data) {
      progressRes.data.forEach((r: { course_slug: string; lesson_id: string }) => completedLessonsSet.add(`${r.course_slug}/${r.lesson_id}`));
    }
    if (announceRes.data) {
      activeAnnouncement = announceRes.data;
    }
  } catch (err) {
    console.error('Error fetching dashboard progress:', err);
  }
}

const [courses, xpLedger] = await Promise.all([
  loadCourses(),
  getXpHistory(supabase, user.id, 8),
]);

const rankTier = getRankTier(user.xp);

// Evaluasi lencana biota laut
const earnedBadges = new Set<string>();
if (completedLessonsSet.size >= 1) earnedBadges.add('ikan-badut');
const securityCount = Array.from(completedLessonsSet).filter((k) => k.startsWith('security-fundamentals/')).length;
if (securityCount >= 1) earnedBadges.add('ikan-buntal');
if (securityCount >= 5) earnedBadges.add('benteng-karang');
const ccnaCount = Array.from(completedLessonsSet).filter((k) => k.startsWith('ccna-fundamentals/')).length;
if (ccnaCount >= 1) earnedBadges.add('ikan-pedang');
if (user.streak >= 3) earnedBadges.add('pari-manta');
if (user.xp >= 900) earnedBadges.add('taring-megalodon');
if (xpLedger.some((entry) => entry.source === 'community_solution')) earnedBadges.add('lumba-lumba');
if (xpLedger.some((entry) => entry.source === 'quiz_pass')) earnedBadges.add('kuda-laut');
const anyCourseFinished = courses.some((c) => {
  const count = Array.from(completedLessonsSet).filter((k) => k.startsWith(`${c.slug}/`)).length;
  return count >= (c.lessonCount || 1) && (c.lessonCount || 0) > 0;
});
if (anyCourseFinished) earnedBadges.add('mutiara-kraken');

// Kursus aktif terakhir untuk quick preview
const activeCourse = courses.find((c) => {
  const count = Array.from(completedLessonsSet).filter((k) => k.startsWith(`${c.slug}/`)).length;
  return count > 0 && count < (c.lessonCount || 1);
}) || courses[0];

const activeCourseCompleted = activeCourse
  ? Array.from(completedLessonsSet).filter((k) => k.startsWith(`${activeCourse.slug}/`)).length
  : 0;
const activeCourseTotal = activeCourse?.lessonCount || 1;
const activeCoursePercent = Math.min(100, Math.round((activeCourseCompleted / activeCourseTotal) * 100));

const isProfileComplete = Boolean(
  user.is_profile_complete ||
  (user.full_name && user.country && (user.province || user.city) && user.institution_name)
);
---

<BaseLayout title="Ringkasan Belajar Siswa" description="Pantau evolusi pangkat biota laut, perolehan XP, dan aktivitas belajar jaringan Anda.">
  <div class="dashboard-page-container fluid-layout">
    
    <!-- Breadcrumb Navigasi -->
    <nav class="dashboard-breadcrumb" aria-label="Breadcrumb">
      <span class="breadcrumb-current">Dasbor</span>
      <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
      <span class="breadcrumb-sub">Ringkasan Belajar</span>
    </nav>

    <div class="dashboard-layout">
      <!-- Sidebar Navigasi -->
      <DashboardSidebar activeTab="overview" user={user} rankTier={rankTier} />

      <!-- Area Konten Utama -->
      <main class="dashboard-main-content">
        
        <!-- Platform Announcement Banner If Active -->
        {activeAnnouncement && (
          <aside class:list={['announcement-banner', `announce-${activeAnnouncement.type}`]}>
            <div class="announce-icon-wrap">
              <span class="material-symbols-outlined">campaign</span>
            </div>
            <div class="announce-content">
              <strong>Pengumuman Platform</strong>
              <p>{activeAnnouncement.message}</p>
            </div>
          </aside>
        )}

        <!-- Notice Banner If Redirected with Error -->
        {errorNotice && (
          <aside class="dashboard-notice-banner" role="alert">
            <div class="notice-icon-wrap">
              <span class="material-symbols-outlined">lock</span>
            </div>
            <div class="notice-content">
              <strong>Akses Dibatasi</strong>
              <p>{errorNotice}</p>
            </div>
          </aside>
        )}

        <!-- Banner Status Kelengkapan Profil untuk Sertifikat -->
        {!isProfileComplete ? (
          <aside class="cert-profile-notice pending" role="status">
            <div class="cert-notice-icon-wrap">
              <span class="material-symbols-outlined">badge</span>
            </div>
            <div class="cert-notice-content">
              <div class="cert-notice-title-row">
                <strong>Data Profil Resmi Belum Lengkap</strong>
                <span class="cert-status-tag pending">Prasyarat E-Sertifikat</span>
              </div>
              <p>Lengkapi nama resmi, no. WhatsApp, dan asal instansi Anda di pengaturan akun agar e-sertifikat kelulusan dapat diterbitkan secara sah.</p>
            </div>
            <a href="/dashboard/profil" class="btn-complete-profile">
              <span>Lengkapi Profil</span>
              <span class="material-symbols-outlined icon-inline">arrow_forward</span>
            </a>
          </aside>
        ) : (
          <aside class="cert-profile-notice verified" role="status">
            <div class="cert-notice-icon-wrap">
              <span class="material-symbols-outlined">verified</span>
            </div>
            <div class="cert-notice-content">
              <div class="cert-notice-title-row">
                <strong>Profil Terverifikasi untuk Penerbitan Sertifikat</strong>
                <span class="cert-status-tag active">Siap Terbit</span>
              </div>
              <p>Nama resmi terdaftar: <strong>{user.full_name}</strong> {user.institution_name ? `(${user.institution_name})` : ''} &middot; Domisili: {user.city ? `${user.city}, ` : ''}{user.province || 'Indonesia'}.</p>
            </div>
            <a href="/dashboard/profil" class="btn-view-profile">
              <span>Pengaturan Profil</span>
            </a>
          </aside>
        )}

        <!-- Hero Header Ringkasan Siswa -->
        <header class="overview-hero-card">
          <div class="hero-left">
            <div class="hero-avatar-box">
              {user.avatar_url ? (
                <img src={user.avatar_url} alt={user.full_name} class="hero-avatar-img" width="68" height="68" />
              ) : (
                <div class="hero-avatar-fallback">{user.full_name.slice(0, 2).toUpperCase()}</div>
              )}
            </div>
            <div class="hero-text-box">
              <div class="hero-badge-row">
                <span class="role-pill">{user.role === 'admin' ? 'Administrator' : 'Siswa Phinisi'}</span>
                <span class="location-pill">
                  <span class="material-symbols-outlined icon-micro">location_on</span>
                  <span>{user.city ? `${user.city}, ${user.province || 'ID'}` : 'Indonesia'}</span>
                </span>
              </div>
              <h1 class="hero-title">Selamat Datang, {user.full_name}</h1>
              <p class="hero-bio">
                {user.bio || 'Pelajar aktif arsitektur jaringan komputer dan infrastruktur digital Phinisi Learn.'}
              </p>
            </div>
          </div>

          <div class="hero-right-actions">
            <a href="/dashboard/kelas" class="btn-hero-primary">
              <span class="material-symbols-outlined icon-btn">school</span>
              <span>Kelas Jaringan Saya</span>
            </a>
            <a href="/community" class="btn-hero-secondary">
              <span class="material-symbols-outlined icon-btn">forum</span>
              <span>Forum Komunitas</span>
            </a>
            {user.role === 'admin' && (
              <a href="/admin" class="btn-hero-admin">
                <span class="material-symbols-outlined icon-btn">admin_panel_settings</span>
                <span>Panel Admin</span>
              </a>
            )}
          </div>
        </header>

        <!-- Kartu Pangkat Biota Laut & Progres XP Utama -->
        <section class="rank-ocean-card" aria-label="Tingkatan Pangkat Biota Laut">
          <div class="rank-card-top">
            <div class="rank-identity-cluster">
              <div class="rank-avatar-seal" style={`background: ${rankTier.badgeColor};`}>
                <span class="material-symbols-outlined">{rankTier.icon}</span>
              </div>
              <div class="rank-meta-details">
                <span class="rank-badge-kicker">Tingkatan Evolusi Samudra</span>
                <h2 class="rank-animal-name">{rankTier.name}</h2>
                <span class="rank-philosophical-title">{rankTier.title}</span>
              </div>
            </div>

            <div class="rank-xp-header-box">
              <button type="button" class="btn-open-evolution-guide" id="open-ranks-modal-btn">
                <span class="material-symbols-outlined icon-btn">explore</span>
                <span>Panduan 6 Jenjang Biota Laut</span>
              </button>
              <div class="xp-score-capsule">
                <span class="material-symbols-outlined icon-bolt">bolt</span>
                <div class="xp-score-text">
                  <strong class="xp-amount">{user.xp}</strong>
                  <span class="xp-label">Total XP</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Progress Bar Evolusi -->
          <div class="rank-evolution-progress">
            <div class="progress-track-shell">
              <div
                class="progress-fill-glow"
                style={`width: ${rankTier.progressPercent}%; background: ${rankTier.badgeColor};`}
              ></div>
            </div>
            <div class="progress-info-split">
              <span class="current-tier-xp">{rankTier.minXp} XP ({rankTier.name})</span>
              {rankTier.nextTierName ? (
                <span class="next-tier-target">
                  Kurang <strong>{rankTier.remainingXp} XP</strong> menuju evolusi <strong>{rankTier.nextTierName}</strong> ({rankTier.maxXp} XP)
                </span>
              ) : (
                <span class="max-tier-congrats">Tingkatan Evolusi Tertinggi Tercapai! (Penguasa Samudra)</span>
              )}
            </div>
          </div>

          <!-- Active Perks Box -->
          <div class="rank-perks-box">
            <div class="perks-title-line">
              <span class="material-symbols-outlined icon-perk-header">verified</span>
              <strong class="perks-headline">Keuntungan Aktif Pangkat {rankTier.name}:</strong>
            </div>
            <ul class="perks-clean-list">
              {rankTier.perks.map((perk) => (
                <li>
                  <span class="material-symbols-outlined icon-check">check_circle</span>
                  <span>{perk}</span>
                </li>
              ))}
            </ul>

            {rankTier.downloadableAssets && rankTier.downloadableAssets.length > 0 && (
              <div class="unlocked-assets-strip">
                <span class="assets-label">Aset Lab Terbuka:</span>
                <div class="assets-list-row">
                  {rankTier.downloadableAssets.map((asset) => (
                    <span class="asset-capsule" title={asset.description}>
                      <span class="material-symbols-outlined icon-capsule">download</span>
                      <span>{asset.name} ({asset.type})</span>
                    </span>
                  ))}
                </div>
              </div>
            )}
          </div>
        </section>

        <!-- Stats Grid Belajar Siswa -->
        <section class="stats-counter-grid" aria-label="Statistik Belajar">
          <div class="stat-counter-card">
            <div class="stat-icon-wrap stat-xp">
              <span class="material-symbols-outlined">bolt</span>
            </div>
            <div class="stat-meta">
              <span class="stat-caption">Total Pengalaman</span>
              <strong class="stat-value">{user.xp} XP</strong>
            </div>
          </div>

          <div class="stat-counter-card">
            <div class="stat-icon-wrap stat-streak">
              <span class="material-symbols-outlined">local_fire_department</span>
            </div>
            <div class="stat-meta">
              <span class="stat-caption">Hari Streak Belajar</span>
              <strong class="stat-value">{user.streak} Hari</strong>
            </div>
          </div>

          <div class="stat-counter-card">
            <div class="stat-icon-wrap stat-lessons">
              <span class="material-symbols-outlined">task_alt</span>
            </div>
            <div class="stat-meta">
              <span class="stat-caption">Materi Diselesaikan</span>
              <strong class="stat-value">{completedLessonsSet.size} Modul</strong>
            </div>
          </div>

          <div class="stat-counter-card">
            <div class="stat-icon-wrap stat-badges">
              <span class="material-symbols-outlined">military_tech</span>
            </div>
            <div class="stat-meta">
              <span class="stat-caption">Lencana Koleksi</span>
              <strong class="stat-value">{earnedBadges.size}/{BADGE_DEFINITIONS.length} Lencana</strong>
            </div>
          </div>
        </section>

        <!-- Grid 2 Kolom: Quick Action (Kelas Terakhir & Lencana) + Riwayat Aktivitas & XP -->
        <div class="overview-dual-grid">
          
          <!-- Kolom Kiri: Quick Preview Kelas Aktif & Lencana -->
          <div class="dual-left-col">
            
            <!-- Quick Card: Kelas Saya -->
            <div class="quick-module-card">
              <div class="card-header-line">
                <div class="card-header-text">
                  <span class="card-kicker">Lanjutkan Kursus</span>
                  <h3 class="card-heading">{activeCourse.title}</h3>
                </div>
                <a href="/dashboard/kelas" class="card-more-link">Semua Kelas</a>
              </div>

              <p class="quick-course-desc">{activeCourse.description.id}</p>

              <div class="quick-progress-block">
                <div class="quick-progress-meta">
                  <span class="qp-label">Progres Pembelajaran</span>
                  <strong class="qp-val">{activeCourseCompleted}/{activeCourseTotal} modul ({activeCoursePercent}%)</strong>
                </div>
                <div class="quick-progress-track">
                  <div class="quick-progress-fill" style={`width: ${activeCoursePercent}%;`}></div>
                </div>
              </div>

              <div class="quick-card-action">
                <a href={`/courses/${activeCourse.slug}`} class="btn-quick-primary">
                  <span>{activeCoursePercent > 0 ? 'Lanjutkan Modul' : 'Mulai Belajar'}</span>
                  <span class="material-symbols-outlined icon-inline">arrow_forward</span>
                </a>
              </div>
            </div>

            <!-- Quick Card: Lencana Biota Laut -->
            <div class="quick-module-card">
              <div class="card-header-line">
                <div class="card-header-text">
                  <span class="card-kicker">Pencapaian Biota Laut</span>
                  <h3 class="card-heading">Lencana Koleksi Anda</h3>
                </div>
                <a href="/dashboard/lencana" class="card-more-link">Lihat Semua</a>
              </div>

              <p class="quick-badge-desc">
                Raih lencana bertema biota laut dari <strong>Ikan Badut</strong> hingga <strong>Mutiara Kraken</strong> dengan menyelesaikan studi kasus lab.
              </p>

              <div class="quick-badges-strip">
                {BADGE_DEFINITIONS.slice(0, 5).map((badge) => {
                  const isEarned = earnedBadges.has(badge.id);
                  return (
                    <div
                      class:list={['mini-badge-bubble', isEarned ? 'earned' : 'locked']}
                      title={`${badge.name}: ${badge.description} (${isEarned ? 'Tercapai' : 'Terkunci'})`}
                    >
                      <span class="material-symbols-outlined icon-mini-badge">
                        {isEarned ? badge.icon : 'lock'}
                      </span>
                    </div>
                  );
                })}
                <div class="mini-badge-bubble more">
                  <span>+{BADGE_DEFINITIONS.length - 5}</span>
                </div>
              </div>

              <div class="quick-card-action">
                <a href="/dashboard/lencana" class="btn-quick-secondary">
                  <span>Buka Galeri Lencana</span>
                  <span class="material-symbols-outlined icon-inline">arrow_forward</span>
                </a>
              </div>
            </div>

          </div>

          <!-- Kolom Kanan: Riwayat Aktivitas & XP (Clean Feed) -->
          <div class="dual-right-col">
            <section class="activity-history-card" aria-label="Riwayat Aktivitas & XP">
              <div class="history-header">
                <div>
                  <h3 class="history-title">Riwayat Aktivitas & XP</h3>
                  <p class="history-desc">Catatan perolehan poin pengalaman dari modul materi, evaluasi kuis, dan kontribusi komunitas.</p>
                </div>
                <span class="history-count-tag">{xpLedger.length} Mutasi Terakhir</span>
              </div>

              <div class="history-timeline-list">
                {xpLedger.length === 0 ? (
                  <div class="empty-history-box">
                    <span class="material-symbols-outlined icon-empty">history</span>
                    <p>Belum ada aktivitas tercatat. Mulai pelajari materi pertama Anda di silabus!</p>
                  </div>
                ) : (
                  xpLedger.map((entry) => (
                    <div class="history-timeline-item">
                      <div class:list={['history-icon-box', `source-${entry.source}`]}>
                        <span class="material-symbols-outlined">
                          {entry.source === 'community_solution'
                            ? 'verified'
                            : entry.source === 'course_completion'
                              ? 'school'
                              : entry.source === 'quiz_pass'
                                ? 'psychology'
                                : 'task_alt'}
                        </span>
                      </div>
                      <div class="history-content-box">
                        <strong class="history-item-title">{entry.title}</strong>
                        <span class="history-item-time">
                          {new Date(entry.created_at).toLocaleDateString('id-ID', {
                            day: 'numeric',
                            month: 'short',
                            year: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                          })}
                        </span>
                      </div>
                      <div class="history-xp-badge">
                        <span>+{entry.amount} XP</span>
                      </div>
                    </div>
                  ))
                )}
              </div>
            </section>
          </div>

        </div>

      </main>
    </div>
  </div>

  <!-- Ranks & Perks Guide Modal Dialog -->
  <dialog id="ranks-guide-modal" class="guide-modal">
    <div class="guide-modal-card">
      <div class="modal-header">
        <div class="guide-title-box">
          <span class="guide-kicker">SISTEM EVOLUSI SAMUDRA</span>
          <h3 class="modal-title">Jenjang Pangkat Biota Laut & Hak Istimewa Siswa</h3>
        </div>
        <button type="button" class="modal-close-btn" id="close-ranks-modal-btn" aria-label="Tutup panduan">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <div class="modal-body-scroll">
        <p class="modal-intro-text">
          Di Phinisi Learn, tingkatan pangkat siswa bertransformasi mengikuti metamorfosis kehidupan laut. Naikkan akumulasi XP Anda dari perenang kecil pesisir hingga menjadi penguasa palung mitologis samudera!
        </p>

        <div class="tier-cards-container">
          {TIERS.map((tier, idx) => (
            <div class:list={['tier-guide-item', { 'current-user-tier': tier.id === rankTier.id }]}>
              <div class="tier-badge-column">
                <div class="tier-seal" style={`background: ${tier.badgeColor};`}>
                  <span class="material-symbols-outlined">{tier.icon}</span>
                </div>
                <span class="tier-level-index">Tingkat {idx + 1}</span>
              </div>

              <div class="tier-body-column">
                <div class="tier-name-row">
                  <div>
                    <h4 class="tier-name-text">{tier.name}</h4>
                    <span class="tier-title-text">{tier.title}</span>
                  </div>
                  <div class="tier-xp-range">
                    {tier.maxXp === Infinity ? (
                      <span class="range-pill">{tier.minXp}+ XP</span>
                    ) : (
                      <span class="range-pill">{tier.minXp} - {tier.maxXp} XP</span>
                    )}
                  </div>
                </div>

                <div class="tier-perks-section">
                  <strong class="perks-subheading">Hak Istimewa & Fasilitas:</strong>
                  <ul class="tier-perks-bullets">
                    {tier.perks.map((p) => (
                      <li>
                        <span class="material-symbols-outlined bullet-check">check</span>
                        <span>{p}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </dialog>

  <!-- Modal Script Handler -->
  <script>
    const modal = document.getElementById('ranks-guide-modal') as HTMLDialogElement | null;
    const openBtn = document.getElementById('open-ranks-modal-btn');
    const closeBtn = document.getElementById('close-ranks-modal-btn');

    openBtn?.addEventListener('click', () => {
      modal?.showModal();
    });

    closeBtn?.addEventListener('click', () => {
      modal?.close();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.close();
      }
    });
  </script>
</BaseLayout>

<style>
  .dashboard-page-container.fluid-layout {
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
    padding-inline: clamp(1.25rem, 3vw, 3.5rem);
    padding-block: clamp(1.5rem, 2.5vw, 3rem);
    box-sizing: border-box;
  }

  .dashboard-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .breadcrumb-separator {
    font-size: 1rem;
    color: #94a3b8;
  }

  .breadcrumb-current {
    color: var(--color-muted);
    font-weight: 600;
  }

  .breadcrumb-sub {
    color: var(--color-navy);
    font-weight: 700;
  }

  .dashboard-layout {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
    width: 100%;
  }

  .dashboard-main-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Notice Banners */
  .announcement-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    color: #1e40af;
  }

  .announce-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #3b82f6;
    color: #ffffff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .dashboard-notice-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .notice-icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ef4444;
    color: #ffffff;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .cert-profile-notice {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 1.5rem;
    border-radius: 1.15rem;
    background: #ffffff;
    border: 1px solid var(--color-line);
    box-shadow: 0 2px 10px rgba(8, 26, 58, 0.03);
    flex-wrap: wrap;
  }

  .cert-profile-notice.pending {
    border-color: #fde68a;
    background: linear-gradient(135deg, #fffbeb 0%, #ffffff 100%);
  }

  .cert-profile-notice.verified {
    border-color: #bbf7d0;
    background: linear-gradient(135deg, #f0fdf4 0%, #ffffff 100%);
  }

  .cert-notice-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .cert-profile-notice.pending .cert-notice-icon-wrap {
    background: #fef3c7;
    color: #d97706;
  }

  .cert-profile-notice.verified .cert-notice-icon-wrap {
    background: #dcfce7;
    color: #16a34a;
  }

  .cert-notice-content {
    flex: 1;
    min-width: 0;
  }

  .cert-notice-title-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.2rem;
  }

  .cert-notice-title-row strong {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    color: var(--color-navy);
  }

  .cert-status-tag {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }

  .cert-status-tag.pending {
    background: #fef3c7;
    color: #b45309;
  }

  .cert-status-tag.active {
    background: #dcfce7;
    color: #15803d;
  }

  .cert-notice-content p {
    font-size: 0.84rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.45;
  }

  .btn-complete-profile, .btn-view-profile {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 1.1rem;
    border-radius: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: all 140ms ease;
  }

  .btn-complete-profile {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-complete-profile:hover {
    background: #0f4bb5;
  }

  .btn-view-profile {
    background: #f1f5f9;
    color: var(--color-navy);
    border: 1px solid var(--color-line);
  }

  .btn-view-profile:hover {
    background: #e2e8f0;
  }

  /* Overview Hero Card */
  .overview-hero-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.35rem;
    padding: 1.5rem 1.75rem;
    box-shadow: 0 4px 20px rgba(8, 26, 58, 0.04);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex: 1;
    min-width: 0;
  }

  .hero-avatar-box {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 3px solid #ffffff;
    box-shadow: 0 4px 14px rgba(8, 26, 58, 0.1);
  }

  .hero-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .hero-avatar-fallback {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--color-primary) 0%, #1e40af 100%);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    display: grid;
    place-items: center;
  }

  .hero-text-box {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .hero-badge-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .role-pill {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-primary);
    background: #eff6ff;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }

  .location-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.74rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  .icon-micro {
    font-size: 0.85rem;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 1.8vw, 1.7rem);
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
    line-height: 1.25;
  }

  .hero-bio {
    font-size: 0.86rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.45;
  }

  .hero-right-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .btn-hero-primary, .btn-hero-secondary, .btn-hero-admin {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    border-radius: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 140ms ease;
  }

  .btn-hero-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-hero-primary:hover {
    background: #0f4bb5;
  }

  .btn-hero-secondary {
    background: #f1f5f9;
    color: var(--color-navy);
    border: 1px solid var(--color-line);
  }

  .btn-hero-secondary:hover {
    background: #e2e8f0;
  }

  .btn-hero-admin {
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .icon-btn {
    font-size: 1.05rem;
  }

  /* Rank Ocean Card */
  .rank-ocean-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.35rem;
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(8, 26, 58, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .rank-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .rank-identity-cluster {
    display: flex;
    align-items: center;
    gap: 1.15rem;
  }

  .rank-avatar-seal {
    width: 60px;
    height: 60px;
    border-radius: 1.15rem;
    color: #ffffff;
    display: grid;
    place-items: center;
    box-shadow: 0 6px 16px rgba(8, 26, 58, 0.15);
    flex-shrink: 0;
  }

  .rank-avatar-seal .material-symbols-outlined {
    font-size: 2rem;
  }

  .rank-meta-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .rank-badge-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .rank-animal-name {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
    line-height: 1.2;
  }

  .rank-philosophical-title {
    font-size: 0.88rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  .rank-xp-header-box {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .btn-open-evolution-guide {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.95rem;
    border-radius: 0.75rem;
    background: #f8fafc;
    border: 1px solid var(--color-line);
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 140ms ease;
  }

  .btn-open-evolution-guide:hover {
    background: #e2e8f0;
  }

  .xp-score-capsule {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #fef3c7;
    border: 1px solid #fde68a;
    border-radius: 0.85rem;
    padding: 0.5rem 0.9rem;
  }

  .icon-bolt {
    font-size: 1.5rem;
    color: #d97706;
  }

  .xp-score-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .xp-amount {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: #92400e;
  }

  .xp-label {
    font-size: 0.68rem;
    font-weight: 700;
    color: #b45309;
    text-transform: uppercase;
  }

  .rank-evolution-progress {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .progress-track-shell {
    width: 100%;
    height: 10px;
    background: #f1f5f9;
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid #e2e8f0;
  }

  .progress-fill-glow {
    height: 100%;
    border-radius: 999px;
    transition: width 350ms ease;
  }

  .progress-info-split {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .current-tier-xp {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-navy);
  }

  .next-tier-target strong {
    color: var(--color-navy);
  }

  .max-tier-congrats {
    font-family: var(--font-heading);
    font-weight: 700;
    color: #059669;
  }

  .rank-perks-box {
    background: #f8fafc;
    border: 1px solid var(--color-line);
    border-radius: 1.15rem;
    padding: 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .perks-title-line {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .icon-perk-header {
    font-size: 1.15rem;
    color: var(--color-primary);
  }

  .perks-headline {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--color-navy);
  }

  .perks-clean-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.6rem 1.25rem;
  }

  .perks-clean-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .icon-check {
    font-size: 1rem;
    color: #10b981;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .unlocked-assets-strip {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #e2e8f0;
    flex-wrap: wrap;
  }

  .assets-label {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .assets-list-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .asset-capsule {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .icon-capsule {
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  /* Stats Counter Grid */
  .stats-counter-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .stat-counter-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.15rem;
    padding: 1.25rem;
    box-shadow: 0 2px 10px rgba(8, 26, 58, 0.03);
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .stat-icon-wrap {
    width: 46px;
    height: 46px;
    border-radius: 1rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .stat-xp {
    background: #fef3c7;
    color: #d97706;
  }

  .stat-streak {
    background: #fee2e2;
    color: #dc2626;
  }

  .stat-lessons {
    background: #eff6ff;
    color: var(--color-primary);
  }

  .stat-badges {
    background: #ecfdf5;
    color: #059669;
  }

  .stat-meta {
    display: flex;
    flex-direction: column;
  }

  .stat-caption {
    font-size: 0.74rem;
    color: var(--color-muted);
    font-weight: 600;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
  }

  /* Overview Dual Grid */
  .overview-dual-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .dual-left-col, .dual-right-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Quick Module Cards */
  .quick-module-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: 1.35rem 1.5rem;
    box-shadow: 0 2px 10px rgba(8, 26, 58, 0.03);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card-header-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card-header-text {
    display: flex;
    flex-direction: column;
  }

  .card-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }

  .card-heading {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }

  .card-more-link {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .card-more-link:hover {
    text-decoration: underline;
  }

  .quick-course-desc, .quick-badge-desc {
    font-size: 0.84rem;
    color: var(--color-ink);
    opacity: 0.85;
    line-height: 1.45;
    margin: 0;
  }

  .quick-progress-block {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: #f8fafc;
    padding: 0.65rem 0.85rem;
    border-radius: 0.75rem;
  }

  .quick-progress-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.76rem;
  }

  .qp-label {
    color: var(--color-muted);
    font-weight: 600;
  }

  .qp-val {
    font-family: var(--font-heading);
    color: var(--color-navy);
    font-weight: 700;
  }

  .quick-progress-track {
    width: 100%;
    height: 6px;
    background: #e2e8f0;
    border-radius: 999px;
    overflow: hidden;
  }

  .quick-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-primary) 0%, #3b82f6 100%);
    border-radius: 999px;
  }

  .quick-badges-strip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mini-badge-bubble {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--color-line);
    cursor: default;
  }

  .mini-badge-bubble.earned {
    background: #eff6ff;
    color: var(--color-primary);
    border-color: #bfdbfe;
  }

  .mini-badge-bubble.locked {
    background: #f8fafc;
    color: #94a3b8;
  }

  .mini-badge-bubble.more {
    background: #f1f5f9;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .icon-mini-badge {
    font-size: 1.15rem;
  }

  .quick-card-action {
    display: flex;
  }

  .btn-quick-primary, .btn-quick-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.95rem;
    border-radius: 0.7rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 140ms ease;
  }

  .btn-quick-primary {
    background: var(--color-primary);
    color: #ffffff;
  }

  .btn-quick-primary:hover {
    background: #0f4bb5;
  }

  .btn-quick-secondary {
    background: #f1f5f9;
    color: var(--color-navy);
    border: 1px solid var(--color-line);
  }

  .btn-quick-secondary:hover {
    background: #e2e8f0;
  }

  /* Riwayat Aktivitas & XP */
  .activity-history-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: 1.35rem 1.5rem;
    box-shadow: 0 2px 10px rgba(8, 26, 58, 0.03);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .history-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 1rem;
  }

  .history-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 0.2rem 0;
  }

  .history-desc {
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.4;
    margin: 0;
  }

  .history-count-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-primary);
    background: #eff6ff;
    padding: 0.2rem 0.55rem;
    border-radius: 0.45rem;
    white-space: nowrap;
  }

  .history-timeline-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .history-timeline-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.65rem 0.85rem;
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 0.85rem;
    transition: all 140ms ease;
  }

  .history-timeline-item:hover {
    background: #f1f5f9;
    border-color: #e2e8f0;
  }

  .history-icon-box {
