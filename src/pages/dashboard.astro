</BaseLayout>

<script>
  // Modal Panduan Pangkat Script
  const ranksModal = document.getElementById('ranks-guide-modal') as HTMLDialogElement | null;
  const openRanksBtn = document.getElementById('open-ranks-modal-btn');
  const closeRanksBtn = document.getElementById('close-ranks-modal-btn');

  if (openRanksBtn && ranksModal) {
    openRanksBtn.addEventListener('click', () => ranksModal.showModal());
  }
  if (closeRanksBtn && ranksModal) {
    closeRanksBtn.addEventListener('click', () => ranksModal.close());
  }
  if (ranksModal) {
    ranksModal.addEventListener('click', (e) => {
      if (e.target === ranksModal) ranksModal.close();
    });
  }

  // Modal Edit Profil Script
  const modal = document.getElementById('edit-profile-modal') as HTMLDialogElement | null;
  const openBtn = document.getElementById('open-edit-modal-btn');
  const bannerOpenBtn = document.getElementById('banner-open-edit-btn');
  const bannerViewBtn = document.getElementById('banner-view-edit-btn');
  const closeBtn = document.getElementById('close-edit-modal-btn');
  const cancelBtn = document.getElementById('cancel-edit-btn');
  const form = document.getElementById('edit-profile-form') as HTMLFormElement | null;
  const errorMsg = document.getElementById('modal-error-msg');
  const saveBtn = document.getElementById('save-profile-btn') as HTMLButtonElement | null;

  const countrySelect = document.getElementById('edit-country') as HTMLSelectElement | null;
  const dialCodeSelect = document.getElementById('edit-dial-code') as HTMLSelectElement | null;
  const provinceContainer = document.getElementById('province-field-container');
  const cityContainer = document.getElementById('city-field-container');

  let provincesData: any[] = [];
  try {
    const rawGeoData = document.getElementById('geo-provinces-data')?.textContent;
    if (rawGeoData) provincesData = JSON.parse(rawGeoData);
  } catch (e) {
    console.error('Error parsing geo provinces data:', e);
  }

  const initialProvince = provinceContainer?.dataset.selectedProvince || '';
  const initialCity = cityContainer?.dataset.selectedCity || '';

  const updateLocationInputs = (country: string, selectedProvince = '', selectedCity = '') => {
    if (!provinceContainer || !cityContainer) return;

    if (country === 'Indonesia') {
      let provOptions = '<option value="">-- Pilih Provinsi --</option>';
      provincesData.forEach((prov: any) => {
        const sel = prov.name === selectedProvince ? 'selected' : '';
        provOptions += `<option value="${prov.name}" ${sel}>${prov.name}</option>`;
      });

      provinceContainer.innerHTML = `
        <label for="edit-province" class="field-label">Provinsi *</label>
        <select id="edit-province" name="province" class="select-input" required>
          ${provOptions}
        </select>
      `;

      const updateCities = (provName: string, cityToSelect = '') => {
        const found = provincesData.find((p: any) => p.name === provName);
        let cityOptions = '<option value="">-- Pilih Kota / Kabupaten --</option>';
        if (found && found.cities) {
          found.cities.forEach((c: string) => {
            const sel = c === cityToSelect ? 'selected' : '';
            cityOptions += `<option value="${c}" ${sel}>${c}</option>`;
          });
        }
        cityContainer.innerHTML = `
          <label for="edit-city" class="field-label">Kota / Kabupaten *</label>
          <select id="edit-city" name="city" class="select-input" required>
            ${cityOptions}
          </select>
        `;
      };

      const provSel = document.getElementById('edit-province') as HTMLSelectElement | null;
      updateCities(selectedProvince || (provSel?.value || ''), selectedCity);

      provSel?.addEventListener('change', () => {
        updateCities(provSel.value, '');
      });
    } else {
      provinceContainer.innerHTML = `
        <label for="edit-province" class="field-label">State / Province / Region</label>
        <input
          type="text"
          id="edit-province"
          name="province"
          value="${selectedProvince}"
          placeholder="Contoh: Selangor, California, Tokyo..."
          class="text-input"
          maxlength="80"
        />
      `;

      cityContainer.innerHTML = `
        <label for="edit-city" class="field-label">Kota / City</label>
        <input
          type="text"
          id="edit-city"
          name="city"
          value="${selectedCity}"
          placeholder="Contoh: Petaling Jaya, Los Angeles, Shibuya..."
          class="text-input"
          maxlength="80"
        />
      `;
    }
  };

  // Setup awal lokasi
  updateLocationInputs(countrySelect?.value || 'Indonesia', initialProvince, initialCity);

  // Listener perubahan negara
  if (countrySelect) {
    countrySelect.addEventListener('change', () => {
      const selectedOption = countrySelect.options[countrySelect.selectedIndex];
      const dialCode = selectedOption?.dataset.dial;
      if (dialCode && dialCodeSelect) {
        dialCodeSelect.value = dialCode;
      }
      updateLocationInputs(countrySelect.value, '', '');
    });
  }

  const openModalHandler = () => {
    if (errorMsg) {
      errorMsg.textContent = '';
      errorMsg.classList.add('hidden');
    }
    if (modal) modal.showModal();
  };

  if (openBtn) openBtn.addEventListener('click', openModalHandler);
  if (bannerOpenBtn) bannerOpenBtn.addEventListener('click', openModalHandler);
  if (bannerViewBtn) bannerViewBtn.addEventListener('click', openModalHandler);

  const closeModal = () => {
    if (modal) modal.close();
  };

  if (closeBtn) closeBtn.addEventListener('click', closeModal);
  if (cancelBtn) cancelBtn.addEventListener('click', closeModal);

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!saveBtn) return;

      const formData = new FormData(form);
      const full_name = String(formData.get('full_name') || '').trim();
      const phone_number = String(formData.get('phone_number') || '').trim();
      const dial_code = String(formData.get('dial_code') || '+62').trim();
      const birth_date = String(formData.get('birth_date') || '').trim();
      const gender = String(formData.get('gender') || '').trim();
      const country = String(formData.get('country') || 'Indonesia').trim();
      const selectedCountryOpt = countrySelect?.options[countrySelect.selectedIndex];
      const country_code = selectedCountryOpt?.dataset.code || 'ID';
      const province = String(formData.get('province') || '').trim();
      const city = String(formData.get('city') || '').trim();
      const occupation = String(formData.get('occupation') || '').trim();
      const institution_name = String(formData.get('institution_name') || '').trim();
      const referral_source = String(formData.get('referral_source') || '').trim();
      const bio = String(formData.get('bio') || '').trim();

      saveBtn.disabled = true;
      saveBtn.textContent = 'Menyimpan Profil...';
      if (errorMsg) {
        errorMsg.textContent = '';
        errorMsg.classList.add('hidden');
      }

      try {
        const res = await fetch('/api/user/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            full_name,
            phone_number,
            dial_code,
            birth_date,
            gender,
            country,
            country_code,
            province,
            city,
            occupation,
            institution_name,
            referral_source,
            bio,
          }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Gagal menyimpan profil');
        }

        // Perbarui tampilan di layar
        const nameEl = document.getElementById('display-user-name');
        const bioEl = document.getElementById('display-user-bio');
        if (nameEl) nameEl.textContent = full_name;
        if (bioEl) bioEl.textContent = bio || 'Belum ada bio. Klik tombol edit profil untuk menambahkan bio Anda.';

        window.dispatchEvent(
          new CustomEvent('phinisi-toast', {
            detail: { message: 'Profil resmi dan data sertifikasi berhasil disimpan', type: 'success' },
          })
        );

        closeModal();
        setTimeout(() => {
          window.location.reload();
        }, 600);
      } catch (err: any) {
        if (errorMsg) {
          errorMsg.textContent = err.message || 'Terjadi kesalahan sistem';
          errorMsg.classList.remove('hidden');
        }
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Simpan Profil Resmi';
      }
    });
  }
</script>

