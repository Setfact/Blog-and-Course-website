    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.45rem 0.85rem;
    border-radius: 0.65rem;
    cursor: pointer;
    transition: all 150ms ease;
  }
  .btn-guide-modal:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.4);
    transform: translateY(-1px);
  }
  .icon-btn-sm {
    font-size: 1.1rem;
    color: #fbbf24;
  }
  .active-perks-box {
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .perks-header-line {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .icon-perk-title {
    font-size: 1.1rem;
    color: #38bdf8;
  }
  .perks-heading {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: 0.02em;
  }
  .perks-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.5rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .perks-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.8rem;
    color: #cbd5e1;
    line-height: 1.4;
  }
  .icon-perk-check {
    font-size: 1rem;
    color: #4ade80;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }
  .perks-downloads-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    flex-wrap: wrap;
  }
  .downloads-label {
    font-size: 0.76rem;
    font-weight: 600;
    color: #94a3b8;
  }
  .downloads-badges-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .asset-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.28);
    color: #7dd3fc;
    font-size: 0.74rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .icon-asset {
    font-size: 0.95rem;
  }

  /* Stats Grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .stat-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: #ffffff;
  }
  .stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 1rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .stat-xp { background: var(--color-gold-soft); color: #b45309; }
  .stat-streak { background: #ffedd5; color: #c2410c; }
  .stat-lessons { background: #e0e7ff; color: #4338ca; }
  .stat-role { background: var(--color-phinisi-50); color: var(--color-phinisi-700); }
  .stat-content {
    display: flex;
    flex-direction: column;
  }
  .stat-label {
    font-size: 0.78rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  .stat-value {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
  }
  .text-capitalize {
    text-transform: capitalize;
  }

  /* Badges Section */
  .badges-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .badge-count-pill {
    background: var(--color-section);
    border: 1px solid var(--color-line);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .badges-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }
  .badge-card {
    display: flex;
    align-items: flex-start;
    gap: 0.95rem;
    padding: 1.25rem;
    border-radius: 1.15rem;
    border: 1px solid var(--color-line);
    background: #ffffff;
    transition: all 180ms ease;
  }
  .badge-card.badge-unlocked {
    border-color: #fde68a;
    background: #fffdf5;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.08);
  }
  .badge-card.badge-locked {
    opacity: 0.65;
    background: #f8fafc;
  }
  .badge-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 0.85rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .badge-unlocked .badge-icon-box {
    background: #fef3c7;
    color: #b45309;
  }
  .badge-locked .badge-icon-box {
    background: #e2e8f0;
    color: #64748b;
  }
  .badge-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .badge-title {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-navy);
  }
  .badge-desc {
    font-size: 0.74rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.4;
  }
  .badge-status-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-top: 0.35rem;
    letter-spacing: 0.03em;
  }
  .badge-unlocked .badge-status-tag { color: #15803d; }
  .badge-locked .badge-status-tag { color: #94a3b8; }

  /* Learning Section */
  .learning-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .section-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }
  .section-desc {
    margin: 0.25rem 0 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
  }
  .courses-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .course-mini-card {
    display: flex;
    flex-direction: column;
    padding: 1.35rem;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    background: #ffffff;
    gap: 0.75rem;
  }
  .course-mini-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .course-category-tag {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--color-phinisi-700);
    background: var(--color-phinisi-50);
    padding: 0.2rem 0.5rem;
    border-radius: 0.4rem;
  }
  .course-level-tag {
    font-size: 0.72rem;
    color: var(--color-muted);
    text-transform: capitalize;
  }
  .course-status-pill.planned {
    font-size: 0.68rem;
    font-weight: 750;
    color: #b45309;
    background: #fef3c7;
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .course-mini-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }
  .course-mini-desc {
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Progress Bar Block */
  .course-progress-block {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    background: var(--color-section);
    padding: 0.75rem 0.95rem;
    border-radius: 0.85rem;
    border: 1px solid var(--color-line);
  }
  .course-prog-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.76rem;
  }
  .prog-label {
    color: var(--color-muted);
    font-weight: 600;
  }
  .prog-val {
    color: var(--color-navy);
    font-weight: 700;
  }
  .course-prog-track {
    width: 100%;
    height: 8px;
    background: #dce7f5;
    border-radius: 999px;
    overflow: hidden;
  }
  .course-prog-fill {
    height: 100%;
    background: var(--color-primary);
    border-radius: 999px;
    transition: width 300ms ease;
  }

  .course-mini-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .lesson-count-badge {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    font-size: 0.78rem;
  }
  .icon-xs {
    font-size: 0.95rem;
  }

  /* Modal Edit Profil */
  .edit-modal {
    border: none;
    border-radius: 1.5rem;
    padding: 0;
    background: transparent;
    max-width: 680px;
    width: 94%;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
  }
  .edit-modal::backdrop {
    background: rgba(9, 26, 58, 0.6);
    backdrop-filter: blur(4px);
  }
  .modal-card {
    background: #ffffff;
    border-radius: 1.5rem;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-height: 88vh;
    overflow-y: auto;
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }
  .modal-header-titles {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .modal-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }
  .modal-subtitle {
    margin: 0;
    font-size: 0.82rem;
    color: var(--color-muted);
    line-height: 1.4;
  }
  .modal-close-btn {
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    border-radius: 0.5rem;
    padding: 0.25rem;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .modal-close-btn:hover {
    background: var(--color-section);
    color: var(--color-navy);
  }
  .cert-modal-callout {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 0.85rem;
    color: #1e40af;
  }
  .cert-modal-callout .icon-callout {
    font-size: 1.35rem;
    color: #2563eb;
    margin-top: 0.1rem;
    flex-shrink: 0;
  }
  .cert-modal-callout strong {
    display: block;
    font-size: 0.85rem;
    font-family: var(--font-heading);
    font-weight: 800;
    margin-bottom: 0.15rem;
  }
  .cert-modal-callout p {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: #1e3a8a;
  }
  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }
  .form-section-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--color-navy);
  }
  .form-section-title .material-symbols-outlined {
    font-size: 1.15rem;
    color: var(--color-primary);
  }
  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .full-width {
    width: 100%;
  }
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .field-label {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .phone-input-group {
    display: flex;
    gap: 0.4rem;
  }
  .dial-code-select {
    width: 120px;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    padding: 0.65rem 0.5rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    background: #f8fafc;
    color: var(--color-navy);
    font-weight: 600;
  }
  .phone-text-input {
    flex: 1;
  }
  .text-input, .textarea-input, .select-input {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    padding: 0.65rem 0.85rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    background: #ffffff;
    box-sizing: border-box;
    transition: border-color 150ms ease;
  }
  .text-input:focus, .textarea-input:focus, .select-input:focus, .dial-code-select:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .textarea-input {
    resize: vertical;
  }
  .field-hint {
    font-size: 0.72rem;
    color: var(--color-muted);
  }
  .modal-error {
    background: #fee2e2;
    border: 1px solid #fecaca;
    color: #991b1b;
    padding: 0.65rem 0.85rem;
    border-radius: 0.75rem;
    font-size: 0.82rem;
  }
  .modal-error.hidden {
    display: none;
  }
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .cancel-modal-btn {
    padding: 0.65rem 1.15rem;
    border: 1px solid var(--color-line);
    background: #ffffff;
    color: var(--color-ink);
    border-radius: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
  }
  .cancel-modal-btn:hover {
    background: var(--color-section);
  }
  .save-modal-btn {
    padding: 0.65rem 1.25rem;
    border: none;
    background: var(--color-primary);
    color: #ffffff;
    border-radius: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .save-modal-btn:hover {
    background: #0e4ca9;
  }
  .save-modal-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  @media (max-width: 640px) {
    .form-grid-2 {
      grid-template-columns: 1fr;
    }
    .cert-profile-notice {
      flex-direction: column;
      align-items: flex-start;
    }
    .btn-complete-profile, .btn-view-profile {
      width: 100%;
      justify-content: center;
    }
  }

  /* XP Ledger Section */
  .ledger-section {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .ledger-count-pill {
    background: var(--color-section);
    border: 1px solid var(--color-line);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .ledger-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ledger-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .ledger-item:hover {
    transform: translateX(3px);
    box-shadow: 0 4px 12px rgba(8, 26, 58, 0.04);
  }
  .ledger-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 0.65rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
    flex-shrink: 0;
  }
  .source-course_completion {
    background: #fef3c7;
    color: #b45309;
    border: 1px solid #fde68a;
  }
  .source-quiz_pass {
    background: #e0f2fe;
    color: #0369a1;
    border: 1px solid #bae6fd;
  }
  .source-community_solution {
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
  }
  .source-lesson_complete {
    background: #f1f5f9;
    color: #334155;
    border: 1px solid #e2e8f0;
  }
  .icon-ledger {
    font-size: 1.1rem;
  }
  .ledger-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    flex: 1;
  }
  .ledger-title {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .ledger-time {
    font-size: 0.74rem;
    color: var(--color-muted);
  }
  .ledger-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    background: #ffffff;
    border: 1px dashed var(--color-line);
    border-radius: 1.25rem;
    color: var(--color-muted);
    text-align: center;
    gap: 0.5rem;
  }
  .icon-ledger-empty {
    font-size: 2.2rem;
    color: var(--color-muted);
    opacity: 0.7;
  }
  .ledger-empty p {
    margin: 0;
    font-size: 0.85rem;
    max-width: 480px;
  }

  /* Ranks Guide Modal */
  .guide-modal {
    border: none;
    border-radius: 1.5rem;
    padding: 0;
    background: transparent;
    max-width: 680px;
    width: 92%;
    box-shadow: 0 25px 50px -12px rgba(8, 26, 58, 0.35);
  }
  .guide-modal::backdrop {
    background: rgba(9, 26, 58, 0.65);
    backdrop-filter: blur(5px);
  }
  .guide-modal-card {
    background: #ffffff;
    border-radius: 1.5rem;
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-height: 85vh;
    overflow-y: auto;
  }
  .guide-title-box {
    display: flex;
    flex-direction: column;
  }
  .guide-kicker {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    text-transform: uppercase;
  }
  .guide-tiers-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .tier-card {
    border: 1px solid var(--color-line);
    border-radius: 1.15rem;
    padding: 1.15rem 1.25rem;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: all 150ms ease;
    position: relative;
  }
  .tier-card.is-current-tier {
    border: 2px solid var(--tier-color, var(--color-primary));
    background: #f8fafc;
    box-shadow: 0 4px 16px rgba(8, 26, 58, 0.06);
  }
  .tier-card-header {
    display: flex;
    align-items: center;
    gap: 0.95rem;
  }
  .tier-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 0.9rem;
    display: grid;
    place-items: center;
    color: #ffffff;
    flex-shrink: 0;
  }
  .tier-icon-wrap .material-symbols-outlined {
    font-size: 1.4rem;
  }
  .tier-title-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
  }
  .tier-name-line {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .tier-name {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-navy);
  }
  .current-tier-tag {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: var(--color-primary);
    color: #ffffff;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
  .tier-xp-range {
    font-size: 0.76rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  .tier-perks-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0.4rem 0.85rem;
    list-style: none;
    padding: 0;
    margin: 0;
