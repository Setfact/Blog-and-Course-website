  .history-item-time {
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  .history-xp-badge {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 800;
    color: #10b981;
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    white-space: nowrap;
