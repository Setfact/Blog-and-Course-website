  .history-icon-box.source-lesson_complete {
    background: #eff6ff;
    color: var(--color-primary);
  }

  .history-icon-box.source-quiz_pass {
    background: #fef3c7;
    color: #d97706;
  }

  .history-icon-box.source-community_solution {
    background: #ecfdf5;
    color: #059669;
  }

  .history-icon-box.source-course_completion {
    background: #f3e8ff;
    color: #7c3aed;
  }

  .history-content-box {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .history-item-title {
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
