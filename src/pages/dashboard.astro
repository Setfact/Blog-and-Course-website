  /* Guide Modal Dialog */
  .guide-modal {
    border: none;
    border-radius: 1.5rem;
    padding: 0;
    max-width: 820px;
    width: 92vw;
    box-shadow: 0 25px 50px -12px rgba(8, 26, 58, 0.25);
    background: transparent;
  }

  .guide-modal::backdrop {
    background: rgba(8, 26, 58, 0.6);
    backdrop-filter: blur(4px);
  }

  .guide-modal-card {
