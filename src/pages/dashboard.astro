---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { loadCourses } from '../data/learning';
import { createSupabaseServerClient } from '../lib/supabase';
import { getRankTier, BADGE_DEFINITIONS, TIERS } from '../lib/rank';
import { getXpHistory } from '../lib/xp';
import { COUNTRIES, INDONESIA_PROVINCES, OCCUPATIONS, REFERRAL_SOURCES, GENDERS } from '../data/geo-regions';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/dashboard');
}

const errorParam = Astro.url.searchParams.get('error');
let errorNotice = '';
if (errorParam === 'unauthorized_keystatic') {
  errorNotice = 'Halaman Keystatic CMS dikhususkan untuk Administrator (Superadmin). Anda telah dialihkan ke Dasbor Siswa.';
} else if (errorParam === 'unauthorized_admin') {
  errorNotice = 'Halaman Administrator hanya dapat diakses oleh akun pengelola yang berwenang.';
}

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

// Ambil progres belajar dan pengumuman dari database
const completedLessonsSet = new Set<string>();
let activeAnnouncement = null;

if (supabase) {
  try {
    const [progressRes, announceRes] = await Promise.all([
      supabase.from('user_lesson_progress').select('course_slug, lesson_id').eq('user_id', user.id),
      supabase.from('platform_announcements').select('*').eq('is_active', true).order('created_at', { ascending: false }).limit(1).maybeSingle(),
    ]);

    if (progressRes.data) {
      progressRes.data.forEach((r: { course_slug: string; lesson_id: string }) => completedLessonsSet.add(`${r.course_slug}/${r.lesson_id}`));
    }
    if (announceRes.data) {
      activeAnnouncement = announceRes.data;
    }
  } catch (err) {
    console.error('Error fetching dashboard progress:', err);
  }
}

const [courses, xpLedger] = await Promise.all([
  loadCourses(),
  getXpHistory(supabase, user.id, 6),
]);
const rankTier = getRankTier(user.xp);

// Hitung lencana yang terbuka
const earnedBadges = new Set<string>();
if (completedLessonsSet.size >= 1) earnedBadges.add('langkah-pertama');
const securityCount = Array.from(completedLessonsSet).filter((k) => k.startsWith('security-fundamentals/')).length;
if (securityCount >= 1) earnedBadges.add('security-starter');
if (securityCount >= 5) earnedBadges.add('security-guardian');
const ccnaCount = Array.from(completedLessonsSet).filter((k) => k.startsWith('ccna-fundamentals/')).length;
if (ccnaCount >= 1) earnedBadges.add('ccna-explorer');
if (user.streak >= 3) earnedBadges.add('streak-3');
if (user.xp >= 900) earnedBadges.add('fleet-commander-badge');
if (xpLedger.some((entry) => entry.source === 'community_solution')) earnedBadges.add('community-solver');
if (xpLedger.some((entry) => entry.source === 'quiz_pass')) earnedBadges.add('quiz-master');
const anyCourseFinished = courses.some((c) => {
  const count = Array.from(completedLessonsSet).filter((k) => k.startsWith(`${c.slug}/`)).length;
  return count >= (c.lessonCount || 1);
});
if (anyCourseFinished) earnedBadges.add('course-finisher');

const isProfileComplete = Boolean(
  user.is_profile_complete ||
  (user.full_name && user.country && (user.province || user.city) && user.institution_name)
);
---

<BaseLayout title="Dashboard Siswa" description="Pantau progres belajar jaringan, koleksi XP, dan lencana pencapaian Anda.">
  <div class="dashboard-container page-shell">
    
    <!-- Platform Announcement Banner If Active -->
    {activeAnnouncement && (
      <aside class:list={['announcement-banner', `announce-${activeAnnouncement.type}`]}>
        <div class="announce-icon-wrap">
          <span class="material-symbols-outlined">campaign</span>
        </div>
        <div class="announce-content">
          <strong>Pengumuman Platform</strong>
          <p>{activeAnnouncement.message}</p>
        </div>
      </aside>
    )}

    <!-- Notice Banner If Redirected with Error -->
    {errorNotice && (
      <aside class="dashboard-notice-banner" role="alert">
        <div class="notice-icon-wrap">
          <span class="material-symbols-outlined">lock</span>
        </div>
        <div class="notice-content">
          <strong>Akses Dibatasi</strong>
          <p>{errorNotice}</p>
        </div>
      </aside>
    )}

    <!-- Notice Banner for Profile Completeness & Certification Prerequisite -->
    {!isProfileComplete ? (
      <aside class="cert-profile-notice pending" role="status">
        <div class="cert-notice-icon-wrap">
          <span class="material-symbols-outlined">badge</span>
        </div>
        <div class="cert-notice-content">
          <div class="cert-notice-title-row">
            <strong>Profil Resmi Belum Lengkap</strong>
            <span class="cert-status-tag pending">Prasyarat Klaim Sertifikat</span>
          </div>
          <p>Lengkapi nama resmi, nomor kontak, dan data asal instansi Anda agar nama tercetak dengan benar saat Anda mengklaim E-Sertifikat kelulusan kursus dan capaian lab.</p>
        </div>
        <button type="button" class="btn-complete-profile" id="banner-open-edit-btn">
          <span>Lengkapi Profil</span>
          <span class="material-symbols-outlined icon-inline">arrow_forward</span>
        </button>
      </aside>
    ) : (
      <aside class="cert-profile-notice verified" role="status">
        <div class="cert-notice-icon-wrap">
          <span class="material-symbols-outlined">verified</span>
        </div>
        <div class="cert-notice-content">
          <div class="cert-notice-title-row">
            <strong>Profil Terverifikasi untuk Sertifikat</strong>
            <span class="cert-status-tag active">Siap Terbit E-Sertifikat</span>
          </div>
          <p>Nama resmi terdaftar: <strong>{user.full_name}</strong> {user.institution_name ? `(${user.institution_name})` : ''} &middot; Domisili: {user.city ? `${user.city}, ` : ''}{user.country || 'Indonesia'}.</p>
        </div>
        <button type="button" class="btn-view-profile" id="banner-view-edit-btn">
          <span>Ubah Data</span>
        </button>
      </aside>
    )}

    <!-- User Profile Header -->
    <header class="profile-hero">
      <div class="profile-info">
        <div class="avatar-wrap">
          {user.avatar_url ? (
            <img src={user.avatar_url} alt={user.full_name} class="avatar-img" width="84" height="84" />
          ) : (
            <div class="avatar-fallback">{user.full_name.slice(0, 2).toUpperCase()}</div>
          )}
        </div>
        <div class="user-meta">
          <div class="user-name-row">
            <h1 class="user-name" id="display-user-name">{user.full_name}</h1>
            {user.role === 'admin' ? (
              <span class="role-badge role-admin">Administrator</span>
            ) : (
              <span class="role-badge role-student">Siswa</span>
            )}
            <span class="tier-pill">
              <span class="material-symbols-outlined tier-pill-icon">{rankTier.icon}</span>
              <span>{rankTier.name}</span>
            </span>
          </div>
          <p class="user-email">{user.email}</p>
          <p class="user-bio" id="display-user-bio">
            {user.bio || 'Belum ada bio. Klik tombol edit profil untuk menambahkan bio Anda.'}
          </p>
        </div>
      </div>

      <div class="profile-actions">
        <button type="button" class="edit-profile-trigger" id="open-edit-modal-btn">
          <span class="material-symbols-outlined icon-inline">edit</span>
          <span>Edit Profil</span>
        </button>
        {user.role === 'admin' && (
          <Button href="/admin" variant="primary" size="sm" class="admin-cta-btn">
            <span class="material-symbols-outlined icon-inline">admin_panel_settings</span>
            <span>Buka Panel Admin</span>
          </Button>
        )}
        <Button href="/community" variant="secondary" size="sm">
          <span class="material-symbols-outlined icon-inline">forum</span>
          <span>Komunitas Siswa</span>
        </Button>
        <a href="/api/auth/signout" class="signout-link">Keluar</a>
      </div>
    </header>

    <!-- Nautical Rank Tier Card -->
    <section class="rank-card" aria-label="Tingkatan Pangkat Belajar">
      <div class="rank-card-header">
        <div class="rank-title-group">
          <div class="rank-icon-wrap" style={`background: ${rankTier.badgeColor};`}>
            <span class="material-symbols-outlined">{rankTier.icon}</span>
          </div>
          <div class="rank-title-box">
            <span class="rank-kicker">Tingkatan Pangkat Maritim</span>
            <h2 class="rank-name">{rankTier.name}</h2>
            <span class="rank-subtitle">{rankTier.title}</span>
          </div>
        </div>
        <div class="rank-header-right">
          <button type="button" class="btn-guide-modal" id="open-ranks-modal-btn" title="Buka panduan tingkatan pangkat dan hak istimewa siswa">
            <span class="material-symbols-outlined icon-btn-sm">military_tech</span>
            <span>Panduan Pangkat & Keuntungan</span>
          </button>
          <div class="rank-xp-badge">
            <strong>{user.xp}</strong>
            <span>Total XP</span>
          </div>
        </div>
      </div>

      <div class="rank-progress-wrap">
        <div class="progress-bar-bg">
          <div class="progress-bar-fill" style={`width: ${rankTier.progressPercent}%; background: ${rankTier.badgeColor};`}></div>
        </div>
        <div class="progress-labels">
          <span>{rankTier.minXp} XP ({rankTier.name})</span>
          {rankTier.nextTierName ? (
            <span>{rankTier.remainingXp} XP lagi menuju {rankTier.nextTierName} ({rankTier.maxXp} XP)</span>
          ) : (
            <span>Pangkat Tertinggi Tercapai!</span>
          )}
        </div>
      </div>

      <!-- Active Perks for Current Tier -->
      <div class="active-perks-box">
        <div class="perks-header-line">
          <span class="material-symbols-outlined icon-perk-title">verified</span>
          <strong class="perks-heading">Keuntungan Aktif Pangkat {rankTier.name}:</strong>
        </div>
        <ul class="perks-list">
          {rankTier.perks.map((perk) => (
            <li>
              <span class="material-symbols-outlined icon-perk-check">check_circle</span>
              <span>{perk}</span>
            </li>
          ))}
        </ul>

        {rankTier.downloadableAssets && rankTier.downloadableAssets.length > 0 && (
          <div class="perks-downloads-row">
            <span class="downloads-label">Aset Lab Terbuka:</span>
            {rankTier.downloadableAssets.map((asset) => (
              <span class="asset-pill" title={asset.description}>
                <span class="material-symbols-outlined icon-asset">download</span>
                <span>{asset.name} ({asset.type})</span>
              </span>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Stats Grid -->
    <section class="stats-grid" aria-label="Statistik Belajar">
      <div class="stat-card">
        <div class="stat-icon stat-xp">
          <span class="material-symbols-outlined">bolt</span>
        </div>
        <div class="stat-content">
          <span class="stat-label">Total Pengalaman</span>
          <strong class="stat-value">{user.xp} XP</strong>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon stat-streak">
          <span class="material-symbols-outlined">local_fire_department</span>
        </div>
        <div class="stat-content">
          <span class="stat-label">Hari Streak Belajar</span>
          <strong class="stat-value">{user.streak} Hari</strong>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon stat-lessons">
          <span class="material-symbols-outlined">task_alt</span>
        </div>
        <div class="stat-content">
          <span class="stat-label">Materi Diselesaikan</span>
          <strong class="stat-value">{completedLessonsSet.size} Modul</strong>
        </div>
      </div>

      <div class="stat-card">
        <div class="stat-icon stat-role">
          <span class="material-symbols-outlined">verified_user</span>
        </div>
        <div class="stat-content">
          <span class="stat-label">Status Akun</span>
          <strong class="stat-value text-capitalize">{user.status}</strong>
        </div>
      </div>
    </section>

    <!-- XP Activity Ledger Section -->
    <section class="ledger-section" aria-label="Riwayat Perolehan XP">
      <div class="section-header">
        <div>
          <h2 class="section-title">Buku Besar Riwayat XP (Activity Ledger)</h2>
          <p class="section-desc">Catatan perolehan poin pengalaman dari materi kurikulum, evaluasi kuis, dan kontribusi komunitas.</p>
        </div>
        <span class="ledger-count-pill">{xpLedger.length} Mutasi Terakhir</span>
      </div>

      <div class="ledger-list">
        {xpLedger.map((entry) => (
          <div class="ledger-item">
            <div class:list={['ledger-badge', `source-${entry.source}`]}>
              <span class="material-symbols-outlined icon-ledger">
                {entry.source === 'community_solution'
                  ? 'verified'
                  : entry.source === 'course_completion'
                    ? 'school'
                    : entry.source === 'quiz_pass'
                      ? 'psychology'
                      : 'task_alt'}
              </span>
              <span>+{entry.amount} XP</span>
            </div>
            <div class="ledger-info">
              <strong class="ledger-title">{entry.title}</strong>
              <span class="ledger-time">
                {new Date(entry.created_at).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                })}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Badges Showcase Section -->
    <section class="badges-section" aria-label="Lencana Pencapaian">
      <div class="section-header">
        <div>
          <h2 class="section-title">Lencana Pencapaian Belajar</h2>
          <p class="section-desc">Koleksi lencana yang diperoleh dari menyelesaikan materi dan tantangan lab teknis.</p>
        </div>
        <span class="badge-count-pill">{earnedBadges.size} dari {BADGE_DEFINITIONS.length} Terbuka</span>
      </div>

      <div class="badges-grid">
        {BADGE_DEFINITIONS.map((badge) => {
          const isUnlocked = earnedBadges.has(badge.id);
          return (
            <div class:list={['badge-card', isUnlocked ? 'badge-unlocked' : 'badge-locked']}>
              <div class="badge-icon-box">
                <span class="material-symbols-outlined">
                  {isUnlocked ? badge.icon : 'lock'}
                </span>
              </div>
              <div class="badge-info">
                <strong class="badge-title">{badge.name}</strong>
                <p class="badge-desc">{badge.description}</p>
                <span class="badge-status-tag">
                  {isUnlocked ? 'Tercapai' : 'Terkunci'}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Courses Continue Section with Real Progress -->
    <section class="learning-section">
      <div class="section-header">
        <div>
          <h2 class="section-title">Kurikulum Pembelajaran Anda</h2>
          <p class="section-desc">Pilih modul materi dan selesaikan tantangan untuk menaikkan peringkat maritim Anda.</p>
        </div>
        <Button href="/courses" variant="secondary" size="sm">Lihat Katalog Lengkap</Button>
      </div>

      <div class="courses-preview-grid">
        {courses.map((c) => {
          const totalInCourse = c.lessonCount || 1;
          const userCompletedInCourse = Array.from(completedLessonsSet).filter((k) => k.startsWith(`${c.slug}/`)).length;
          const coursePercent = Math.min(100, Math.round((userCompletedInCourse / totalInCourse) * 100));

          return (
            <div class="course-mini-card">
              <div class="course-mini-header">
                <span class="course-category-tag">{c.category.toUpperCase()}</span>
                <span class="course-level-tag">{c.level}</span>
                {c.status === 'planned' && (
                  <span class="course-status-pill planned">Segera Hadir</span>
                )}
              </div>
              <h3 class="course-mini-title">{c.title}</h3>
              <p class="course-mini-desc">{c.description.id}</p>
              
              <!-- Real Course Progress Bar -->
              <div class="course-progress-block">
                <div class="course-prog-meta">
                  <span class="prog-label">Progres Kursus</span>
                  <strong class="prog-val">{userCompletedInCourse}/{totalInCourse} materi ({coursePercent}%)</strong>
                </div>
                <div class="course-prog-track">
                  <div class="course-prog-fill" style={`width: ${coursePercent}%;`}></div>
                </div>
              </div>

              <div class="course-mini-footer">
                <span class="lesson-count-badge">
                  <span class="material-symbols-outlined icon-xs">menu_book</span>
                  <span>{c.lessonCount} materi</span>
                </span>
                <Button href={`/courses/${c.slug}`} size="sm" variant={c.status === 'planned' ? 'secondary' : 'primary'}>
                  {c.status === 'planned' ? 'Detail Kursus' : coursePercent > 0 ? 'Lanjutkan Belajar' : 'Mulai Kursus'}
                </Button>
              </div>
            </div>
          );
        })}
      </div>
    </section>

  </div>

  <!-- Ranks & Perks Guide Modal Dialog -->
  <dialog id="ranks-guide-modal" class="guide-modal">
    <div class="guide-modal-card">
      <div class="modal-header">
        <div class="guide-title-box">
          <span class="guide-kicker">SISTEM PANGKAT & HAK ISTIMEWA</span>
          <h3 class="modal-title">Jenjang Pangkat Maritim & Keuntungan Siswa</h3>
        </div>
        <button type="button" class="modal-close-btn" id="close-ranks-modal-btn" aria-label="Tutup panduan">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <div class="guide-tiers-list">
        {TIERS.map((t) => {
          const isCurrent = rankTier.id === t.id;
          return (
            <div class:list={['tier-card', { 'is-current-tier': isCurrent }]} style={`--tier-color: ${t.badgeColor};`}>
              <div class="tier-card-header">
                <div class="tier-icon-wrap" style={`background-color: ${t.badgeColor};`}>
                  <span class="material-symbols-outlined">{t.icon}</span>
                </div>
                <div class="tier-title-wrap">
                  <div class="tier-name-line">
                    <strong class="tier-name">{t.name}</strong>
                    {isCurrent && <span class="current-tier-tag">Pangkat Anda Saat Ini</span>}
                  </div>
                  <span class="tier-xp-range">{t.minXp} - {t.maxXp === Infinity ? '3000+' : t.maxXp} XP · {t.title}</span>
                </div>
              </div>
              <ul class="tier-perks-list">
                {t.perks.map((p) => (
                  <li>
                    <span class="material-symbols-outlined icon-tier-check">done</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </div>
    </div>
  </dialog>

  <!-- Hidden JSON dataset 38 Provinsi Indonesia -->
  <script id="geo-provinces-data" type="application/json" is:inline set:html={JSON.stringify(INDONESIA_PROVINCES)} />

  <!-- Edit Profile Modal Dialog (Global-Ready & Certification Data) -->
  <dialog id="edit-profile-modal" class="edit-modal">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-header-titles">
          <h3 class="modal-title">Pengaturan Profil Siswa</h3>
          <p class="modal-subtitle">Lengkapi identitas resmi dan domisili Anda untuk verifikasi penerbitan E-Sertifikat.</p>
        </div>
        <button type="button" class="modal-close-btn" id="close-edit-modal-btn" aria-label="Tutup modal">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>

      <!-- Notice: Nama Resmi untuk Sertifikat -->
      <div class="cert-modal-callout">
        <span class="material-symbols-outlined icon-callout">verified_user</span>
        <div>
          <strong>Identitas Resmi E-Sertifikat</strong>
          <p>Nama lengkap yang Anda simpan akan dicetak secara permanen pada E-Sertifikat kelulusan kursus dan capaian lab Phinisi Learn. Pastikan sesuai dengan identitas resmi (KTP/Ijazah).</p>
        </div>
      </div>

      <form id="edit-profile-form" class="modal-form">
        <!-- 1. Identitas Resmi -->
        <div class="form-section-title">
          <span class="material-symbols-outlined">badge</span>
          <span>1. Identitas Pribadi & Kontak</span>
        </div>

        <div class="form-field full-width">
          <label for="edit-fullname" class="field-label">Nama Lengkap Resmi *</label>
          <input
            type="text"
            id="edit-fullname"
            name="full_name"
            value={user.full_name}
            required
            maxlength="80"
            placeholder="Contoh: Calvin Umboh"
            class="text-input"
          />
          <small class="field-hint">Nama ini akan dicetak pada seluruh sertifikat yang Anda raih.</small>
        </div>

        <div class="form-grid-2">
          <div class="form-field">
            <label for="edit-phone" class="field-label">Nomor Handphone / WhatsApp</label>
            <div class="phone-input-group">
              <select id="edit-dial-code" name="dial_code" class="dial-code-select">
                {COUNTRIES.map((c) => (
                  <option value={c.dialCode} selected={c.dialCode === (user.dial_code || '+62')}>
                    {c.code} ({c.dialCode})
                  </option>
                ))}
              </select>
              <input
                type="tel"
                id="edit-phone"
                name="phone_number"
                value={user.phone_number || ''}
                placeholder="81234567890"
                class="text-input phone-text-input"
                maxlength="20"
              />
            </div>
            <small class="field-hint">Format tanpa awalan 0, contoh: 81234567890</small>
          </div>

          <div class="form-field">
            <label for="edit-birthdate" class="field-label">Tanggal Lahir</label>
            <input
              type="date"
              id="edit-birthdate"
              name="birth_date"
              value={user.birth_date || ''}
              class="text-input"
            />
          </div>
        </div>

        <div class="form-grid-2">
          <div class="form-field">
            <label for="edit-gender" class="field-label">Gender</label>
            <select id="edit-gender" name="gender" class="select-input">
              <option value="">-- Pilih Gender --</option>
              {GENDERS.map((g) => (
                <option value={g.id} selected={g.id === user.gender}>
                  {g.label}
                </option>
              ))}
            </select>
          </div>

          <div class="form-field">
            <label for="edit-country" class="field-label">Negara / Country *</label>
            <select id="edit-country" name="country" class="select-input" required>
              {COUNTRIES.map((c) => (
                <option
                  value={c.name}
                  data-code={c.code}
                  data-dial={c.dialCode}
                  selected={c.name === (user.country || 'Indonesia')}
                >
                  {c.name} ({c.dialCode})
                </option>
              ))}
            </select>
          </div>
        </div>

        <!-- 2. Wilayah Domisili (Dinamis: Indonesia vs Luar Negeri) -->
        <div class="form-section-title">
          <span class="material-symbols-outlined">map</span>
          <span>2. Wilayah Asal & Domisili</span>
        </div>

        <div class="form-grid-2">
          <div
            id="province-field-container"
            class="form-field"
            data-selected-province={user.province || ''}
          >
            <!-- Diisi via JavaScript sesuai negara terpilih -->
          </div>

