    .process-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 3.25rem; }
    .process-steps::before { display: none; }
    .process-step:nth-child(odd)::before { position: absolute; z-index: 0; top: 2.55rem; left: 50%; width: 100%; height: 2px; background: linear-gradient(90deg, #22b8d6, rgba(34, 211, 238, .46)); content: ''; }
