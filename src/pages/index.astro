    .home-section { padding-block: 4.5rem; }
    .hero-adventure { height: auto; min-height: 0; max-height: none; }
    .hero-layout { height: auto; padding-top: 3.5rem; padding-bottom: 19rem; }
    .hero-copy h1 { font-size: clamp(1.9rem, 9.8vw, 2.4rem); }
    .hero-copy h1 span { white-space: nowrap; }
    .hero-description { font-size: .96rem; }
    .hero-fields { display: grid; grid-template-columns: repeat(2, minmax(0, max-content)); }
    .hero-fields li { font-size: .72rem; }
    .network-path, .data-packet { display: none; }
    .ship-wrap { right: 50%; bottom: -1.5rem; width: min(330px, 86vw); translate: 50% 0; }
    .foreground-waves { right: -28%; bottom: -5.4rem; width: 150%; min-width: 760px; }
    .section-buoy { top: -47px; right: 1rem; width: 92px; }
    .home-heading.centered { text-align: left; }
    .home-heading h2, .industry-heading h2, .closing-content h2 { font-size: clamp(2.1rem, 9vw, 3rem); }
    .home-heading.centered > p:last-child { margin-inline: 0; }
    .heading-row { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .latest-grid { grid-template-columns: 1fr; gap: 1rem; margin-top: 2.25rem; }
    .industry-values { grid-template-columns: 1fr; }
    .industry-values li { min-height: 0; padding: 1.25rem .25rem; }
    .industry-values li:nth-child(even) { border-left: 0; }
    .industry-values li + li { border-top: 1px solid rgba(158, 226, 255, .2); }
    .paths-network { top: 2%; right: -38%; width: 150%; opacity: .075; }
    .industry-treasure { right: -58px; bottom: -52px; width: 170px; opacity: .22; }
    .closing-ship { bottom: -24%; left: -1rem; width: min(200px, 46vw); opacity: .85; }
    .closing-island { display: none; }
    .closing-treasure { display: none; }
    .closing-content { text-align: left; }
