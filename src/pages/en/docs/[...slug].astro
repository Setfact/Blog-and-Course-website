---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import Callout from '../../../components/Callout.astro';
import Tabs from '../../../components/Tabs.astro';
import TabItem from '../../../components/TabItem.astro';
import CustomImage from '../../../components/CustomImage.astro';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  const publishedDocs = allDocs.filter(doc => doc.data.draft !== true && doc.data.language === 'en');
  return publishedDocs.map(entry => {
    // Strip trailing 'index' so that e.g. 'network/index' becomes 'network'
    let slug = entry.id;
    if (slug.endsWith('/index')) {
      slug = slug.replace(/\/index$/, '');
    } else if (slug === 'index') {
      slug = undefined as any;
    }
    return {
      params: { slug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout entry={entry} headings={headings}>
  <Content components={{ Callout, Tabs, TabItem, CustomImage }} />
</DocsLayout>
