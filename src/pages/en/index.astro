---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
	<!-- Hero Section -->
	<section class="max-w-[1200px] mx-auto px-4 md:px-12 py-16 md:py-24">
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
			<!-- Left: Network Diagram Illustration -->
			<div class="order-2 lg:order-1 relative w-full md:h-[450px]">
				<img alt="Network Learning Journey" class="w-full h-full object-contain object-center rounded-lg shadow-sm" src="/hero.png">
			</div>
			<!-- Right: Content -->
			<div class="order-1 lg:order-2 flex flex-col items-start space-y-6">
				<h1 class="font-['Hanken_Grotesk'] text-[28px] md:text-[36px] font-bold leading-[1.2] md:tracking-[-0.02em] text-slate-900">
					Learn Networking & Linux<br>Without the Headache
				</h1>
				<p class="font-['Inter'] text-[16px] leading-[1.6] text-slate-600 max-w-lg">
					Level up your IT skills! Master Network Engineering, Linux Servers, and Network Automation through practical guides and real-world scenarios.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto pt-4">
					<a href="/en/courses" class="font-['JetBrains_Mono'] text-[12px] font-semibold tracking-[0.05em] uppercase bg-[#003f87] text-white px-6 py-3 rounded text-center hover:bg-blue-800 transition-colors">
						All Courses
					</a>
					<a href="/en/learning-path" class="font-['JetBrains_Mono'] text-[12px] font-semibold tracking-[0.05em] uppercase bg-[#62d6ed] text-[#001f25] px-6 py-3 rounded text-center hover:bg-[#4bcce6] transition-colors">
						Learning Paths
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Value Proposition Section -->
	<section class="max-w-[1200px] mx-auto px-4 md:px-12 py-16 text-center">
		<div class="mb-12 flex flex-col items-center">
			<h2 class="font-['Hanken_Grotesk'] text-[36px] font-bold leading-[1.2] tracking-[-0.02em] text-slate-900 mb-2">Beyond Theory. We Do Hands-On.</h2>
			<svg class="mb-4 text-[#003f87]" fill="none" height="12" viewBox="0 0 200 12" width="200" xmlns="http://www.w3.org/2000/svg">
				<path d="M2 9.5C45 -1.5 155 -1.5 198 9.5" stroke="currentColor" stroke-linecap="round" stroke-width="3"></path>
			</svg>
			<p class="font-['Inter'] text-[16px] leading-[1.6] text-slate-600 max-w-2xl">Our modules are designed to help you understand production workflows, not just memorize answers for a certification exam.</p>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-12">
			<!-- Visual & Topologi -->
			<div class="flex flex-col items-center space-y-4">
				<svg class="text-slate-600 mb-2" fill="none" height="48" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="48" xmlns="http://www.w3.org/2000/svg">
					<polyline points="16 18 22 12 16 6"></polyline>
					<polyline points="8 6 2 12 8 18"></polyline>
				</svg>
				<h3 class="font-['Hanken_Grotesk'] text-[20px] font-semibold leading-[1.4] text-slate-900">Visuals & Clear Topologies</h3>
				<p class="font-['Inter'] text-[16px] leading-[1.6] text-slate-600">Forget boring text-heavy modules. We use network topologies and animations to make complex concepts easy to digest.</p>
			</div>
			<!-- Studi Kasus Lapangan -->
			<div class="flex flex-col items-center space-y-4">
				<svg class="text-slate-600 mb-2" fill="none" height="48" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="48" xmlns="http://www.w3.org/2000/svg">
					<rect height="4" rx="1" ry="1" width="16" x="4" y="4"></rect>
					<rect height="10" rx="1" ry="1" width="16" x="4" y="10"></rect>
				</svg>
				<h3 class="font-['Hanken_Grotesk'] text-[20px] font-semibold leading-[1.4] text-slate-900">Real-World Case Studies</h3>
				<p class="font-['Inter'] text-[16px] leading-[1.6] text-slate-600">Learn from real-world scenarios. You'll learn how to config routers, deploy servers, and setup firewalls just like in a production environment.</p>
			</div>
			<!-- Learning paths -->
			<div class="flex flex-col items-center space-y-4">
				<svg class="text-slate-600 mb-2" fill="none" height="48" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="48" xmlns="http://www.w3.org/2000/svg">
					<line x1="8" x2="21" y1="6" y2="6"></line>
					<line x1="8" x2="21" y1="12" y2="12"></line>
					<line x1="8" x2="21" y1="18" y2="18"></line>
					<line x1="3" x2="3.01" y1="6" y2="6"></line>
					<line x1="3" x2="3.01" y1="12" y2="12"></line>
					<line x1="3" x2="3.01" y1="18" y2="18"></line>
				</svg>
				<h3 class="font-['Hanken_Grotesk'] text-[20px] font-semibold leading-[1.4] text-slate-900">Structured Learning Paths</h3>
				<p class="font-['Inter'] text-[16px] leading-[1.6] text-slate-600">No need to wonder where to start. We've structured our content from fundamental to expert so your learning journey stays on track.</p>
			</div>
		</div>
	</section>
</BaseLayout>
