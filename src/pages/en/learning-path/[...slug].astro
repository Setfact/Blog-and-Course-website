---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LearningPathDetail from '../../../components/LearningPathDetail.astro';
import { getCoursesForPath, loadLearningData, type Course, type LearningPath } from '../../../data/learning';

export const prerender = true;

export async function getStaticPaths() {
  const { courses, paths } = await loadLearningData();
  return paths.map((path) => ({
    params: { slug: path.slug },
    props: { path, courses: getCoursesForPath(path, courses) },
  }));
}

interface Props { path: LearningPath; courses: Course[]; }
const { path, courses } = Astro.props;
---

<BaseLayout title={path.title.en} description={path.description.en}>
  <LearningPathDetail path={path} courses={courses} language="en" />
</BaseLayout>
