---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseDetail from '../../components/CourseDetail.astro';
import { getCourseBySlug } from '../../data/learning';

const { slug } = Astro.params;
const user = Astro.locals.user;
const isAdmin = user?.role === 'admin';

const course = await getCourseBySlug(slug ?? '', { includeDrafts: isAdmin });

if (!course) {
  return Astro.redirect('/courses');
}

// Jika kursus berstatus draf dan pengunjung bukan admin, tolak akses publik
if (course.status === 'draft' && !isAdmin) {
  return Astro.redirect('/courses');
}
---

<BaseLayout title={course.title} description={course.description.id}>
  <CourseDetail course={course} language="id" />
</BaseLayout>
