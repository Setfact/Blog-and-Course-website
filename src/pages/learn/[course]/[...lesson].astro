---
import { getCollection, render } from 'astro:content';
import LearningPlayerLayout from '../../../layouts/LearningPlayerLayout.astro';
import Callout from '../../../components/Callout.astro';
import Tabs from '../../../components/Tabs.astro';
import TabItem from '../../../components/TabItem.astro';
import CustomImage from '../../../components/CustomImage.astro';
import CommandBlock from '../../../components/ui/CommandBlock.astro';
import TopologyDiagram from '../../../components/TopologyDiagram.astro';
import PracticeCTA from '../../../components/PracticeCTA.astro';
import KnowledgeCheck from '../../../components/KnowledgeCheck.astro';
import LessonQuiz from '../../../components/LessonQuiz.astro';
import CommandOrder from '../../../components/CommandOrder.astro';
import PacketTracerLab from '../../../components/PacketTracerLab.astro';
import { getCourseBySlug } from '../../../data/learning';

const { course: courseSlug, lesson: lessonParam } = Astro.params;
const user = Astro.locals.user;
const isAdmin = user?.role === 'admin';

const course = await getCourseBySlug(courseSlug ?? '', { includeDrafts: isAdmin });
if (!course) {
  return Astro.redirect('/courses');
}

// Hanya kursus yang sudah dipublikasi yang dapat diakses oleh siswa.
// Administrator tetap diizinkan untuk melihat pratinjau draf dan kursus segera hadir.
if (course.status !== 'published' && !isAdmin) {
  return Astro.redirect(`/courses/${course.slug}`);
}

const allDocs = await getCollection('lessons');
const root = allDocs.find(entry => (
  entry.data.course === course.slug
  && entry.data.language === 'id'
  && (isAdmin || entry.data.draft !== true)
  && (entry.id === entry.id.split('/')[0] || entry.id.endsWith('/index'))
));

const category = root ? root.id.split('/')[0] : course.slug;
const courseEntries = allDocs
  .filter(entry => (
    entry.data.language === 'id'
    && (isAdmin || entry.data.draft !== true)
    && (entry.data.course === course.slug || entry.id === category || entry.id.startsWith(`${category}/`))
  ))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

if (courseEntries.length === 0) {
  return Astro.redirect(`/courses/${course.slug}`);
}

let currentEntry = undefined;
if (!lessonParam) {
  currentEntry = courseEntries.find(entry => entry.id === category || entry.id === `${category}/index` || !entry.data.module) ?? courseEntries[0];
} else {
  currentEntry = courseEntries.find(entry => {
    const sub = entry.id.replace(`${category}/`, '');
    return sub === lessonParam || entry.id === lessonParam;
  });
}

if (!currentEntry) {
  return Astro.redirect(`/learn/${course.slug}`);
}

const { Content } = await render(currentEntry);
---

<LearningPlayerLayout entry={currentEntry} course={course} courseEntries={courseEntries}>
  <Content components={{ Callout, Tabs, TabItem, CustomImage, CommandBlock, TopologyDiagram, PracticeCTA, KnowledgeCheck, LessonQuiz, CommandOrder, PacketTracerLab }} />
</LearningPlayerLayout>
