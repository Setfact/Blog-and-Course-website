---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title}>
  <article class="max-w-[800px] mx-auto px-4 py-12 md:py-20">
    <!-- Post Header -->
    <div class="mb-10 text-center flex flex-col items-center">
      <span class="font-label-caps text-label-caps px-3 py-1 bg-surface-muted text-on-surface-variant border border-border-subtle rounded-full shadow-sm mb-6">{entry.data.category}</span>
      <h1 class="text-3xl md:text-5xl font-headline-lg text-on-background mb-6 leading-tight">{entry.data.title}</h1>
      <p class="text-body-lg text-on-surface-variant mb-6 max-w-2xl">{entry.data.description}</p>
      
      <!-- Metadata -->
      <div class="flex items-center gap-4 text-on-surface-variant text-sm font-code-block">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">person</span>
          <span>{entry.data.author || 'Phinisi Team'}</span>
        </div>
        <span class="px-1">•</span>
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-[18px]">calendar_today</span>
          <span>{new Date(entry.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        </div>
      </div>
    </div>

    <!-- Featured Image -->
    {entry.data.image && (
      <div class="w-full h-[400px] md:h-[500px] mb-12 rounded-xl overflow-hidden border border-border-subtle shadow-md">
        <img src={entry.data.image} alt={entry.data.title} class="w-full h-full object-cover" />
      </div>
    )}

    <!-- Content Body -->
    <!-- We use default tailwind prose styles if available, or custom styles if not -->
    <div class="prose prose-slate prose-lg max-w-none 
                prose-headings:text-on-background prose-headings:font-headline-sm 
                prose-p:text-on-surface-variant prose-p:font-body-md 
                prose-a:text-primary hover:prose-a:text-primary-container
                prose-code:text-secondary prose-code:bg-surface-muted prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
                prose-pre:bg-terminal-bg prose-pre:border prose-pre:border-border-subtle
                prose-strong:text-on-background">
      <Content />
    </div>
  </article>
</BaseLayout>
