---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashboardSidebar from '../../components/dashboard/DashboardSidebar.astro';
import { INDONESIA_PROVINCES, OCCUPATIONS, REFERRAL_SOURCES, GENDERS } from '../../data/geo-regions';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/dashboard/profil');
}

const isProfileComplete = Boolean(
  user.is_profile_complete ||
  (user.full_name && user.country && (user.province || user.city) && user.institution_name)
);
---

<BaseLayout title="Pengaturan Profil Siswa" description="Kelola data pribadi, kontak, dan identitas resmi untuk penerbitan E-Sertifikat Phinisi Learn.">
  <div class="dashboard-page-container fluid-layout">
    
    <!-- Top Breadcrumb / Navigation Hierarchy -->
    <nav class="dashboard-breadcrumb" aria-label="Breadcrumb">
      <a href="/dashboard" class="breadcrumb-link">Dasbor</a>
      <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
      <span class="breadcrumb-current">Pengaturan Akun</span>
    </nav>

    <div class="dashboard-layout">
      <!-- Sidebar Navigasi -->
      <DashboardSidebar activeTab="profile" user={user} />

      <!-- Area Konten Utama -->
      <main class="dashboard-main-content">
        <div class="settings-card">
          
          <!-- Sub-tabs Navigasi: Edit Profil & Keamanan -->
          <div class="settings-tabs-nav" role="tablist">
            <button
              type="button"
              id="tab-btn-profile"
              class="tab-nav-btn active"
              role="tab"
              aria-selected="true"
              aria-controls="tab-pane-profile"
            >
              <span class="material-symbols-outlined tab-icon">person</span>
              <span>Edit Profil</span>
            </button>
            <button
              type="button"
              id="tab-btn-security"
              class="tab-nav-btn"
              role="tab"
              aria-selected="false"
              aria-controls="tab-pane-security"
            >
              <span class="material-symbols-outlined tab-icon">shield</span>
              <span>Akun & Keamanan</span>
            </button>
          </div>

          <!-- PANE 1: EDIT PROFIL -->
          <section id="tab-pane-profile" class="tab-pane active" role="tabpanel" aria-labelledby="tab-btn-profile">
            <div class="pane-header">
              <div class="pane-title-group">
                <h1 class="pane-title">Edit Profil</h1>
                <p class="pane-subtitle">Perbarui identitas resmi Anda agar nama dan instansi tercetak dengan benar saat Anda mengklaim E-Sertifikat.</p>
              </div>
              
              <!-- Status Kelengkapan Profil -->
              <div class:list={['cert-status-pill', isProfileComplete ? 'verified' : 'pending']}>
                <span class="material-symbols-outlined status-icon">
                  {isProfileComplete ? 'verified' : 'pending_actions'}
                </span>
                <span>{isProfileComplete ? 'Profil Terverifikasi untuk Sertifikat' : 'Data Sertifikat Belum Lengkap'}</span>
              </div>
            </div>

            <!-- Formulir Edit Profil -->
            <form id="settings-profile-form" class="profile-editor-form">
              <div class="editor-grid-wrapper">
                
                <!-- Kolom Kiri: Foto Profil -->
                <div class="avatar-column">
                  <div class="avatar-box">
                    {user.avatar_url ? (
                      <img src={user.avatar_url} alt={user.full_name} class="avatar-photo-preview" id="avatar-preview-img" width="140" height="140" />
                    ) : (
                      <div class="avatar-photo-fallback" id="avatar-fallback-box">{user.full_name.slice(0, 2).toUpperCase()}</div>
                    )}
                    <button type="button" class="avatar-edit-badge" id="avatar-change-btn" title="Ganti foto profil">
                      <span class="material-symbols-outlined">photo_camera</span>
                    </button>
                  </div>

                  <!-- Input Berkas Tersembunyi -->
                  <input
                    type="file"
                    id="input-avatar-file"
                    accept="image/jpeg,image/png,image/webp"
                    class="sr-only"
                    aria-label="Pilih berkas foto profil baru"
                  />

                  <div class="avatar-action-cluster">
                    <button type="button" id="btn-trigger-upload" class="btn-avatar-action upload-action">
                      <span class="material-symbols-outlined icon-btn-xs">upload</span>
                      <span>Ganti Foto</span>
                    </button>
                    <button
                      type="button"
                      id="btn-remove-avatar"
                      class:list={['btn-avatar-action remove-action', { hidden: !user.avatar_url }]}
                      title="Hapus foto profil kustom dan gunakan inisial nama"
                    >
                      <span class="material-symbols-outlined icon-btn-xs">delete</span>
                      <span>Hapus</span>
                    </button>
                  </div>

                  <!-- Status Pengunggahan -->
                  <div id="avatar-upload-feedback" class="avatar-feedback-pill hidden"></div>

                  <span class="avatar-caption">Foto Profil Siswa</span>
                  <small class="avatar-note">Format JPG, PNG, atau WebP. Maksimal 3 MB.</small>
                </div>

                <!-- Kolom Kanan: Input Form 2 Kolom -->
                <div class="fields-column">
                  <div class="form-row-2">
                    <div class="form-group">
                      <div class="label-row">
                        <label for="input-fullname" class="form-label">Nama Lengkap Resmi <span class="required-star">*</span></label>
                        <span class="badge-cert-hint">Dicetak di Sertifikat</span>
                      </div>
                      <input
                        type="text"
                        id="input-fullname"
                        name="full_name"
                        value={user.full_name}
                        required
                        maxlength="80"
                        placeholder="Contoh: Calvin Umboh"
                        class="form-control"
                      />
                    </div>

                    <div class="form-group">
                      <label for="input-phone" class="form-label">No. Handphone / WhatsApp</label>
                      <input
                        type="tel"
                        id="input-phone"
                        name="phone_number"
                        value={user.phone_number || ''}
                        placeholder="Contoh: 081234567890"
                        class="form-control"
                        maxlength="20"
                      />
                      <small class="control-hint">Format nomor WhatsApp aktif (contoh: 081234567890 atau 6281234567890).</small>
                    </div>
                  </div>

                  <div class="form-row-2">
                    <div class="form-group">
                      <label for="input-birthdate" class="form-label">Tanggal Lahir</label>
                      <input
                        type="date"
                        id="input-birthdate"
                        name="birth_date"
                        value={user.birth_date || ''}
                        class="form-control"
                      />
                    </div>

                    <div class="form-group">
                      <label for="select-gender" class="form-label">Gender</label>
                      <select id="select-gender" name="gender" class="form-control form-select">
                        <option value="">-- Pilih Gender --</option>
                        {GENDERS.map((g) => (
                          <option value={g.id} selected={g.id === user.gender}>
                            {g.label}
                          </option>
                        ))}
                      </select>
                    </div>
                  </div>

                  <!-- Hidden Input untuk Default Indonesia -->
                  <input type="hidden" id="input-country" name="country" value="Indonesia" />
                  <input type="hidden" id="input-country-code" name="country_code" value="ID" />
                  <input type="hidden" id="input-dial-code" name="dial_code" value="+62" />

                  <div class="form-row-2">
                    <div class="form-group">
                      <label for="select-province" class="form-label">Provinsi Asal <span class="required-star">*</span></label>
                      <select id="select-province" name="province" class="form-control form-select" required>
                        <option value="">-- Pilih Provinsi --</option>
                        {INDONESIA_PROVINCES.map((p) => (
                          <option value={p.name} selected={p.name === user.province}>
                            {p.name}
                          </option>
                        ))}
                      </select>
                    </div>

                    <div class="form-group">
                      <label for="select-city" class="form-label">Kota / Kabupaten <span class="required-star">*</span></label>
                      <select id="select-city" name="city" class="form-control form-select" required data-initial-city={user.city || ''}>
                        <option value="">-- Pilih Kota / Kabupaten --</option>
                      </select>
                    </div>
                  </div>

                  <div class="form-row-2">
                    <div class="form-group">
                      <label for="select-occupation" class="form-label">Status Profesi <span class="required-star">*</span></label>
                      <select id="select-occupation" name="occupation" class="form-control form-select" required>
                        <option value="">-- Pilih Status Profesi --</option>
                        {OCCUPATIONS.map((occ) => (
                          <option value={occ.id} selected={occ.id === user.occupation}>
                            {occ.label}
                          </option>
                        ))}
                      </select>
                    </div>

                    <div class="form-group">
                      <label for="input-institution" class="form-label">Sekolah / Kampus / Kantor <span class="required-star">*</span></label>
                      <input
                        type="text"
                        id="input-institution"
                        name="institution_name"
                        value={user.institution_name || ''}
                        placeholder="Contoh: SMK TI Bulukumba, Universitas Hasanuddin, PT XYZ..."
                        class="form-control"
                        maxlength="120"
                        required
                      />
                    </div>
                  </div>

                  <div class="form-row-2">
                    <div class="form-group full-width">
                      <label for="select-referral" class="form-label">Tahu Phinisi Learn Dari Mana?</label>
                      <select id="select-referral" name="referral_source" class="form-control form-select">
                        <option value="">-- Pilih Sumber Rekomendasi --</option>
                        {REFERRAL_SOURCES.map((ref) => (
                          <option value={ref.id} selected={ref.id === user.referral_source}>
                            {ref.label}
                          </option>
                        ))}
                      </select>
                    </div>
                  </div>

                  <div class="form-group full-width">
                    <label for="input-bio" class="form-label">Bio Siswa</label>
                    <textarea
                      id="input-bio"
                      name="bio"
                      rows="3"
                      maxlength="300"
                      placeholder="Ceritakan minat belajar jaringan, sertifikasi CCNA/JNCIA yang sedang dipersiapkan, atau fokus keahlian Anda..."
                      class="form-control form-textarea"
                    >{user.bio}</textarea>
                    <small class="control-hint">Maksimal 300 karakter.</small>
                  </div>
                </div>
              </div>

              <!-- Pesan Error / Status -->
              <div id="form-error-alert" class="form-alert error-alert hidden" role="alert"></div>

              <!-- Tombol Simpan Profil -->
              <div class="form-actions-bar">
                <button type="submit" id="btn-save-profile" class="btn-save-primary">
                  <span class="material-symbols-outlined icon-btn">save</span>
                  <span>Simpan Perubahan</span>
                </button>
              </div>
            </form>
          </section>

          <!-- PANE 2: AKUN & KEAMANAN -->
          <section id="tab-pane-security" class="tab-pane" role="tabpanel" aria-labelledby="tab-btn-security" hidden>
            <div class="pane-header">
              <div class="pane-title-group">
                <h2 class="pane-title">Akun & Keamanan</h2>
                <p class="pane-subtitle">Informasi kredensial login dan perlindungan data akun belajar Anda.</p>
              </div>
            </div>

            <div class="security-info-grid">
              <div class="security-card-item">
                <div class="security-card-header">
                  <span class="material-symbols-outlined sec-icon">mail</span>
                  <div>
                    <strong class="sec-item-title">Alamat Email Terdaftar</strong>
                    <p class="sec-item-desc">Digunakan untuk akses login, konfirmasi sertifikat, dan notifikasi akun.</p>
                  </div>
                </div>
                <div class="sec-item-body">
                  <input type="email" value={user.email} readonly class="form-control readonly-control" />
                  <span class="sec-badge-verified">Terverifikasi</span>
                </div>
              </div>

              <div class="security-card-item">
                <div class="security-card-header">
                  <span class="material-symbols-outlined sec-icon">lock_open</span>
                  <div>
                    <strong class="sec-item-title">Metode Masuk Akun</strong>
                    <p class="sec-item-desc">Autentikasi aman terintegrasi dengan Google Identity Services dan Supabase Auth.</p>
                  </div>
                </div>
                <div class="sec-item-body">
                  <div class="oauth-provider-badge">
                    <span class="material-symbols-outlined oauth-icon">check_circle</span>
                    <span>Tersambung dengan Single Sign-On (SSO) Google</span>
                  </div>
                </div>
              </div>
            </div>
          </section>

        </div>
      </main>
    </div>
  </div>

  <!-- Data Geografis JSON Hidden untuk Script Klien -->
  <script id="geo-data-provinces" type="application/json" is:inline set:html={JSON.stringify(INDONESIA_PROVINCES)} />
</BaseLayout>

<script>
  // Tab Switcher Script
  const tabProfileBtn = document.getElementById('tab-btn-profile');
  const tabSecurityBtn = document.getElementById('tab-btn-security');
  const paneProfile = document.getElementById('tab-pane-profile');
  const paneSecurity = document.getElementById('tab-pane-security');

  const switchTab = (activeTab: 'profile' | 'security') => {
    if (activeTab === 'profile') {
      tabProfileBtn?.classList.add('active');
      tabProfileBtn?.setAttribute('aria-selected', 'true');
      tabSecurityBtn?.classList.remove('active');
      tabSecurityBtn?.setAttribute('aria-selected', 'false');

      paneProfile?.classList.add('active');
      paneProfile?.removeAttribute('hidden');
      paneSecurity?.classList.remove('active');
      paneSecurity?.setAttribute('hidden', '');
    } else {
      tabSecurityBtn?.classList.add('active');
      tabSecurityBtn?.setAttribute('aria-selected', 'true');
      tabProfileBtn?.classList.remove('active');
      tabProfileBtn?.setAttribute('aria-selected', 'false');

      paneSecurity?.classList.add('active');
      paneSecurity?.removeAttribute('hidden');
      paneProfile?.classList.remove('active');
      paneProfile?.setAttribute('hidden', '');
    }
  };

  tabProfileBtn?.addEventListener('click', () => switchTab('profile'));
  tabSecurityBtn?.addEventListener('click', () => switchTab('security'));

  // Pengelolaan Foto Profil (Upload & Remove)
  const avatarChangeBtn = document.getElementById('avatar-change-btn');
  const triggerUploadBtn = document.getElementById('btn-trigger-upload');
  const removeAvatarBtn = document.getElementById('btn-remove-avatar');
  const avatarFileInput = document.getElementById('input-avatar-file') as HTMLInputElement | null;
  const avatarFallbackBox = document.getElementById('avatar-fallback-box');
  const avatarBox = document.querySelector('.avatar-box');
  const avatarFeedback = document.getElementById('avatar-upload-feedback');

  const setAvatarFeedback = (msg: string, type: 'info' | 'success' | 'error' | 'none') => {
    if (!avatarFeedback) return;
    if (type === 'none') {
      avatarFeedback.textContent = '';
      avatarFeedback.className = 'avatar-feedback-pill hidden';
      return;
    }
    avatarFeedback.textContent = msg;
    avatarFeedback.className = `avatar-feedback-pill ${type}`;
  };

  const openFilePicker = () => {
    avatarFileInput?.click();
  };

  avatarChangeBtn?.addEventListener('click', openFilePicker);
  triggerUploadBtn?.addEventListener('click', openFilePicker);

  avatarFileInput?.addEventListener('change', async () => {
    const file = avatarFileInput.files?.[0];
    if (!file) return;

    // 1. Validasi Ukuran (Maksimal 3 MB)
    if (file.size > 3 * 1024 * 1024) {
      setAvatarFeedback('Ukuran berkas melebihi batas 3 MB.', 'error');
      avatarFileInput.value = '';
      return;
    }

    // 2. Validasi Format Berkas
    const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    if (!validTypes.includes(file.type)) {
      setAvatarFeedback('Format berkas harus JPG, PNG, atau WebP.', 'error');
      avatarFileInput.value = '';
      return;
    }

    // 3. Pratinjau Lokal Instan
    const previewUrl = URL.createObjectURL(file);
    let avatarPreviewImg = document.getElementById('avatar-preview-img') as HTMLImageElement | null;
    if (avatarPreviewImg) {
      avatarPreviewImg.src = previewUrl;
      avatarPreviewImg.style.display = 'block';
      if (avatarFallbackBox) avatarFallbackBox.style.display = 'none';
    } else if (avatarBox) {
      avatarPreviewImg = document.createElement('img');
      avatarPreviewImg.src = previewUrl;
      avatarPreviewImg.alt = 'Foto Profil Baru';
      avatarPreviewImg.className = 'avatar-photo-preview';
      avatarPreviewImg.id = 'avatar-preview-img';
      avatarPreviewImg.width = 140;
      avatarPreviewImg.height = 140;
      if (avatarChangeBtn) {
        avatarBox.insertBefore(avatarPreviewImg, avatarChangeBtn);
      } else {
        avatarBox.appendChild(avatarPreviewImg);
      }
      if (avatarFallbackBox) avatarFallbackBox.style.display = 'none';
    }

    // 4. Unggah ke Server
    setAvatarFeedback('Mengunggah foto...', 'info');
    if (triggerUploadBtn) {
      triggerUploadBtn.setAttribute('disabled', 'true');
      triggerUploadBtn.innerHTML = `
        <span class="material-symbols-outlined icon-btn-xs animate-spin">progress_activity</span>
        <span>Mengunggah...</span>
      `;
    }

    const formData = new FormData();
    formData.append('image', file);

    try {
      const res = await fetch('/api/user/avatar', {
        method: 'POST',
        body: formData,
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal mengunggah foto profil');
      }

      setAvatarFeedback('Foto berhasil diperbarui!', 'success');
      if (removeAvatarBtn) {
        removeAvatarBtn.classList.remove('hidden');
      }

      // Perbarui foto avatar yang tampil di sidebar dasbor
      document.querySelectorAll<HTMLImageElement>('.user-avatar-img, .hero-avatar-img').forEach((img) => {
        img.src = data.avatar_url;
      });

      window.dispatchEvent(
        new CustomEvent('phinisi-toast', {
          detail: { message: 'Foto profil berhasil diperbarui.', type: 'success' },
        })
      );

      setTimeout(() => {
        setAvatarFeedback('', 'none');
      }, 3500);
    } catch (uploadErr: any) {
      console.error('Upload foto profil error:', uploadErr);
      setAvatarFeedback(uploadErr.message || 'Gagal mengunggah foto.', 'error');
      window.dispatchEvent(
        new CustomEvent('phinisi-toast', {
          detail: { message: uploadErr.message || 'Gagal mengunggah foto.', type: 'error' },
        })
      );
    } finally {
      if (triggerUploadBtn) {
        triggerUploadBtn.removeAttribute('disabled');
        triggerUploadBtn.innerHTML = `
          <span class="material-symbols-outlined icon-btn-xs">upload</span>
          <span>Ganti Foto</span>
        `;
      }
      avatarFileInput.value = '';
    }
  });

  // Hapus Foto Profil (Kembali ke inisial nama)
  removeAvatarBtn?.addEventListener('click', async () => {
    if (!confirm('Hapus foto profil kustom dan kembali ke inisial nama?')) {
      return;
    }

    setAvatarFeedback('Menghapus foto...', 'info');
    removeAvatarBtn.setAttribute('disabled', 'true');

    try {
      const res = await fetch('/api/user/avatar', {
        method: 'DELETE',
      });

      const data = await res.json();
      if (!res.ok) {
        throw new Error(data.error || 'Gagal menghapus foto profil');
      }

      const currentImg = document.getElementById('avatar-preview-img');
      if (currentImg) {
        currentImg.style.display = 'none';
      }
      if (avatarFallbackBox) {
        avatarFallbackBox.style.display = 'grid';
      }

      removeAvatarBtn.classList.add('hidden');
      setAvatarFeedback('Foto profil berhasil dihapus.', 'success');

      window.dispatchEvent(
        new CustomEvent('phinisi-toast', {
          detail: { message: 'Foto profil berhasil dihapus.', type: 'success' },
        })
      );

      setTimeout(() => {
        setAvatarFeedback('', 'none');
      }, 3500);
    } catch (delErr: any) {
      console.error('Hapus foto error:', delErr);
      setAvatarFeedback(delErr.message || 'Gagal menghapus foto.', 'error');
    } finally {
      removeAvatarBtn.removeAttribute('disabled');
    }
  });

  // Dinamisasi Provinsi & Kota Indonesia
  const geoDataScript = document.getElementById('geo-data-provinces');
  const provincesList: Array<{ name: string; cities: string[] }> = geoDataScript ? JSON.parse(geoDataScript.textContent || '[]') : [];

  const provSelect = document.getElementById('select-province') as HTMLSelectElement | null;
  const citySelect = document.getElementById('select-city') as HTMLSelectElement | null;
  const initialCity = citySelect?.dataset.initialCity || '';

  const updateCityDropdown = (provinceName: string, selectedCity = '') => {
    if (!citySelect) return;
    const prov = provincesList.find((p) => p.name === provinceName);
    const cities = prov ? prov.cities : [];

    let optionsHtml = '<option value="">-- Pilih Kota / Kabupaten --</option>';
    cities.forEach((cityName) => {
      const isSelected = cityName === selectedCity ? 'selected' : '';
      optionsHtml += `<option value="${cityName}" ${isSelected}>${cityName}</option>`;
    });

    citySelect.innerHTML = optionsHtml;
  };

  if (provSelect) {
    if (provSelect.value) {
      updateCityDropdown(provSelect.value, initialCity);
    }
    provSelect.addEventListener('change', () => {
      updateCityDropdown(provSelect.value, '');
    });
  }

  // Form Submission Handler
  const form = document.getElementById('settings-profile-form') as HTMLFormElement | null;
  const saveBtn = document.getElementById('btn-save-profile') as HTMLButtonElement | null;
  const errorAlert = document.getElementById('form-error-alert');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!saveBtn) return;

      const formData = new FormData(form);
      const full_name = String(formData.get('full_name') || '').trim();
      const phone_number = String(formData.get('phone_number') || '').trim();
      const dial_code = String(formData.get('dial_code') || '+62').trim();
      const birth_date = String(formData.get('birth_date') || '').trim();
      const gender = String(formData.get('gender') || '').trim();
      const country = 'Indonesia';
      const country_code = 'ID';
      const province = String(formData.get('province') || '').trim();
      const city = String(formData.get('city') || '').trim();
      const occupation = String(formData.get('occupation') || '').trim();
      const institution_name = String(formData.get('institution_name') || '').trim();
      const referral_source = String(formData.get('referral_source') || '').trim();
      const bio = String(formData.get('bio') || '').trim();

      saveBtn.disabled = true;
      saveBtn.innerHTML = `
        <span class="material-symbols-outlined icon-btn animate-spin">progress_activity</span>
        <span>Menyimpan Profil...</span>
      `;
      if (errorAlert) {
        errorAlert.textContent = '';
        errorAlert.classList.add('hidden');
      }

      try {
        const res = await fetch('/api/user/profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            full_name,
            phone_number,
            dial_code,
            birth_date,
            gender,
            country,
            country_code,
            province,
            city,
            occupation,
            institution_name,
            referral_source,
            bio,
          }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Gagal memperbarui profil');
        }

        window.dispatchEvent(
          new CustomEvent('phinisi-toast', {
            detail: { message: 'Profil dan data sertifikat berhasil disimpan', type: 'success' },
          })
        );

        setTimeout(() => {
          window.location.reload();
        }, 600);
      } catch (err: any) {
        if (errorAlert) {
          errorAlert.textContent = err.message || 'Terjadi kesalahan sistem';
          errorAlert.classList.remove('hidden');
        }
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = `
          <span class="material-symbols-outlined icon-btn">save</span>
          <span>Simpan Perubahan</span>
        `;
      }
    });
  }
</script>

<style>
  .dashboard-page-container.fluid-layout {
    width: 100%;
    max-width: 100%;
    padding: 1.75rem clamp(1.25rem, 3vw, 3.5rem) 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-sizing: border-box;
  }

  /* Breadcrumb Navigation */
  .dashboard-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.84rem;
