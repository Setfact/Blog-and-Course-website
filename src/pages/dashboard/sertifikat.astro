---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DashboardSidebar from '../../components/dashboard/DashboardSidebar.astro';
import Button from '../../components/ui/Button.astro';
import { loadCourses } from '../../data/learning';
import { createSupabaseServerClient } from '../../lib/supabase';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect('/login?redirect=/dashboard/sertifikat');
}

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const isProfileComplete = Boolean(
  user.is_profile_complete ||
  (user.full_name && user.country && (user.province || user.city) && user.institution_name)
);

const courses = await loadCourses();
const completedLessonsSet = new Set<string>();

if (supabase) {
  try {
    const progressRes = await supabase
      .from('user_lesson_progress')
      .select('course_slug, lesson_id')
      .eq('user_id', user.id);

    if (progressRes.data) {
      progressRes.data.forEach((r: { course_slug: string; lesson_id: string }) => {
        completedLessonsSet.add(`${r.course_slug}/${r.lesson_id}`);
      });
    }
  } catch (err) {
    console.error('Error fetching progress for certificates:', err);
  }
}

// Cek kelulusan kursus
const finishedCourses = courses.filter((c) => {
  const finishedCount = Array.from(completedLessonsSet).filter((k) => k.startsWith(`${c.slug}/`)).length;
  return finishedCount >= (c.lessonCount || 1) && (c.lessonCount || 0) > 0;
});
---

<BaseLayout title="List Sertifikat Siswa" description="Daftar e-sertifikat kelulusan kursus dan verifikasi keahlian jaringan Phinisi Learn.">
  <div class="dashboard-page-container page-shell">
    
    <!-- Top Breadcrumb -->
    <nav class="dashboard-breadcrumb" aria-label="Breadcrumb">
      <a href="/dashboard" class="breadcrumb-link">Dasbor</a>
      <span class="material-symbols-outlined breadcrumb-separator">chevron_right</span>
      <span class="breadcrumb-current">List Sertifikat</span>
    </nav>

    <div class="dashboard-layout">
      <!-- Sidebar Navigasi -->
      <DashboardSidebar activeTab="certificates" user={user} />

      <!-- Area Konten Utama -->
      <main class="dashboard-main-content">
        <div class="cert-card">
          
          <div class="cert-card-header">
            <div>
              <h1 class="cert-main-title">List Sertifikat</h1>
              <p class="cert-main-subtitle">Sertifikat kelulusan kursus dan pencapaian kompetensi jaringan resmi Phinisi Learn.</p>
            </div>
            
            <span class:list={['status-badge', isProfileComplete ? 'ready' : 'incomplete']}>
              <span class="material-symbols-outlined icon-status">
                {isProfileComplete ? 'verified' : 'priority_high'}
              </span>
              <span>{isProfileComplete ? 'Profil Sertifikat Siap' : 'Profil Belum Lengkap'}</span>
            </span>
          </div>

          <!-- Prerequisite Alert Banner -->
          {!isProfileComplete ? (
            <div class="cert-prereq-alert">
              <div class="alert-icon-box">
                <span class="material-symbols-outlined">badge</span>
              </div>
              <div class="alert-content">
                <strong>Prasyarat Penerbitan Sertifikat</strong>
                <p>Nama lengkap resmi dan asal sekolah/kampus Anda diperlukan agar sertifikat yang Anda raih dapat diterbitkan dengan verifikasi resmi.</p>
              </div>
              <a href="/dashboard/profil" class="btn-alert-link">
                <span>Lengkapi Profil</span>
                <span class="material-symbols-outlined icon-inline">arrow_forward</span>
              </a>
            </div>
          ) : (
            <div class="cert-verified-alert">
              <span class="material-symbols-outlined verified-icon">verified_user</span>
              <p>Nama tercetak resmi: <strong>{user.full_name}</strong> {user.institution_name ? `(${user.institution_name})` : ''} &middot; Domisili: {user.city ? `${user.city}, ` : ''}{user.country || 'Indonesia'}.</p>
            </div>
          )}

          <!-- Daftar Sertifikat atau Tampilan Kosong (Empty State) -->
          {finishedCourses.length > 0 ? (
            <div class="cert-grid">
              {finishedCourses.map((c) => (
                <div class="cert-item-card">
                  <div class="cert-item-header">
                    <span class="material-symbols-outlined cert-badge-icon">workspace_premium</span>
                    <div class="cert-item-meta">
                      <span class="cert-badge-kicker">Sertifikat Kelulusan Kursus</span>
                      <h2 class="cert-course-title">{c.title}</h2>
                    </div>
                  </div>
                  <div class="cert-item-details">
                    <div class="detail-row">
                      <span class="detail-label">Penerima:</span>
                      <span class="detail-val">{user.full_name}</span>
                    </div>
                    <div class="detail-row">
                      <span class="detail-label">Instansi:</span>
                      <span class="detail-val">{user.institution_name || 'Umum'}</span>
                    </div>
                    <div class="detail-row">
                      <span class="detail-label">Status:</span>
                      <span class="detail-status">Terverifikasi</span>
                    </div>
                  </div>
                  <div class="cert-item-actions">
                    <Button href={`/courses/${c.slug}`} variant="secondary" size="sm">
                      <span class="material-symbols-outlined icon-btn-inline">visibility</span>
                      <span>Lihat Kursus</span>
                    </Button>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="empty-cert-box">
              <div class="empty-icon-wrap">
                <span class="material-symbols-outlined">workspace_premium</span>
              </div>
              <h2 class="empty-title">Belum Ada Sertifikat yang Diterbitkan</h2>
              <p class="empty-description">
                Selesaikan seluruh modul materi dan kuis evaluasi pada kursus jaringan untuk mengklaim E-Sertifikat kelulusan resmi Anda.
              </p>
              <Button href="/courses" variant="primary" size="md">
                <span class="material-symbols-outlined icon-btn-inline">search</span>
                <span>Jelajahi Kursus Jaringan</span>
              </Button>
            </div>
          )}

        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .dashboard-page-container {
    padding-block: 2rem 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .dashboard-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.84rem;
    color: var(--color-muted);
  }

  .breadcrumb-link {
    color: var(--color-muted);
    text-decoration: none;
    font-weight: 600;
  }

  .breadcrumb-link:hover {
    color: var(--color-primary);
  }

  .breadcrumb-separator {
    font-size: 1.1rem;
    color: var(--color-line);
  }

  .breadcrumb-current {
    color: var(--color-navy);
    font-weight: 700;
  }

  .dashboard-layout {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .dashboard-main-content {
    flex: 1;
    min-width: 0;
  }

  .cert-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.35rem;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(8, 26, 58, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .cert-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 1.25rem;
  }

  .cert-main-title {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }

  .cert-main-subtitle {
    margin: 0.25rem 0 0 0;
    font-size: 0.86rem;
    color: var(--color-muted);
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 700;
  }

  .status-badge.ready {
    background: #f0fdf4;
    color: #166534;
    border: 1px solid #86efac;
  }

  .status-badge.incomplete {
    background: #fffbeb;
    color: #854d0e;
    border: 1px solid #fde047;
  }

  .icon-status {
    font-size: 1rem;
  }

  .cert-prereq-alert {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.15rem 1.4rem;
    background: #fffbeb;
    border: 1px solid #fde047;
    border-radius: 1.15rem;
    color: #78350f;
  }

  .alert-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.9);
    display: grid;
    place-items: center;
    color: #d97706;
    flex-shrink: 0;
  }

  .alert-content {
    flex: 1;
  }

  .alert-content strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 800;
    margin-bottom: 0.15rem;
  }

  .alert-content p {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.4;
  }

  .btn-alert-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.15rem;
    border-radius: 0.8rem;
    background: #d97706;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    flex-shrink: 0;
    transition: all 140ms ease;
  }

  .btn-alert-link:hover {
    background: #b45309;
    transform: translateY(-1px);
  }

  .icon-inline {
    font-size: 1.1rem;
  }

  .cert-verified-alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.15rem;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 1rem;
    color: #166534;
    font-size: 0.84rem;
  }

  .cert-verified-alert p {
    margin: 0;
  }

  .verified-icon {
    font-size: 1.25rem;
    color: #16a34a;
    flex-shrink: 0;
  }

  /* Empty State */
  .empty-cert-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 3.5rem 1.5rem;
    gap: 1rem;
    background: #fafcff;
    border: 1px dashed var(--color-line);
    border-radius: 1.25rem;
  }

  .empty-icon-wrap {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: #eff6ff;
    color: var(--color-primary);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 14px rgba(20, 91, 215, 0.1);
  }

  .empty-icon-wrap .material-symbols-outlined {
    font-size: 2.2rem;
  }

  .empty-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }

  .empty-description {
    max-width: 460px;
    font-size: 0.86rem;
    color: var(--color-muted);
    line-height: 1.5;
    margin: 0;
  }

  .icon-btn-inline {
    font-size: 1.1rem;
    margin-right: 0.35rem;
  }

  /* Grid Sertifikat Aktif */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
  }

  .cert-item-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.15rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: 0 4px 14px rgba(8, 26, 58, 0.03);
  }

  .cert-item-header {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .cert-badge-icon {
    font-size: 2rem;
    color: #f59e0b;
    flex-shrink: 0;
  }

  .cert-badge-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #b45309;
  }

  .cert-course-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0.15rem 0 0 0;
  }

  .cert-item-details {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-block: 0.75rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    font-size: 0.82rem;
  }

  .detail-row {
    display: flex;
    justify-content: space-between;
  }

  .detail-label {
    color: var(--color-muted);
  }

  .detail-val {
    font-weight: 600;
    color: var(--color-navy);
  }

  .detail-status {
    font-weight: 700;
    color: #16a34a;
  }

  @media (max-width: 860px) {
    .dashboard-layout {
      flex-direction: column;
    }
    .cert-prereq-alert {
      flex-direction: column;
      align-items: flex-start;
    }
    .btn-alert-link {
      width: 100%;
      justify-content: center;
    }
  }
</style>
