---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import ProgressBar from '../../components/ui/ProgressBar.astro';
import { getCoursesForPath, loadLearningData } from '../../data/learning';

const { courses, paths } = await loadLearningData();
const accents = ['primary', 'sky', 'gold', 'success'] as const;

const pathMeta: Record<string, { label: string }> = {
  'ccna-200-301': { label: 'Cisco' },
  mtcna: { label: 'MikroTik' },
};
---

<BaseLayout title="Alur Belajar" description="Ikuti alur belajar networking yang terstruktur dari fondasi hingga siap praktik.">
  <section class="path-hero tech-grid">
    <div class="page-shell path-hero-grid">
      <div>
        <h1>Jangan belajar acak. Ikuti <span>rute yang jelas.</span></h1>
        <p>Setiap alur menyusun beberapa course dalam urutan yang masuk akal, sehingga kamu selalu tahu course mana yang dipelajari berikutnya.</p>
      </div>
    </div>
  </section>

  <section class="path-content page-shell">
    <div class="section-heading">
      <div>
        <h2>Pilih tujuan pertamamu.</h2>
        <p>Kamu bisa berpindah rute kapan saja. Progress setiap alur akan tetap tersimpan.</p>
      </div>
      <Badge tone="success" size="md" icon="verified">Ramah pemula</Badge>
    </div>

    <div class="path-grid">
      {paths.map((path, index) => {
        const meta = pathMeta[path.slug] ?? { label: 'Networking' };
        const pathCourses = getCoursesForPath(path, courses);
        const courseCount = pathCourses.length;
        const moduleCount = pathCourses.reduce((total, course) => total + course.moduleCount, 0);
        const hours = pathCourses.reduce((total, course) => total + course.durationHours, 0);
        const accent = accents[index % accents.length];
        return (
          <Card padding="lg" interactive class={`path-card accent-${accent}`}>
            {path.cover && (
              <div class="path-cover">
                <img src={path.cover} alt={`Cover ${path.title.id}`} loading="lazy" />
              </div>
            )}
            <div class="path-topline">
              <Badge tone={accent === 'gold' ? 'gold' : accent === 'success' ? 'success' : accent === 'sky' ? 'sky' : 'primary'}>{meta.label}</Badge>
            </div>
            <h3>{path.title.id}</h3>
            <p>{path.description.id || 'Pelajari langkah demi langkah dari dasar hingga mahir melalui misi praktik.'}</p>
            <div class="path-stats">
              <span><strong>{courseCount}</strong> course</span>
              <span><strong>{moduleCount}</strong> modul</span>
              <span><strong>{hours}</strong> jam</span>
            </div>
            <ProgressBar value={0} label="Belum dimulai" tone={accent === 'gold' ? 'gold' : accent === 'success' ? 'success' : accent === 'sky' ? 'sky' : 'primary'} />
            <div class="path-footer">
              <small>Mulai dari course pertama</small>
              <Button href={`/learning-path/${path.slug}`} size="sm">Lihat rute</Button>
            </div>
          </Card>
        );
      })}
    </div>
  </section>

  <section class="path-how">
    <div class="page-shell how-grid">
      <div class="how-copy">
        <h2>Dari pelabuhan hingga tujuan.</h2>
      </div>
      <ol class="steps">
        <li><span>1</span><div><strong>Pilih rute</strong><p>Tentukan skill atau sertifikasi yang ingin kamu tuju.</p></div></li>
        <li><span>2</span><div><strong>Selesaikan course</strong><p>Di dalam setiap course, pelajari modul, lesson, praktik command, dan quiz.</p></div></li>
        <li><span>3</span><div><strong>Lanjut ke course berikutnya</strong><p>Roadmap menunjukkan urutan yang direkomendasikan tanpa mengunci pilihan belajarmu.</p></div></li>
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .path-hero { border-bottom: 1px solid var(--color-phinisi-100); background-color: var(--color-section); }
  .path-hero-grid { padding-block: clamp(3.5rem, 7vw, 5.5rem); }
  .path-hero h1 { max-width: 760px; margin: 0 0 1rem; color: var(--color-navy); font-family: var(--font-heading); font-size: clamp(2.7rem, 5.5vw, 4.8rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.12; }
  .path-hero h1 span { color: var(--color-phinisi-600); }
  .path-hero p { max-width: 680px; margin: 0; color: var(--color-muted); font-size: 1.05rem; line-height: 1.7; }
  .path-content { padding-block: clamp(4rem, 8vw, 7rem); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; }
  .section-heading h2, .how-copy h2 { margin: 0 0 0.55rem; color: var(--color-navy); font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 600; letter-spacing: -0.015em; line-height: 1.15; }
  .section-heading p { margin: 0; color: var(--color-muted); line-height: 1.65; }
  .path-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.35rem; }
  .path-card { position: relative; overflow: hidden; }
  .path-card::before { position: absolute; top: 0; right: 1.5rem; left: 1.5rem; height: 5px; border-radius: 0 0 999px 999px; background: var(--color-phinisi-600); content: ''; }
  .path-card.accent-sky::before { background: var(--color-sky); }
  .path-card.accent-gold::before { background: var(--color-gold); }
  .path-card.accent-success::before { background: var(--color-success); }
  .path-cover { aspect-ratio: 16 / 9; margin: -2rem -2rem 1.35rem; overflow: hidden; border-bottom: 1px solid var(--color-line); background: var(--color-phinisi-50); }
  .path-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 220ms ease; }
  .path-card:hover .path-cover img { transform: scale(1.025); }
  .path-topline { display: flex; align-items: center; justify-content: flex-end; gap: 1rem; }
  .path-card h3 { margin: 0.85rem 0 0.65rem; color: var(--color-navy); font-family: var(--font-heading); font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; line-height: 1.3; }
  .path-card > :global(p) { min-height: 3.2em; margin: 0 0 1.25rem; color: var(--color-muted); line-height: 1.62; }
  .path-stats { display: flex; flex-wrap: wrap; gap: 0.8rem 1.2rem; margin-bottom: 1.25rem; color: var(--color-muted); font-size: 0.76rem; }
  .path-stats span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .path-stats strong { color: var(--color-ink); font-family: var(--font-heading); font-weight: 800; }
  .path-footer { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.35rem; border-top: 1px solid var(--color-line); padding-top: 1.25rem; }
  .path-footer small { color: var(--color-muted); font-size: 0.75rem; font-weight: 700; }
  .path-how { background: var(--color-section); }
  .how-grid { display: grid; grid-template-columns: 0.65fr 1.35fr; gap: clamp(3rem, 7vw, 6rem); padding-block: clamp(4rem, 8vw, 6.5rem); }
  .steps { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .steps li { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding-bottom: 2rem; }
  .steps li:not(:last-child)::after { position: absolute; top: 44px; bottom: 4px; left: 21px; width: 2px; background: var(--color-phinisi-200); content: ''; }
  .steps li > span { position: relative; z-index: 1; display: grid; width: 44px; height: 44px; place-items: center; border: 5px solid white; border-radius: 50%; background: var(--color-phinisi-600); box-shadow: 0 4px 0 #0d429e; color: white; font-family: var(--font-heading); font-weight: 800; }
  .steps strong { display: block; color: var(--color-navy); font-family: var(--font-heading); font-size: 1.05rem; font-weight: 600; }
  .steps p { margin: 0.3rem 0 0; color: var(--color-muted); line-height: 1.55; }
  @media (max-width: 900px) { .how-grid { grid-template-columns: 1fr; } }
  @media (max-width: 720px) { .section-heading { align-items: flex-start; flex-direction: column; } .path-grid { grid-template-columns: 1fr; } .path-footer { align-items: flex-start; flex-direction: column; } .path-footer > :global(.ph-button) { width: 100%; } }
</style>
