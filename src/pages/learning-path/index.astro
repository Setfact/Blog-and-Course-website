---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgressBar from '../../components/ui/ProgressBar.astro';
import { getCoursesForPath, loadLearningData } from '../../data/learning';

const { courses, paths } = await loadLearningData();
const accents = ['primary', 'sky', 'gold', 'success'] as const;

const pathMeta: Record<string, { label: string }> = {
  'ccna-200-301': { label: 'Cisco' },
  mtcna: { label: 'MikroTik' },
};
---

<BaseLayout
  title="Alur Belajar"
  description="Ikuti alur belajar networking yang terstruktur dari fondasi hingga siap praktik industri."
>
  <section class="path-banner-section page-shell">
    <div class="path-banner-card" data-reveal>
      <div class="banner-glow-effect" aria-hidden="true"></div>
      <div class="banner-content-layout">
        <div class="banner-copy">
          <h1>Temukan Rute <span>Sesuai Target Karirmu</span></h1>
          <p class="banner-text">
            Alur belajar menyusun beberapa course secara bertahap dan sistematis, membantu kamu belajar secara terarah dari fondasi hingga praktik industri.
          </p>
          <div class="banner-chips">
            <span class="chip">Cisco & MikroTik</span>
            <span class="chip">Simulasi Lab CLI</span>
            <span class="chip">Progres Otomatis</span>
          </div>
        </div>
        <div class="banner-visual">
          <img class="header-buoy-img" src="/assets/network-buoy.png" alt="Network Buoy Router" width="240" height="240" loading="eager" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section id="pilih-rute" class="path-content page-shell">
    <div class="path-grid">
      {paths.map((path, index) => {
        const meta = pathMeta[path.slug] ?? { label: 'Networking' };
        const pathCourses = getCoursesForPath(path, courses);
        const courseCount = pathCourses.length;
        const moduleCount = pathCourses.reduce((total, course) => total + course.moduleCount, 0);
        const hours = pathCourses.reduce((total, course) => total + course.durationHours, 0);
        const accent = accents[index % accents.length];
        return (
          <article class={`path-card-3d accent-${accent}`} data-reveal>
            {path.cover && (
              <div class="path-cover-wrap">
                <img src={path.cover} alt={`Cover ${path.title.id}`} loading="lazy" decoding="async" />
                <div class="path-badges-overlay">
                  <span class="category-chip">{meta.label}</span>
                  <span class="level-chip">Ramah Pemula</span>
                </div>
              </div>
            )}
            <div class="path-body">
              <h3>{path.title.id}</h3>
              <p>{path.description.id || 'Pelajari langkah demi langkah dari dasar hingga mahir melalui misi praktik.'}</p>
              
              <div class="path-metrics">
                <span class="metric-pill">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                  <strong>{courseCount}</strong> Course
                </span>
                <span class="metric-pill">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
                  <strong>{moduleCount}</strong> Modul
                </span>
                <span class="metric-pill">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                  <strong>{hours}</strong> Jam
                </span>
              </div>

              <div class="path-progress-box">
                <ProgressBar value={0} label="Belum dimulai" tone={accent === 'gold' ? 'gold' : accent === 'success' ? 'success' : accent === 'sky' ? 'sky' : 'primary'} />
              </div>

              <div class="path-footer-row">
                <small>Mulai dari course pertama</small>
                <a href={`/learning-path/${path.slug}`} class="path-action-btn">
                  Lihat rute <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section id="alur-step" class="path-how-section">
    <div class="page-shell how-shell">
      <header class="home-heading centered" style="margin-bottom: 3.5rem;" data-reveal>
        <p class="section-kicker">BAGAIMANA CARA KERJANYA</p>
        <h2>Dari Pelabuhan Hingga Tujuan</h2>
        <p>Tiga langkah sederhana untuk menguasai keahlian IT secara sistematis dan terarah.</p>
      </header>

      <ol class="nautical-steps" aria-label="Tiga tahap alur belajar">
        <li data-reveal>
          <div class="step-badge">1</div>
          <div class="step-content">
            <h3>Pilih Rute Tujuan</h3>
            <p>Tentukan skill, sertifikasi, atau spesialisasi industri yang ingin kamu capai.</p>
          </div>
        </li>
        <li data-reveal>
          <div class="step-badge">2</div>
          <div class="step-content">
            <h3>Selesaikan Course & Lab</h3>
            <p>Di dalam setiap course, pelajari modul, ikuti simulasi CLI, kerjakan quiz, dan instruksi praktik.</p>
          </div>
        </li>
        <li data-reveal>
          <div class="step-badge">3</div>
          <div class="step-content">
            <h3>Lanjut ke Level Berikutnya</h3>
            <p>Roadmap menunjukkan urutan yang direkomendasikan secara fleksibel tanpa mengunci pilihan belajarmu.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .path-banner-section {
    padding-top: 2rem;
    padding-bottom: 1.5rem;
  }
  .path-banner-card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-radius: 24px;
    padding: clamp(2.2rem, 4.5vw, 3.5rem);
    background: linear-gradient(135deg, #04122b 0%, #082d68 55%, #0c4d9e 100%);
    border: 1px solid rgba(103, 232, 249, 0.35);
    box-shadow: 0 20px 45px rgba(4, 29, 69, 0.22);
    color: #ffffff;
  }
  .banner-glow-effect {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: radial-gradient(circle at 85% 20%, rgba(56, 189, 248, 0.2) 0%, transparent 45%),
                      radial-gradient(circle at 10% 80%, rgba(34, 211, 238, 0.12) 0%, transparent 40%);
    pointer-events: none;
  }
  .banner-content-layout {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .banner-copy {
    flex: 1;
    max-width: 640px;
  }
  .banner-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid rgba(103, 232, 249, 0.35);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    background: rgba(3, 33, 78, 0.5);
    color: #67e8f9;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    backdrop-filter: blur(8px);
    margin-bottom: 1.1rem;
  }
  .kicker-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #facc15;
    box-shadow: 0 0 10px rgba(250, 204, 21, 0.6);
  }
  .banner-copy h1 {
    margin: 0 0 0.85rem;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 4.2vw, 3.4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.12;
  }
  .banner-copy h1 span {
    color: #78e9ff;
    display: block;
  }
  .banner-text {
    margin: 0 0 1.5rem;
    color: #c8e5ff;
    font-size: clamp(0.96rem, 1.15vw, 1.05rem);
    line-height: 1.68;
    max-width: 580px;
  }
  .banner-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(186, 238, 255, 0.25);
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    background: rgba(255, 255, 255, 0.09);
    color: #e2f4ff;
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(6px);
  }
  .banner-visual {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .header-buoy-img {
    width: clamp(150px, 18vw, 220px);
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 14px 28px rgba(3, 33, 75, 0.4));
    animation: buoy-float 6s ease-in-out infinite;
  }
  @keyframes buoy-float { 0%, 100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-8px) rotate(1.5deg); } }

  .path-content { padding-top: 2rem; padding-bottom: clamp(3.5rem, 6vw, 5.5rem); }
  .path-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.75rem; }
  .path-card-3d { position: relative; display: flex; flex-direction: column; overflow: hidden; border: 1px solid rgba(40, 201, 232, 0.28); border-radius: 22px; background: #ffffff; box-shadow: 0 14px 35px rgba(8, 42, 81, 0.08); transition: transform 250ms ease, border-color 250ms ease, box-shadow 250ms ease; }
  .path-card-3d:hover { transform: translateY(-6px); border-color: rgba(40, 201, 232, 0.8); box-shadow: 0 20px 45px rgba(8, 42, 81, 0.14); }

  .path-cover-wrap { position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-phinisi-50); }
  .path-cover-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 350ms ease; }
  .path-card-3d:hover .path-cover-wrap img { transform: scale(1.03); }
  .path-badges-overlay { position: absolute; z-index: 2; top: 0.85rem; right: 0.85rem; left: 0.85rem; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .path-badges-overlay span { border: 1px solid rgba(8, 26, 58, 0.12); border-radius: 999px; padding: 0.32rem 0.65rem; background: rgba(255, 255, 255, 0.94); box-shadow: 0 4px 14px rgba(8, 26, 58, 0.1); font-size: 0.68rem; font-weight: 800; backdrop-filter: blur(8px); }
  .category-chip { color: var(--color-primary); }
  .level-chip { color: #059669; }

  .path-body { display: flex; flex: 1; flex-direction: column; padding: 1.6rem 1.75rem; }
  .path-body h3 { margin: 0 0 0.6rem; color: var(--color-navy); font-family: var(--font-heading); font-size: clamp(1.35rem, 2.5vw, 1.75rem); font-weight: 700; line-height: 1.3; }
  .path-body p { margin: 0 0 1.25rem; color: var(--color-muted); font-size: 0.9rem; line-height: 1.62; min-height: 3.2em; }

  .path-metrics { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
  .metric-pill { display: inline-flex; align-items: center; gap: 0.4rem; border-radius: 999px; padding: 0.32rem 0.72rem; background: #f1f5f9; color: #475569; font-size: 0.74rem; font-weight: 600; }
  .metric-pill svg { color: var(--color-primary); }
  .metric-pill strong { color: var(--color-navy); font-weight: 800; }

  .path-progress-box { margin-bottom: 1.25rem; }

  .path-footer-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; border-top: 1px solid var(--color-line); padding-top: 1rem; }
  .path-footer-row small { color: var(--color-muted); font-size: 0.76rem; font-weight: 700; }
  .path-action-btn { display: inline-flex; align-items: center; gap: 0.4rem; border-radius: 0.65rem; padding: 0.55rem 0.9rem; background: var(--color-primary); color: #ffffff; font-size: 0.78rem; font-weight: 800; text-decoration: none; transition: background 180ms ease, transform 180ms ease; }
  .path-action-btn span { transition: transform 180ms ease; }
  .path-action-btn:hover { background: #0e4ca9; }
  .path-action-btn:hover span { transform: translateX(3px); }

  .path-how-section { padding-block: clamp(4rem, 7vw, 6.5rem); background: #fafcfd; border-top: 1px solid var(--color-line); }
  .home-heading.centered { text-align: center; }
  .section-kicker { margin: 0 0 0.6rem; color: #1266d6; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 750; letter-spacing: 0.12em; line-height: 1.35; text-transform: uppercase; }
  .home-heading h2 { margin: 0 0 0.75rem; color: #061d3f; font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3.2rem); font-weight: 700; letter-spacing: -0.02em; }
  .home-heading p { max-width: 680px; margin: 0 auto; color: #374e6c; font-family: var(--font-body); font-size: 1.02rem; line-height: 1.68; }

  .nautical-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem; margin: 0; padding: 0; list-style: none; }
  .nautical-steps li { position: relative; display: flex; flex-direction: column; gap: 1.2rem; border: 1px solid var(--color-line); border-radius: 1.25rem; padding: 1.75rem; background: #ffffff; box-shadow: 0 8px 24px rgba(8, 42, 81, 0.04); transition: transform 200ms ease, border-color 200ms ease; }
  .nautical-steps li:hover { transform: translateY(-4px); border-color: var(--color-phinisi-200); box-shadow: 0 14px 32px rgba(8, 42, 81, 0.08); }
  .step-badge { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 50%; background: var(--color-primary); color: #ffffff; font-family: var(--font-heading); font-size: 1.15rem; font-weight: 900; box-shadow: 0 4px 14px rgba(20, 91, 215, 0.3); }
  .step-content h3 { margin: 0 0 0.5rem; color: #061d3f; font-family: var(--font-heading); font-size: 1.18rem; font-weight: 700; }
  .step-content p { margin: 0; color: #374e6c; font-family: var(--font-body); font-size: 0.88rem; line-height: 1.6; }

  @media (max-width: 768px) {
    .banner-content-layout {
      flex-direction: column;
      text-align: center;
    }
    .banner-copy {
      max-width: 100%;
    }
    .banner-chips {
      justify-content: center;
    }
  }
  @media (max-width: 820px) { .path-grid, .nautical-steps { grid-template-columns: 1fr; } }
</style>
