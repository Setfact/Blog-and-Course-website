---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LearningPathDetail from '../../components/LearningPathDetail.astro';
import { getCoursesForPath, getPathBySlug, loadCourses } from '../../data/learning';

const slug = Astro.params.slug || 'ccna-200-301';
const [path, courses] = await Promise.all([
  getPathBySlug(slug),
  loadCourses(),
]);

if (!path) {
  return Astro.redirect('/learning-path');
}

const pathCourses = getCoursesForPath(path, courses);
---

<BaseLayout title={path.title.id} description={path.description.id}>
  <LearningPathDetail path={path} courses={pathCourses} language="id" />
</BaseLayout>
