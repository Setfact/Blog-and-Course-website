---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { loadAllCourses } from '../../data/learning';
import { createSupabaseServerClient } from '../../lib/supabase';
import { getCourseAnalytics, getActiveAnnouncement } from '../../lib/admin';

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const courses = await loadAllCourses();
const totalLessons = courses.reduce((acc, c) => acc + (c.lessonCount || 0), 0);
const publishedCount = courses.filter((c) => c.status === 'published').length;
const plannedCount = courses.filter((c) => c.status === 'planned').length;
const draftCount = courses.filter((c) => c.status === 'draft').length;
const archivedCount = courses.filter((c) => c.status === 'archived').length;

const analytics = await getCourseAnalytics(supabase);
const announcement = await getActiveAnnouncement(supabase);
---

<AdminLayout title="Status Kursus & Pengumuman" activeSection="courses">
  <div class="courses-mgmt-container">
    <!-- Top Stats -->
    <section class="kpi-mini-row">
      <div class="kpi-mini-card">
        <span class="label">Total Kursus</span>
        <strong class="val">{courses.length} Kursus</strong>
      </div>
      <div class="kpi-mini-card">
        <span class="label">Kursus Terpublikasi</span>
        <strong class="val val-success">{publishedCount} Aktif</strong>
      </div>
      <div class="kpi-mini-card">
        <span class="label">Segera Hadir (Planned)</span>
        <strong class="val val-info">{plannedCount} Rencana</strong>
      </div>
      <div class="kpi-mini-card">
        <span class="label">Draf & Modul Materi</span>
        <strong class="val val-warning">{draftCount} Draf · {totalLessons} Pelajaran</strong>
      </div>
    </section>

    <!-- Platform Announcement Manager Card -->
    <section class="announcement-mgmt-card">
      <div class="card-header-bar">
        <div class="icon-wrap-horn">
          <span class="material-symbols-outlined">campaign</span>
        </div>
        <div class="header-text-block">
          <h2 class="card-title">Siaran Pengumuman Platform</h2>
          <p class="card-desc">
            Pesan pengumuman ini akan langsung ditampilkan di bagian atas Dashboard seluruh siswa.
          </p>
        </div>
        <span class:list={['broadcast-status-pill', announcement.is_active ? 'status-live' : 'status-off']}>
          {announcement.is_active ? 'Siaran Aktif' : 'Siaran Nonaktif'}
        </span>
      </div>

      <form id="announcement-form" class="announcement-form">
        <div class="form-row">
          <div class="form-col-wide">
            <label for="announcement-msg" class="field-label">Isi Pesan Pengumuman</label>
            <input
              type="text"
              id="announcement-msg"
              name="message"
              value={announcement.message}
              required
              maxlength="200"
              class="text-input"
              placeholder="Contoh: Webinar CCNA Cisco Sabtu jam 19:00 WIB, siapkan lab Packet Tracer Anda!"
            />
          </div>

          <div class="form-col-narrow">
            <label for="announcement-type" class="field-label">Tipe Tampilan</label>
            <select id="announcement-type" name="type" class="select-input">
              <option value="info" selected={announcement.type === 'info'}>Info (Biru)</option>
              <option value="warning" selected={announcement.type === 'warning'}>Penting (Kuning)</option>
              <option value="success" selected={announcement.type === 'success'}>Sukses (Hijau)</option>
            </select>
          </div>

          <div class="form-col-action">
            <button type="submit" class="btn-save-announcement" id="btn-save-announce">
              <span>Simpan Pengumuman</span>
            </button>
          </div>
        </div>
      </form>
    </section>

    <!-- Header with Create Course CTA & Keystatic Bridge -->
    <div class="mgmt-header-card">
      <div class="header-copy">
        <h2 class="section-title">Kurikulum, Materi Teknis & Lab</h2>
        <p class="section-desc">
          Gunakan <strong>Wizard Buat Kursus</strong> untuk menyusun kursus baru, atau klik <strong>Edit Kursus & Materi</strong> pada setiap kartu untuk mengedit modul, materi teks, lab Packet Tracer (.pkt), dan kuis secara langsung dalam satu studio terpadu tanpa perlu ke Keystatic.
        </p>
      </div>
      <div class="header-actions-group">
        <a href="/admin/courses/new" class="btn-create-course">
          <span class="material-symbols-outlined">add_circle</span>
          <span>+ Buat Kursus Baru</span>
        </a>
        <a href="/keystatic" target="_blank" rel="noopener noreferrer" class="cms-btn" title="Buka Keystatic CMS (Cadangan)">
          <span class="material-symbols-outlined">dataset</span>
          <span>Keystatic CMS (Opsional)</span>
        </a>
      </div>
    </div>

    <!-- Filter Tabs Row -->
    <div class="courses-filter-row">
      <div class="filter-tabs" role="tablist">
        <button type="button" class="tab-pill active" data-filter="all">Semua ({courses.length})</button>
        <button type="button" class="tab-pill" data-filter="published">Terpublikasi ({publishedCount})</button>
        <button type="button" class="tab-pill" data-filter="planned">Segera Hadir ({plannedCount})</button>
        <button type="button" class="tab-pill" data-filter="draft">Draf ({draftCount})</button>
        {archivedCount > 0 && <button type="button" class="tab-pill" data-filter="archived">Arsip ({archivedCount})</button>}
      </div>
    </div>

    <!-- Courses Grid with Real Analytics -->
    <div class="courses-grid" id="courses-grid">
      {courses.map((course) => {
        const courseData = analytics[course.slug] || { enrolledStudentsCount: 0, totalCompletionsCount: 0 };
        return (
          <div class="course-item-card" data-slug={course.slug} data-status={course.status}>
            <div class="course-card-top">
              <span class="category-badge">{course.category.toUpperCase()}</span>

              <div class="status-selector-wrap">
                <select
                  class="course-status-select"
                  data-slug={course.slug}
                  aria-label={`Ubah status kursus ${course.title}`}
                >
                  <option value="published" selected={course.status === 'published'}>Terpublikasi</option>
                  <option value="planned" selected={course.status === 'planned'}>Segera Hadir (Planned)</option>
                  <option value="draft" selected={course.status === 'draft'}>Draf</option>
                  <option value="archived" selected={course.status === 'archived'}>Arsip</option>
                </select>
                <span class="status-sync-indicator" id={`sync-${course.slug}`}></span>
              </div>
            </div>

            <h3 class="course-item-title">{course.title}</h3>
            <p class="course-item-summary">{course.description.id}</p>

            <!-- Real Student Analytics Strip -->
            <div class="course-analytics-strip">
              <div class="analytic-item">
                <span class="analytic-label">Siswa Terdaftar</span>
                <strong class="analytic-val">{courseData.enrolledStudentsCount} Siswa</strong>
              </div>
              <div class="analytic-item">
                <span class="analytic-label">Modul Selesai</span>
                <strong class="analytic-val">{courseData.totalCompletionsCount} Kali</strong>
              </div>
            </div>

            <div class="course-stats-bar">
              <div class="stat-pill">
                <span class="material-symbols-outlined icon-mini">menu_book</span>
                <span>{course.lessonCount} materi</span>
              </div>
              <div class="stat-pill">
                <span class="material-symbols-outlined icon-mini">signal_cellular_alt</span>
                <span class="text-capitalize">{course.level}</span>
              </div>
            </div>

            <div class="course-card-actions">
              <a href={`/courses/${course.slug}`} class="action-btn-outline" target="_blank" title="Lihat tampilan kursus di web">
                <span class="material-symbols-outlined icon-mini">visibility</span>
                <span>Lihat di Web</span>
              </a>
              <a
                href={`/admin/courses/${course.slug}/edit`}
                class="action-btn-primary"
                title="Edit kursus, silabus, materi pelajaran, lab Packet Tracer, dan kuis"
              >
                <span class="material-symbols-outlined icon-mini">edit_note</span>
                <span>Edit Kursus & Materi</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <script>
    const announceForm = document.getElementById('announcement-form') as HTMLFormElement | null;
    const saveAnnounceBtn = document.getElementById('btn-save-announce') as HTMLButtonElement | null;

    if (announceForm) {
      announceForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!saveAnnounceBtn) return;

        const formData = new FormData(announceForm);
        const message = String(formData.get('message') || '').trim();
        const type = String(formData.get('type') || 'info');

        saveAnnounceBtn.disabled = true;
        saveAnnounceBtn.textContent = 'Menyimpan...';

        try {
          const res = await fetch('/api/admin/announcement', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message, type, is_active: true }),
          });

          const data = await res.json();
          if (data.success) {
            alert('Pengumuman platform berhasil diperbarui.');
            window.location.reload();
          } else {
            alert(data.error || 'Gagal memperbarui pengumuman.');
          }
        } catch {
          alert('Terjadi kesalahan jaringan.');
        } finally {
          saveAnnounceBtn.disabled = false;
          saveAnnounceBtn.textContent = 'Simpan Pengumuman';
        }
      });
    }

    // Status Selector AJAX Handler
    function applyStatusColor(select: HTMLSelectElement) {
      const val = select.value;
      if (val === 'published') {
        select.style.borderColor = '#059669';
        select.style.color = '#047857';
        select.style.background = '#ecfdf5';
      } else if (val === 'planned') {
        select.style.borderColor = '#3b82f6';
        select.style.color = '#1d4ed8';
        select.style.background = '#eff6ff';
      } else if (val === 'draft') {
        select.style.borderColor = '#f59e0b';
        select.style.color = '#b45309';
        select.style.background = '#fffbeb';
      } else {
        select.style.borderColor = '#94a3b8';
        select.style.color = '#475569';
        select.style.background = '#f8fafc';
      }
    }

    const statusSelects = document.querySelectorAll<HTMLSelectElement>('.course-status-select');
    statusSelects.forEach((select) => {
      applyStatusColor(select);

      select.addEventListener('change', async () => {
        const slug = select.dataset.slug;
        const newStatus = select.value;
        const indicator = document.getElementById(`sync-${slug}`);
        if (!slug) return;

        applyStatusColor(select);
        if (indicator) {
          indicator.textContent = 'Menyimpan...';
          indicator.style.color = '#3b82f6';
        }

        try {
          const res = await fetch('/api/admin/courses/status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, status: newStatus }),
          });

          const data = await res.json();
          if (data.success) {
            const card = select.closest<HTMLElement>('.course-item-card');
            if (card) {
              card.dataset.status = newStatus;
            }
            if (indicator) {
              indicator.textContent = 'Tersinkron';
              indicator.style.color = '#059669';
              setTimeout(() => {
                indicator.textContent = '';
              }, 2500);
            }
          } else {
            alert(data.error || 'Gagal mengubah status kursus.');
            if (indicator) indicator.textContent = 'Gagal';
          }
        } catch {
          alert('Terjadi kesalahan jaringan saat menyimpan status.');
          if (indicator) indicator.textContent = 'Gagal';
        }
      });
    });

    // Client-side Filter Tabs Handler
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-pill');
    const courseCards = document.querySelectorAll<HTMLElement>('.course-item-card');

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.dataset.filter || 'all';
        courseCards.forEach((card) => {
          if (filter === 'all' || card.dataset.status === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</AdminLayout>

<style>
  .courses-mgmt-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Mini Stats */
  .kpi-mini-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .kpi-mini-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: 1.15rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .kpi-mini-card .label {
    font-size: 0.74rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  .kpi-mini-card .val {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--color-navy);
  }
  .val-success {
    color: #059669 !important;
  }
  .val-info {
    color: #2563eb !important;
  }
  .val-warning {
    color: #d97706 !important;
  }

  /* Announcement Manager */
  .announcement-mgmt-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .card-header-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .icon-wrap-horn {
    width: 44px;
    height: 44px;
    border-radius: 0.85rem;
    background: #eff6ff;
    color: #1d4ed8;
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .header-text-block {
    flex: 1;
  }
  .card-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }
  .card-desc {
    margin: 0.2rem 0 0 0;
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .broadcast-status-pill {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
  }
  .status-live { background: #dcfce7; color: #15803d; }
  .status-off { background: #f1f5f9; color: #64748b; }

  .announcement-form {
    display: flex;
    flex-direction: column;
  }
  .form-row {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .form-col-wide {
    flex: 1;
    min-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-col-narrow {
    width: 160px;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .form-col-action {
    display: flex;
    align-items: flex-end;
  }
  .field-label {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .text-input, .select-input {
    width: 100%;
    min-height: 40px;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--color-line);
    border-radius: 0.65rem;
    font-size: 0.84rem;
    outline: none;
    box-sizing: border-box;
  }
  .text-input:focus, .select-input:focus {
    border-color: var(--color-primary);
  }
  .btn-save-announcement {
    min-height: 40px;
    padding: 0.45rem 1.15rem;
    border: none;
    border-radius: 0.65rem;
    background: var(--color-primary);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 120ms ease;
    white-space: nowrap;
  }
  .btn-save-announcement:hover {
    background: #0e4ca9;
  }
  .btn-save-announcement:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Keystatic CMS CTA Header */
  .mgmt-header-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
  }
  .header-copy {
    max-width: 680px;
  }
  .section-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }
  .section-desc {
    margin: 0.35rem 0 0 0;
    color: var(--color-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }
  .header-actions-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .btn-create-course {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--color-primary);
    color: #ffffff;
    padding: 0.65rem 1.15rem;
    border-radius: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(20, 91, 215, 0.2);
    transition: all 150ms ease;
  }
  .btn-create-course:hover {
    background: #0e4ca9;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(20, 91, 215, 0.3);
  }
  .cms-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-phinisi-600);
    color: #ffffff;
    padding: 0.65rem 1.15rem;
    border-radius: 0.75rem;
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 150ms ease;
  }
  .cms-btn:hover {
    background: var(--color-phinisi-700);
  }

  /* Courses Grid */
  .courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }
  .course-item-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.25rem;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .course-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .category-badge {
    background: var(--color-section);
    padding: 0.2rem 0.55rem;
    border-radius: 0.45rem;
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--color-phinisi-700);
    letter-spacing: 0.04em;
  }
  /* Filter Tabs */
  .courses-filter-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .filter-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tab-pill {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.4rem 0.95rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--color-muted);
    cursor: pointer;
    transition: all 150ms ease;
    font-family: var(--font-heading);
  }
  .tab-pill:hover {
    color: var(--color-navy);
    border-color: var(--color-phinisi-400);
  }
  .tab-pill.active {
    background: var(--color-primary);
    color: #ffffff;
    border-color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(20, 91, 215, 0.25);
  }

  /* Status Selector */
  .status-selector-wrap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .course-status-select {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
    border: 1px solid #cbd5e1;
    outline: none;
    transition: all 150ms ease;
    font-family: var(--font-heading);
  }
  .status-sync-indicator {
    font-size: 0.68rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .course-item-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }
  .course-item-summary {
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .course-analytics-strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    background: #f8fafc;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    padding: 0.65rem 0.85rem;
  }
  .analytic-item {
    display: flex;
    flex-direction: column;
  }
  .analytic-label {
    font-size: 0.68rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  .analytic-val {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--color-navy);
  }

  .course-stats-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .stat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--color-section);
    padding: 0.25rem 0.55rem;
    border-radius: 0.5rem;
    font-size: 0.74rem;
    color: var(--color-ink);
  }
  .icon-mini {
    font-size: 0.95rem;
  }
  .text-capitalize {
    text-transform: capitalize;
  }

  .course-card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .action-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.65rem;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 120ms ease;
  }
  .action-btn-outline:hover {
    background: var(--color-section);
    border-color: var(--color-phinisi-300);
  }
  .action-btn-primary {
