            <div class="form-group-full">
              <label class="field-label">Berkas Panduan Praktikum PDF (Opsional)</label>
              <div class="input-with-button-row">
                <input type="text" class="studio-input input-pdf-url" placeholder="https://... atau /labs/panduan.pdf" value="${escapeHtml(les.pdfUrl || '')}" />
                <button type="button" class="btn-tool-upload-pdf btn-upload-pkt">
                  <span class="material-symbols-outlined icon-xs">picture_as_pdf</span>
                  <span>Unggah PDF</span>
                </button>
              </div>
            </div>
          </div>

          <div class="editor-toolbar-wrap" style="margin-top: 1.5rem;">
            <span class="toolbar-label">Uraian & Langkah Praktikum (Markdown):</span>
            <button type="button" class="btn-tool btn-tool-upload-image">
              <span class="material-symbols-outlined icon-xs">add_photo_alternate</span>
              <span>+ Diagram Topologi</span>
            </button>
            <button type="button" class="btn-tool btn-tool-cli">
              <span class="material-symbols-outlined icon-xs">terminal</span>
              <span>+ CLI Verifikasi</span>
            </button>
            <button type="button" class="btn-tool btn-tool-callout">
              <span class="material-symbols-outlined icon-xs">info</span>
              <span>+ Catatan Lab</span>
            </button>
          </div>

          <div class="editor-tabs-bar">
            <button type="button" class="editor-subtab active tab-les-write">Tulis Instruksi</button>
            <button type="button" class="editor-subtab tab-les-preview">Pratinjau Instruksi</button>
          </div>

          <div class="editor-workspace-area">
            <textarea class="markdown-editor-box textarea-les-content" rows="12" placeholder="Uraian skenario lab, instruksi pengerjaan, tabel pengalamatan IP, atau kriteria kelulusan praktikum...">${escapeHtml(les.content || '')}</textarea>
            <div class="markdown-preview-box preview-les-content hidden"></div>
          </div>
        </div>
      `;
    }

    function renderQuizEditorHtml(les: LessonItem): string {
      const questions = les.quizQuestions && les.quizQuestions.length > 0 ? les.quizQuestions : [
        {
          id: 1,
          question: 'Pertanyaan evaluasi pemahaman materi:',
          options: ['Jawaban A (Benar)', 'Jawaban B (Pengecoh)', 'Jawaban C (Pengecoh)', 'Jawaban D (Pengecoh)'],
          correctIndex: 0,
          explanation: 'Penjelasan teknis alasan opsi ini tepat.',
        },
      ];
      les.quizQuestions = questions;

      return `
        <div class="quiz-workspace-card">
          <div class="quiz-config-bar">
            <div class="quiz-badge-wrap">
              <span class="material-symbols-outlined icon-quiz">quiz</span>
              <div>
                <strong>Penyusun Soal Kuis Interaktif</strong>
                <span>Tentukan butir pertanyaan, 4 pilihan ganda, dan tandai tombol radio pada jawaban yang benar.</span>
              </div>
            </div>
            <div class="quiz-pass-rate-box">
              <label>Nilai Kelulusan (%):</label>
              <input type="number" class="studio-input input-quiz-pass" min="1" max="100" value="${les.passingScore || 67}" />
            </div>
          </div>

          <div class="quiz-questions-wrap" id="quiz-questions-container">
            ${questions.map((q, qIdx) => `
              <div class="question-builder-item" data-q-idx="${qIdx}">
                <div class="question-header-row">
                  <span class="q-badge">Soal #${qIdx + 1}</span>
                  ${questions.length > 1 ? `
                    <button type="button" class="btn-del-question" data-q-idx="${qIdx}" title="Hapus soal ini">
                      <span class="material-symbols-outlined icon-xs">delete</span>
                    </button>
                  ` : ''}
                </div>

                <div class="q-field-group">
                  <label class="field-label">Teks Pertanyaan <span class="req-star">*</span></label>
                  <input type="text" class="studio-input input-q-text" data-q-idx="${qIdx}" value="${escapeHtml(q.question)}" placeholder="Contoh: Apa fungsi utama routing table?" />
                </div>

                <div class="q-options-container">
                  <label class="field-label">Pilihan Jawaban (Tandai radio button pada jawaban benar):</label>
                  <div class="options-grid">
                    ${['A', 'B', 'C', 'D'].map((letter, optIdx) => `
                      <div class="opt-row ${q.correctIndex === optIdx ? 'is-correct' : ''}">
                        <label class="radio-label">
                          <input type="radio" name="correct-${qIdx}" class="radio-correct-opt" data-q-idx="${qIdx}" data-opt-idx="${optIdx}" ${q.correctIndex === optIdx ? 'checked' : ''} />
                          <span class="letter-badge">${letter}</span>
                        </label>
                        <input type="text" class="studio-input input-opt-text" data-q-idx="${qIdx}" data-opt-idx="${optIdx}" placeholder="Pilihan jawaban ${letter}..." value="${escapeHtml(q.options?.[optIdx] || '')}" />
                      </div>
                    `).join('')}
                  </div>
                </div>

                <div class="q-field-group" style="margin-top: 1rem;">
                  <label class="field-label">Pembahasan Kunci Jawaban</label>
                  <input type="text" class="studio-input input-q-explain" data-q-idx="${qIdx}" value="${escapeHtml(q.explanation || '')}" placeholder="Penjelasan alasan jawaban ini benar..." />
                </div>
              </div>
            `).join('')}
          </div>

          <button type="button" id="btn-add-question" class="btn-add-question-dashed">
            <span class="material-symbols-outlined icon-sm">add_circle</span>
            <span>+ Tambah Butir Soal Kuis</span>
          </button>
        </div>
      `;
    }

    function attachLessonEditorEvents(les: LessonItem) {
      // Title change
      const titleInput = document.querySelector('.input-les-title') as HTMLInputElement | null;
      if (titleInput) {
        titleInput.addEventListener('input', (e) => {
          les.title = (e.target as HTMLInputElement).value;
          renderSyllabusTree();
        });
      }

      // Duration change
      const durInput = document.querySelector('.input-les-duration') as HTMLInputElement | null;
      if (durInput) {
        durInput.addEventListener('input', (e) => {
          les.durationMinutes = Number((e.target as HTMLInputElement).value) || 10;
        });
      }

      // Type change
      const typeSelect = document.querySelector('.select-les-type') as HTMLSelectElement | null;
      if (typeSelect) {
        typeSelect.addEventListener('change', (e) => {
          const newType = (e.target as HTMLSelectElement).value as 'theory' | 'pkt_lab' | 'quiz';
          les.type = newType;
          if (newType === 'pkt_lab') {
            les.xp = currentPreset.labXp;
            les.durationMinutes = 30;
          } else if (newType === 'quiz') {
            les.xp = currentPreset.quizXp;
            les.durationMinutes = 15;
          } else {
            les.xp = currentPreset.theoryXp;
            les.durationMinutes = 10;
          }
          renderSyllabusTree();
          renderActivePanel();
        });
      }

      // Content textarea
      const textarea = document.querySelector('.textarea-les-content') as HTMLTextAreaElement | null;
      const previewBox = document.querySelector('.preview-les-content') as HTMLElement | null;
      const tabWrite = document.querySelector('.tab-les-write') as HTMLButtonElement | null;
      const tabPreview = document.querySelector('.tab-les-preview') as HTMLButtonElement | null;

      if (textarea) {
        textarea.addEventListener('input', (e) => {
          les.content = (e.target as HTMLTextAreaElement).value;
        });
      }

      if (tabWrite && tabPreview && textarea && previewBox) {
        tabWrite.addEventListener('click', () => {
          tabWrite.classList.add('active');
          tabPreview.classList.remove('active');
          textarea.classList.remove('hidden');
          previewBox.classList.add('hidden');
        });

        tabPreview.addEventListener('click', () => {
          tabPreview.classList.add('active');
          tabWrite.classList.remove('active');
          previewBox.innerHTML = parseMarkdownPreview(textarea.value);
          textarea.classList.add('hidden');
          previewBox.classList.remove('hidden');
        });
      }

      // Quick toolbar buttons
      document.querySelectorAll<HTMLButtonElement>('.btn-tool-cli').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (textarea) {
            insertTextAtCursor(textarea, `\n<CommandBlock title="Verifikasi Konfigurasi CLI">\nSwitch# show ip interface brief\nSwitch# show vlan brief\n</CommandBlock>\n`);
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-tool-callout').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (textarea) {
            insertTextAtCursor(textarea, `\n<Callout type="info" title="Catatan Penting">\n  Tuliskan penjelasan konsep kunci atau tip praktis di sini.\n</Callout>\n`);
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-tool-topology').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (textarea) {
            insertTextAtCursor(textarea, `\n<TopologyDiagram\n  caption="Topologi Jaringan Terapan"\n  devices={["Router-01 (Gateway)", "Switch-Core", "PC-Admin", "Server-Phinisi"]}\n/>\n`);
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-tool-heading').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (textarea) {
            insertTextAtCursor(textarea, `\n## Subjudul Bahasan Baru\n\n`);
          }
        });
      });

      // Upload Image in Lesson
      document.querySelectorAll<HTMLButtonElement>('.btn-tool-upload-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          const fileInput = document.getElementById('studio-image-file') as HTMLInputElement | null;
          if (fileInput && textarea) {
            fileInput.onchange = async () => {
              const file = fileInput.files?.[0];
              if (!file) return;
              const fd = new FormData();
              fd.append('image', file);
              fd.append('file', file);
              showBanner('Mengunggah gambar...');
              try {
                const res = await fetch('/api/admin/upload-image', { method: 'POST', body: fd });
                let json: any = null;
                try {
                  json = await res.json();
                } catch {
                  const text = await res.text().catch(() => '');
                  throw new Error(text || `HTTP ${res.status}: Gagal memproses berkas gambar`);
                }
                if (res.ok && json?.url) {
                  insertTextAtCursor(textarea, `\n![${file.name.replace(/\.[^/.]+$/, '')}](${json.url})\n`);
                  showBanner('Gambar berhasil disisipkan.');
                } else {
                  showBanner(json?.error || `Gagal mengunggah gambar (Status ${res.status}).`, true);
                }
              } catch (err: any) {
                showBanner(err.message || 'Gagal mengunggah gambar.', true);
              }
              fileInput.value = '';
            };
            fileInput.click();
          }
        });
      });

      // Lab Inputs (.pkt and PDF)
      const pktUrlInput = document.querySelector('.input-pkt-url') as HTMLInputElement | null;
      if (pktUrlInput) {
        pktUrlInput.addEventListener('input', (e) => {
          les.pktUrl = (e.target as HTMLInputElement).value;
        });
      }

      const pdfUrlInput = document.querySelector('.input-pdf-url') as HTMLInputElement | null;
      if (pdfUrlInput) {
        pdfUrlInput.addEventListener('input', (e) => {
          les.pdfUrl = (e.target as HTMLInputElement).value;
        });
      }

      document.querySelectorAll<HTMLButtonElement>('.btn-tool-upload-pkt').forEach((btn) => {
        btn.addEventListener('click', () => {
          const fileInput = document.getElementById('studio-pkt-file') as HTMLInputElement | null;
          if (fileInput && pktUrlInput) {
            fileInput.onchange = async () => {
              const file = fileInput.files?.[0];
              if (!file) return;
              const fd = new FormData();
              fd.append('file', file);
              fd.append('lab', file);
              showBanner('Mengunggah berkas Packet Tracer (.pkt)...');
              try {
                const res = await fetch('/api/admin/upload-lab', { method: 'POST', body: fd });
                let json: any = null;
                try {
                  json = await res.json();
                } catch {
                  const text = await res.text().catch(() => '');
                  throw new Error(text || `HTTP ${res.status}: Gagal memproses berkas PKT`);
                }
                if (res.ok && json?.url) {
                  pktUrlInput.value = json.url;
                  les.pktUrl = json.url;
                  les.fileNameDownloaded = file.name;
                  showBanner('Berkas .pkt berhasil diunggah.');
                } else {
                  showBanner(json?.error || `Gagal mengunggah berkas .pkt (Status ${res.status}).`, true);
                }
              } catch (err: any) {
                showBanner(err.message || 'Gagal mengunggah .pkt', true);
              }
              fileInput.value = '';
            };
            fileInput.click();
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-tool-upload-pdf').forEach((btn) => {
        btn.addEventListener('click', () => {
          const fileInput = document.getElementById('studio-pdf-file') as HTMLInputElement | null;
          if (fileInput && pdfUrlInput) {
            fileInput.onchange = async () => {
              const file = fileInput.files?.[0];
              if (!file) return;
              const fd = new FormData();
              fd.append('file', file);
              fd.append('lab', file);
              showBanner('Mengunggah berkas panduan PDF...');
              try {
                const res = await fetch('/api/admin/upload-lab', { method: 'POST', body: fd });
                let json: any = null;
                try {
                  json = await res.json();
                } catch {
                  const text = await res.text().catch(() => '');
                  throw new Error(text || `HTTP ${res.status}: Gagal memproses berkas PDF`);
                }
                if (res.ok && json?.url) {
                  pdfUrlInput.value = json.url;
                  les.pdfUrl = json.url;
                  les.pdfFileName = file.name;
                  showBanner('Berkas panduan PDF berhasil diunggah.');
                } else {
                  showBanner(json?.error || `Gagal mengunggah PDF (Status ${res.status}).`, true);
                }
              } catch (err: any) {
                showBanner(err.message || 'Gagal mengunggah PDF', true);
              }
              fileInput.value = '';
            };
            fileInput.click();
          }
        });
      });

      // Quiz events
      const passRateInput = document.querySelector('.input-quiz-pass') as HTMLInputElement | null;
      if (passRateInput) {
        passRateInput.addEventListener('input', (e) => {
          les.passingScore = Number((e.target as HTMLInputElement).value) || 67;
        });
      }

      document.querySelectorAll<HTMLInputElement>('.input-q-text').forEach((input) => {
        input.addEventListener('input', (e) => {
          const qIdx = Number((e.target as HTMLElement).getAttribute('data-q-idx'));
          if (les.quizQuestions && les.quizQuestions[qIdx]) {
            les.quizQuestions[qIdx].question = (e.target as HTMLInputElement).value;
          }
        });
      });

      document.querySelectorAll<HTMLInputElement>('.input-q-explain').forEach((input) => {
        input.addEventListener('input', (e) => {
          const qIdx = Number((e.target as HTMLElement).getAttribute('data-q-idx'));
          if (les.quizQuestions && les.quizQuestions[qIdx]) {
            les.quizQuestions[qIdx].explanation = (e.target as HTMLInputElement).value;
          }
        });
      });

      document.querySelectorAll<HTMLInputElement>('.input-opt-text').forEach((input) => {
        input.addEventListener('input', (e) => {
          const qIdx = Number((e.target as HTMLElement).getAttribute('data-q-idx'));
          const optIdx = Number((e.target as HTMLElement).getAttribute('data-opt-idx'));
          if (les.quizQuestions && les.quizQuestions[qIdx]) {
            if (!les.quizQuestions[qIdx].options) les.quizQuestions[qIdx].options = [];
            les.quizQuestions[qIdx].options[optIdx] = (e.target as HTMLInputElement).value;
          }
        });
      });

      document.querySelectorAll<HTMLInputElement>('.radio-correct-opt').forEach((radio) => {
        radio.addEventListener('change', (e) => {
          const qIdx = Number((e.target as HTMLElement).getAttribute('data-q-idx'));
          const optIdx = Number((e.target as HTMLElement).getAttribute('data-opt-idx'));
          if (les.quizQuestions && les.quizQuestions[qIdx]) {
            les.quizQuestions[qIdx].correctIndex = optIdx;
            renderActivePanel();
          }
        });
      });

      const btnAddQ = document.getElementById('btn-add-question');
      if (btnAddQ) {
        btnAddQ.addEventListener('click', () => {
          if (!les.quizQuestions) les.quizQuestions = [];
          les.quizQuestions.push({
            id: les.quizQuestions.length + 1,
            question: `Pertanyaan #${les.quizQuestions.length + 1}`,
            options: ['Opsi A (Benar)', 'Opsi B', 'Opsi C', 'Opsi D'],
            correctIndex: 0,
            explanation: 'Penjelasan opsi benar.',
          });
          renderActivePanel();
        });
      }

      document.querySelectorAll<HTMLButtonElement>('.btn-del-question').forEach((btn) => {
        btn.addEventListener('click', () => {
          const qIdx = Number(btn.getAttribute('data-q-idx'));
          if (les.quizQuestions && les.quizQuestions.length > 1) {
            les.quizQuestions.splice(qIdx, 1);
            renderActivePanel();
          }
        });
      });
    }

    // Nav Switchers
    const btnSettings = document.getElementById('btn-select-course-settings');
    const btnOverview = document.getElementById('btn-select-overview');

    btnSettings?.addEventListener('click', () => {
      selectedTarget = { type: 'course-settings' };
      renderSyllabusTree();
      renderActivePanel();
    });

    btnOverview?.addEventListener('click', () => {
      selectedTarget = { type: 'overview' };
      renderSyllabusTree();
      renderActivePanel();
    });

    // Add new module button
    const btnAddNewMod = document.getElementById('btn-add-new-module');
    btnAddNewMod?.addEventListener('click', () => {
      const newModId = 'mod-' + Date.now();
      const newModNumber = modulesState.length + 1;
      const newMod: ModuleItem = {
        id: newModId,
        slug: `modul-${newModNumber}`,
        title: `Modul ${newModNumber}: Bahasan Baru`,
        order: newModNumber,
        lessons: [
          {
            id: 'les-' + Date.now(),
            slug: `pelajaran-1`,
            title: `Pelajaran 1: Pokok Bahasan`,
            type: 'theory',
            durationMinutes: 10,
            order: 1,
            xp: currentPreset.theoryXp,
            content: `## Tujuan Pembelajaran\n\nPembahasan modul baru.\n`,
          },
        ],
      };
      modulesState.push(newMod);
      selectedTarget = { type: 'lesson', modId: newModId, lesId: newMod.lessons[0].id };
      renderSyllabusTree();
      renderActivePanel();
    });

    // Overview controls
    const textareaOv = document.getElementById('textarea-overview') as HTMLTextAreaElement | null;
    const previewOv = document.getElementById('preview-overview') as HTMLElement | null;
    const subtabWriteOv = document.getElementById('subtab-write-overview') as HTMLButtonElement | null;
    const subtabPreviewOv = document.getElementById('subtab-preview-overview') as HTMLButtonElement | null;

    subtabWriteOv?.addEventListener('click', () => {
      subtabWriteOv.classList.add('active');
      subtabPreviewOv?.classList.remove('active');
      textareaOv?.classList.remove('hidden');
      previewOv?.classList.add('hidden');
    });

    subtabPreviewOv?.addEventListener('click', () => {
      subtabPreviewOv.classList.add('active');
      subtabWriteOv?.classList.remove('active');
      if (previewOv && textareaOv) {
        previewOv.innerHTML = parseMarkdownPreview(textareaOv.value);
      }
      textareaOv?.classList.add('hidden');
      previewOv?.classList.remove('hidden');
    });

    document.getElementById('tool-callout-overview')?.addEventListener('click', () => {
      if (textareaOv) {
        insertTextAtCursor(textareaOv, `\n<Callout type="info" title="Catatan Pengantar">\n  Tuliskan panduan atau tips belajar di sini.\n</Callout>\n`);
      }
    });

    document.getElementById('tool-heading-overview')?.addEventListener('click', () => {
      if (textareaOv) {
        insertTextAtCursor(textareaOv, `\n## Subjudul Silabus Baru\n\n`);
      }
    });

    document.getElementById('tool-upload-overview')?.addEventListener('click', () => {
      const fileInput = document.getElementById('studio-image-file') as HTMLInputElement | null;
      if (fileInput && textareaOv) {
        fileInput.onchange = async () => {
          const file = fileInput.files?.[0];
          if (!file) return;
          const fd = new FormData();
          fd.append('image', file);
          fd.append('file', file);
          showBanner('Mengunggah gambar...');
          try {
            const res = await fetch('/api/admin/upload-image', { method: 'POST', body: fd });
            let json: any = null;
            try {
              json = await res.json();
            } catch {
              const text = await res.text().catch(() => '');
              throw new Error(text || `HTTP ${res.status}: Gagal memproses gambar`);
            }
            if (res.ok && json?.url) {
              insertTextAtCursor(textareaOv, `\n![${file.name.replace(/\.[^/.]+$/, '')}](${json.url})\n`);
              showBanner('Gambar berhasil disisipkan.');
            } else {
              showBanner(json?.error || `Gagal mengunggah gambar (Status ${res.status}).`, true);
            }
          } catch (err: any) {
            showBanner(err.message || 'Gagal mengunggah gambar.', true);
          }
          fileInput.value = '';
        };
        fileInput.click();
      }
    });

    // Course Title & Slug Auto-Generate
    const titleInput = document.getElementById('input-course-title') as HTMLInputElement | null;
    const slugInput = document.getElementById('input-course-slug') as HTMLInputElement | null;
    const displayTitle = document.getElementById('display-course-title');
    const statusSelect = document.getElementById('input-course-status') as HTMLSelectElement | null;
    const displayStatus = document.getElementById('display-status-badge');

    titleInput?.addEventListener('input', () => {
      const val = titleInput.value.trim();
      if (displayTitle) {
        displayTitle.textContent = val || 'Kursus Baru (Draf)';
      }
      if (!isSlugManualEdited && slugInput) {
        slugInput.value = slugify(val);
      }
    });

    slugInput?.addEventListener('input', () => {
      isSlugManualEdited = true;
    });

    statusSelect?.addEventListener('change', () => {
      const val = statusSelect.value;
      if (displayStatus) {
        displayStatus.setAttribute('data-status', val);
        displayStatus.textContent = val === 'published' ? 'Terpublikasi' : val === 'planned' ? 'Segera Hadir' : 'Draf';
      }
    });

    // Gamification Presets
    document.querySelectorAll<HTMLButtonElement>('.preset-pill-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.preset-pill-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        currentPreset.theoryXp = Number(btn.getAttribute('data-theory')) || 15;
        currentPreset.quizXp = Number(btn.getAttribute('data-quiz')) || 25;
        currentPreset.labXp = Number(btn.getAttribute('data-lab')) || 40;
      });
    });

    // Save New Course
    const btnSave = document.getElementById('btn-save-course') as HTMLButtonElement | null;
    const saveLabel = document.getElementById('save-btn-label');

    btnSave?.addEventListener('click', async () => {
      const titleVal = titleInput?.value.trim() || '';
      if (!titleVal) {
        showBanner('Judul kursus wajib diisi sebelum menyimpan!', true);
        selectedTarget = { type: 'course-settings' };
        renderSyllabusTree();
        renderActivePanel();
        titleInput?.focus();
        return;
      }

      const slugVal = slugify(slugInput?.value.trim() || titleVal);
      if (!slugVal) {
        showBanner('Slug kursus tidak valid!', true);
        return;
      }

      const catVal = (document.getElementById('input-course-category') as HTMLSelectElement)?.value || 'networking';
      const levelVal = (document.getElementById('input-course-level') as HTMLSelectElement)?.value || 'beginner';
      const statusVal = statusSelect?.value || 'draft';
      const durVal = Number((document.getElementById('input-course-duration') as HTMLInputElement)?.value) || 8;
      const descVal = (document.getElementById('input-course-desc') as HTMLTextAreaElement)?.value || '';

      const overviewContentVal = textareaOv?.value || '';

      const payload = {
        title: titleVal,
        slug: slugVal,
        category: catVal,
        level: levelVal,
        status: statusVal,
        durationHours: durVal,
        description: descVal,
        overviewTitle: `Pengantar: ${titleVal}`,
        overviewDuration: 5,
        overviewContent: overviewContentVal,
        modules: modulesState.map((mod, mIdx) => ({
          title: mod.title,
          slug: slugify(mod.title),
          order: mIdx + 1,
          lessons: mod.lessons.map((les, lIdx) => ({
            title: les.title,
            slug: slugify(les.title),
            type: les.type,
            durationMinutes: les.durationMinutes || 10,
            order: lIdx + 1,
            content: les.content || '',
            pktUrl: les.pktUrl || '',
            fileName: les.fileNameDownloaded || `${slugVal}-lab-${lIdx + 1}.pkt`,
            pdfUrl: les.pdfUrl || '',
            pdfFileName: les.pdfFileName || `${slugVal}-panduan-${lIdx + 1}.pdf`,
            passingScore: les.passingScore || 67,
            xp: les.xp || (les.type === 'pkt_lab' ? currentPreset.labXp : les.type === 'quiz' ? currentPreset.quizXp : currentPreset.theoryXp),
            quizQuestions: les.quizQuestions || [],
          })),
        })),
      };

      if (btnSave && saveLabel) {
        btnSave.disabled = true;
        saveLabel.textContent = 'Menyusun Kursus & Berkas...';
      }
      showBanner('Sedang membuat kursus dan menyusun berkas Markdown silabus...');

      try {
        const res = await fetch('/api/admin/courses/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        let json: any = null;
        try {
          json = await res.json();
        } catch {
          const text = await res.text().catch(() => '');
          throw new Error(text || `HTTP ${res.status}: Gagal memproses data server`);
        }

        if (res.ok && json?.success) {
          showBanner(`Kursus '${json.title}' berhasil dibuat! Mengalihkan ke Studio Editor...`);
          setTimeout(() => {
            window.location.href = `/admin/courses/${json.courseSlug}/edit?created=1`;
          }, 800);
        } else {
          showBanner(json?.error || `Gagal membuat kursus (Status ${res.status}).`, true);
          if (btnSave && saveLabel) {
            btnSave.disabled = false;
            saveLabel.textContent = 'Buat Kursus & Simpan Silabus';
          }
        }
      } catch (err: any) {
        showBanner(err.message || 'Terjadi kesalahan sistem.', true);
        if (btnSave && saveLabel) {
          btnSave.disabled = false;
          saveLabel.textContent = 'Buat Kursus & Simpan Silabus';
        }
      }
    });

    // Initial render
    renderSyllabusTree();
    renderActivePanel();
  </script>

