---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Buat Kursus Baru" activeSection="courses">
  <div class="course-creator-container">
    <!-- Top Action Breadcrumb -->
    <div class="creator-breadcrumb-bar">
      <a href="/admin/courses" class="back-link">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Kembali ke Manajemen Kursus</span>
      </a>
      <span class="breadcrumb-current">Wizard Pembuat Kursus</span>
    </div>

    <div class="creator-grid">
      <!-- Kolom Kiri: Formulir Penyusun Kursus & Silabus -->
      <section class="creator-form-col">
        <form id="course-builder-form" class="builder-form">
          <!-- Step 1: Informasi Dasar -->
          <div class="form-card">
            <div class="card-title-row">
              <span class="step-badge">1</span>
              <div>
                <h2 class="card-heading">Informasi Dasar Kursus</h2>
                <p class="card-subheading">Tentukan judul, rumpun keahlian, dan estimasi waktu belajar.</p>
              </div>
            </div>

            <div class="fields-grid">
              <div class="field-group full-width">
                <label for="course-title" class="field-label">Judul Kursus *</label>
                <input
                  type="text"
                  id="course-title"
                  name="title"
                  required
                  placeholder="Contoh: Dasar Switching, VLAN & Inter-VLAN Routing"
                  class="text-input"
                />
              </div>

              <div class="field-group">
                <label for="course-slug" class="field-label">Slug URL (Otomatis)</label>
                <input
                  type="text"
                  id="course-slug"
                  name="slug"
                  placeholder="dasar-switching-vlan"
                  class="text-input font-mono"
                />
                <small class="field-hint">Alamat URL kursus, contoh: /courses/dasar-switching-vlan</small>
              </div>

              <div class="field-group">
                <label for="course-category" class="field-label">Bidang Ilmu / Kategori *</label>
                <select id="course-category" name="category" class="select-input">
                  <option value="networking" selected>Jaringan Komputer (Networking)</option>
                  <option value="linux">Linux & Server Administration</option>
                  <option value="automation">Otomasi Jaringan & Python</option>
                  <option value="iot">Internet of Things (IoT)</option>
                </select>
              </div>

              <div class="field-group">
                <label for="course-level" class="field-label">Tingkat Kemampuan *</label>
                <select id="course-level" name="level" class="select-input">
                  <option value="beginner" selected>Pemula (Beginner)</option>
                  <option value="intermediate">Menengah (Intermediate)</option>
                  <option value="advanced">Lanjutan (Advanced)</option>
                </select>
              </div>

              <div class="field-group">
                <label for="course-duration" class="field-label">Estimasi Waktu (Jam)</label>
                <input
                  type="number"
                  id="course-duration"
                  name="durationHours"
                  value="8"
                  min="1"
                  max="120"
                  class="text-input"
                />
              </div>

              <div class="field-group full-width">
                <label for="course-desc" class="field-label">Deskripsi Singkat Kursus</label>
                <textarea
                  id="course-desc"
                  name="description"
                  rows="3"
                  class="textarea-input"
                  placeholder="Rangkuman kompetensi utama yang akan dikuasai siswa setelah menuntaskan materi dan lab kursus ini..."
                ></textarea>
              </div>

              <div class="field-group full-width">
                <label for="course-status" class="field-label">Status Publikasi Awal</label>
                <select id="course-status" name="status" class="select-input">
                  <option value="draft" selected>Draf (Disimpan, belum tampil di katalog publik siswa)</option>
                  <option value="published">Terpublikasi (Langsung aktif di katalog)</option>
                </select>
                <small class="field-hint">Disarankan tetap Draf sampai materi selesai ditulis di Keystatic.</small>
              </div>
            </div>
          </div>

          <!-- Step 2: Konfigurasi Bobot Nilai XP -->
          <div class="form-card">
            <div class="card-title-row">
              <span class="step-badge">2</span>
              <div>
                <h2 class="card-heading">Konfigurasi Bobot XP & Gamifikasi</h2>
                <p class="card-subheading">Pilih preset poin pengalaman untuk menjaga keseimbangan kenaikan pangkat siswa.</p>
              </div>
            </div>

            <div class="preset-buttons-row">
              <button type="button" class="btn-preset active" data-preset="standard">
                <strong>Standar Phinisi</strong>
                <span>15 XP Teori · 25 XP Kuis · 40 XP Lab</span>
              </button>
              <button type="button" class="btn-preset" data-preset="light">
                <strong>Ringan / Fundamental</strong>
                <span>10 XP Teori · 20 XP Kuis · 30 XP Lab</span>
              </button>
              <button type="button" class="btn-preset" data-preset="heavy">
                <strong>Tantangan Lab Berat</strong>
                <span>20 XP Teori · 35 XP Kuis · 60 XP Lab</span>
              </button>
            </div>

            <div class="xp-custom-row">
              <div class="xp-input-box">
                <label>XP Teori</label>
                <input type="number" id="xp-theory" value="15" min="5" max="100" class="xp-num-input" />
              </div>
              <div class="xp-input-box">
                <label>XP Kuis</label>
                <input type="number" id="xp-quiz" value="25" min="5" max="100" class="xp-num-input" />
              </div>
              <div class="xp-input-box">
                <label>XP Lab .pkt</label>
                <input type="number" id="xp-lab" value="40" min="10" max="200" class="xp-num-input" />
              </div>
              <div class="xp-input-box">
                <label>Bonus Tamat</label>
                <input type="number" id="xp-bonus" value="100" min="0" max="500" class="xp-num-input" readonly />
              </div>
            </div>
          </div>

          <!-- Step 3: Modul & Konten Pembelajaran Terpadu (All-in-One Studio) -->
          <div class="form-card">
            <div class="card-title-row">
              <span class="step-badge">3</span>
              <div class="syllabus-header-between">
                <div>
                  <h2 class="card-heading">Modul & Konten Pembelajaran</h2>
                  <p class="card-subheading">Tambahkan modul dan materi secara fleksibel. Anda dapat langsung menempelkan (paste) teks Markdown (.md), mengunggah foto, memasukkan lab Packet Tracer, atau menyusun kuis langsung di sini.</p>
                </div>
                <button type="button" id="btn-add-module" class="btn-add-primary">
                  <span class="material-symbols-outlined">add_circle</span>
                  <span>Tambah Bab Modul</span>
                </button>
              </div>
            </div>

            <!-- Input Berkas Tersembunyi untuk Unggah Foto, Berkas PKT, dan Panduan PDF -->
            <input type="file" id="global-image-uploader" accept="image/png,image/jpeg,image/webp,image/svg+xml" style="display: none;" />
            <input type="file" id="global-pkt-uploader" accept=".pkt,.pka" style="display: none;" />
            <input type="file" id="global-pdf-uploader" accept=".pdf" style="display: none;" />

            <div id="modules-container" class="modules-tree-wrap">
              <!-- Modul dan materi akan dirender dinamis lewat JavaScript -->
            </div>

            <button type="button" id="btn-add-module-bottom" class="btn-add-module-dashed">
              <span class="material-symbols-outlined">add_circle</span>
              <span>Tambah Bab Modul Baru</span>
            </button>
          </div>

          <div id="submit-error-msg" class="error-banner hidden"></div>

          <!-- Submit Action Area -->
          <div class="form-action-card">
            <div class="action-desc">
              <strong>Simpan & Publikasikan Kursus Lengkap</strong>
              <p>Seluruh materi Markdown, foto yang diunggah, berkas lab Packet Tracer (.pkt), dan butir soal kuis akan disusun ke dalam sistem Phinisi secara instan.</p>
            </div>
            <button type="submit" id="btn-submit-course" class="btn-generate-course">
              <span class="material-symbols-outlined">save</span>
              <span>Simpan Seluruh Kursus & Konten</span>
            </button>
          </div>
        </form>
      </section>

      <!-- Kolom Kanan: Simulator XP Real-Time & Pratinjau -->
      <aside class="creator-preview-col">
        <div class="sticky-preview-wrap">
          <!-- Kotak Simulator XP & Pangkat -->
          <div class="simulator-card">
            <div class="sim-header">
              <span class="material-symbols-outlined icon-sim">military_tech</span>
              <div>
                <span class="sim-kicker">SIMULATOR GAMIFIKASI</span>
                <h3 class="sim-title">Total XP & Proyeksi Pangkat</h3>
              </div>
            </div>

            <div class="sim-stats-grid">
              <div class="sim-stat-item">
                <span class="sim-stat-label">Total Modul</span>
                <strong class="sim-stat-val" id="sim-module-count">1 Bab</strong>
              </div>
              <div class="sim-stat-item">
                <span class="sim-stat-label">Total Pelajaran</span>
                <strong class="sim-stat-val" id="sim-lesson-count">3 Materi</strong>
              </div>
              <div class="sim-stat-item">
                <span class="sim-stat-label">Praktik Lab .pkt</span>
                <strong class="sim-stat-val" id="sim-lab-count">1 Lab</strong>
              </div>
              <div class="sim-stat-item">
                <span class="sim-stat-label">Kuis Evaluasi</span>
                <strong class="sim-stat-val" id="sim-quiz-count">1 Kuis</strong>
              </div>
            </div>

            <div class="total-xp-highlight-box">
              <span class="total-label">Total Hadiah XP Tersedia:</span>
              <strong class="total-val" id="sim-total-xp">180 XP</strong>
              <small class="total-note">(Termasuk Bonus Milestone Tamat +100 XP)</small>
            </div>

            <div class="rank-impact-box">
              <span class="impact-label">Proyeksi Pangkat Siswa Baru:</span>
              <div class="impact-tier-badge" id="sim-projected-tier">
                <span class="material-symbols-outlined icon-tier">sailing</span>
                <strong id="sim-tier-name">Network Helmsman</strong>
              </div>
              <p class="impact-desc" id="sim-tier-desc">
                Siswa baru yang menyelesaikan kursus ini akan langsung naik dari Deck Cadet menjadi Network Helmsman!
              </p>
            </div>
          </div>

          <!-- Pratinjau Kartu Kursus Siswa -->
          <div class="preview-card-box">
            <span class="preview-kicker">PRATINJAU KATALOG SISWA</span>
            <div class="mock-course-card">
              <div class="mock-card-top">
                <span class="mock-cat-badge" id="mock-cat-badge">NETWORKING</span>
                <span class="mock-level-pill" id="mock-level-pill">Beginner</span>
              </div>
              <h4 class="mock-title" id="mock-title">Judul Kursus Baru</h4>
              <p class="mock-desc" id="mock-desc">Deskripsi singkat kursus akan tampil di sini...</p>
              <div class="mock-footer">
                <span class="mock-meta" id="mock-duration">8 Jam</span>
                <span class="mock-meta" id="mock-lesson-stat">3 materi</span>
              </div>
            </div>
          </div>

          <!-- Panduan Studio Terpadu -->
          <div class="keystatic-guide-box">
            <div class="guide-header">
              <span class="material-symbols-outlined icon-guide">auto_stories</span>
              <strong>Studio Terpadu (Satu Tempat)</strong>
            </div>
            <p>
              Seluruh proses pembuatan modul, penulisan materi Markdown (.md), pengunggahan foto, pemasangan tautan lab Packet Tracer (.pkt), hingga pembuatan kuis diselesaikan langsung di halaman ini tanpa perlu berpindah tab atau editor.
            </p>
          </div>
        </div>
      </aside>
    </div>

    <!-- Modal Sukses Pembuatan Kursus -->
    <dialog id="success-modal" class="success-dialog">
      <div class="modal-card">
        <div class="success-icon-wrap">
          <span class="material-symbols-outlined">check_circle</span>
        </div>
        <h3 class="modal-success-title">Kursus Berhasil Disimpan & Diterbitkan!</h3>
        <p class="modal-success-desc" id="success-modal-msg">
          Seluruh modul, materi pelajaran, catatan Markdown, berkas lab Packet Tracer, dan kuis evaluasi telah siap di platform Phinisi.
        </p>

        <div class="modal-action-buttons">
          <a href="#" id="link-preview-web" target="_blank" rel="noopener noreferrer" class="btn-keystatic-primary">
            <span class="material-symbols-outlined">play_circle</span>
            <span>Buka Kursus di Player Siswa</span>
          </a>
          <a href="/admin/courses" class="btn-preview-secondary">
            <span class="material-symbols-outlined">list_alt</span>
            <span>Kembali ke Manajemen Kursus</span>
          </a>
          <a href="#" id="link-open-keystatic" target="_blank" rel="noopener noreferrer" class="btn-back-courses">
            <span>Buka di Keystatic CMS (Opsional)</span>
          </a>
        </div>
      </div>
    </dialog>
  </div>
</AdminLayout>

<script>
  let moduleCount = 0;

  interface QuizQuestionData {
    id: number;
    question: string;
    options: string[];
    correctIndex: number;
    explanation?: string;
  }

  interface LessonData {
    id: number;
    title: string;
    type: 'theory' | 'quiz' | 'pkt_lab';
    durationMinutes: number;
    driveUrl?: string;
    pktUrl?: string;
    fileName?: string;
    pdfUrl?: string;
    pdfFileName?: string;
    content?: string;
    quizQuestions?: QuizQuestionData[];
    passingScore?: number;
    isEditorOpen?: boolean;
  }

  interface ModuleData {
    id: number;
    title: string;
    lessons: LessonData[];
  }

  const modulesState: ModuleData[] = [];
  let activeLessonIdForUpload: number | null = null;
  let activeLessonIdForPktUpload: number | null = null;
  let activeLessonIdForPdfUpload: number | null = null;

  function slugify(text: string): string {
    return text
      .toString()
      .toLowerCase()
      .trim()
      .replace(/\s+/g, '-')
      .replace(/[^\w-]+/g, '')
      .replace(/--+/g, '-')
      .replace(/^-+/, '')
      .replace(/-+$/, '');
  }

  function escapeHtml(text: string): string {
    if (!text) return '';
    return text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function findLesson(lesId: number) {
    for (const mod of modulesState) {
      const les = mod.lessons.find((l) => l.id === lesId);
      if (les) return { mod, les };
    }
    return null;
  }

  function insertTextAtCursor(textarea: HTMLTextAreaElement, text: string) {
    const start = textarea.selectionStart || 0;
    const end = textarea.selectionEnd || 0;
    const val = textarea.value;
    textarea.value = val.substring(0, start) + text + val.substring(end);
    const newPos = start + text.length;
    textarea.focus();
    textarea.setSelectionRange(newPos, newPos);
    textarea.dispatchEvent(new Event('input', { bubbles: true }));
  }

  const titleInput = document.getElementById('course-title') as HTMLInputElement;
  const slugInput = document.getElementById('course-slug') as HTMLInputElement;
  const catSelect = document.getElementById('course-category') as HTMLSelectElement;
  const levelSelect = document.getElementById('course-level') as HTMLSelectElement;
  const durationInput = document.getElementById('course-duration') as HTMLInputElement;
  const descInput = document.getElementById('course-desc') as HTMLTextAreaElement;

  const xpTheoryInput = document.getElementById('xp-theory') as HTMLInputElement;
  const xpQuizInput = document.getElementById('xp-quiz') as HTMLInputElement;
  const xpLabInput = document.getElementById('xp-lab') as HTMLInputElement;
  const xpBonusInput = document.getElementById('xp-bonus') as HTMLInputElement;

  const modulesContainer = document.getElementById('modules-container');
  const addModuleBtn = document.getElementById('btn-add-module');
  const form = document.getElementById('course-builder-form') as HTMLFormElement;
  const submitBtn = document.getElementById('btn-submit-course') as HTMLButtonElement;
  const errorMsg = document.getElementById('submit-error-msg');
  const successModal = document.getElementById('success-modal') as HTMLDialogElement;
  const globalImageUploader = document.getElementById('global-image-uploader') as HTMLInputElement;
  const globalPktUploader = document.getElementById('global-pkt-uploader') as HTMLInputElement;
  const globalPdfUploader = document.getElementById('global-pdf-uploader') as HTMLInputElement;

  // Auto-slug generator
  if (titleInput && slugInput) {
    titleInput.addEventListener('input', () => {
      if (!slugInput.dataset.manualEdit) {
        slugInput.value = slugify(titleInput.value);
      }
      updatePreview();
    });

    slugInput.addEventListener('input', () => {
      slugInput.dataset.manualEdit = 'true';
    });
  }

  // Presets XP
  document.querySelectorAll<HTMLButtonElement>('.btn-preset').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.btn-preset').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      const preset = btn.dataset.preset;
      if (preset === 'standard') {
        xpTheoryInput.value = '15';
        xpQuizInput.value = '25';
        xpLabInput.value = '40';
      } else if (preset === 'light') {
        xpTheoryInput.value = '10';
        xpQuizInput.value = '20';
        xpLabInput.value = '30';
      } else if (preset === 'heavy') {
        xpTheoryInput.value = '20';
        xpQuizInput.value = '35';
        xpLabInput.value = '60';
      }
      updatePreview();
    });
  });

  [catSelect, levelSelect, durationInput, descInput, xpTheoryInput, xpQuizInput, xpLabInput].forEach((el) => {
    if (el) el.addEventListener('input', updatePreview);
  });

  // Global Image Uploader Handler
  if (globalImageUploader) {
    globalImageUploader.addEventListener('change', async () => {
      if (!globalImageUploader.files || globalImageUploader.files.length === 0 || !activeLessonIdForUpload) {
        return;
      }
      const file = globalImageUploader.files[0];
      const targetLesId = activeLessonIdForUpload;
      const lesObj = findLesson(targetLesId);

      const uploadBtn = document.querySelector(`.btn-tool-upload[data-les-id="${targetLesId}"]`) as HTMLButtonElement;
      const originalBtnHtml = uploadBtn ? uploadBtn.innerHTML : '';
      if (uploadBtn) {
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = `<span class="material-symbols-outlined spin-icon">sync</span><span>Mengunggah...</span>`;
      }

      try {
        const formData = new FormData();
        formData.append('image', file);
        const res = await fetch('/api/admin/upload-image', {
          method: 'POST',
          body: formData,
        });
        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Gagal mengunggah foto.');
        }

        const markdownImg = `\n![${data.alt || data.fileName || 'gambar'}](${data.url})\n`;
        const textarea = document.querySelector(`.lesson-builder-item[data-lesson-id="${targetLesId}"] .les-md-textarea`) as HTMLTextAreaElement;
        if (textarea) {
          insertTextAtCursor(textarea, markdownImg);
        } else if (lesObj) {
          lesObj.les.content = (lesObj.les.content || '') + markdownImg;
        }
      } catch (err: any) {
        alert('Gagal mengunggah foto/gambar: ' + (err.message || 'Terjadi kesalahan sistem.'));
      } finally {
        if (uploadBtn) {
          uploadBtn.disabled = false;
          uploadBtn.innerHTML = originalBtnHtml;
        }
        globalImageUploader.value = '';
        activeLessonIdForUpload = null;
      }
    });
  }

  // Global PKT Uploader Handler
  if (globalPktUploader) {
    globalPktUploader.addEventListener('change', async () => {
      if (!globalPktUploader.files || globalPktUploader.files.length === 0 || !activeLessonIdForPktUpload) return;
      const file = globalPktUploader.files[0];
      const targetLesId = activeLessonIdForPktUpload;
      const lesObj = findLesson(targetLesId);

      const uploadBtn = document.querySelector(`.btn-tool-pkt-upload[data-les-id="${targetLesId}"]`) as HTMLButtonElement;
      const originalHtml = uploadBtn ? uploadBtn.innerHTML : '';
      if (uploadBtn) {
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = `<span class="material-symbols-outlined spin-icon">sync</span><span>Mengunggah PKT...</span>`;
      }

      try {
        const formData = new FormData();
        formData.append('file', file);
        const res = await fetch('/api/admin/upload-lab', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal mengunggah berkas .pkt.');

        if (lesObj) {
          lesObj.les.pktUrl = data.url;
          lesObj.les.driveUrl = data.url;
          lesObj.les.fileName = data.originalName || data.fileName;
          renderModules();
        }
      } catch (err: any) {
        alert('Gagal mengunggah berkas .pkt: ' + (err.message || 'Terjadi kesalahan sistem.'));
      } finally {
        if (uploadBtn) {
          uploadBtn.disabled = false;
          uploadBtn.innerHTML = originalHtml;
        }
        globalPktUploader.value = '';
        activeLessonIdForPktUpload = null;
      }
    });
  }

  // Global PDF Uploader Handler
  if (globalPdfUploader) {
    globalPdfUploader.addEventListener('change', async () => {
      if (!globalPdfUploader.files || globalPdfUploader.files.length === 0 || !activeLessonIdForPdfUpload) return;
      const file = globalPdfUploader.files[0];
      const targetLesId = activeLessonIdForPdfUpload;
      const lesObj = findLesson(targetLesId);

      const uploadBtn = document.querySelector(`.btn-tool-pdf-upload[data-les-id="${targetLesId}"]`) as HTMLButtonElement;
      const originalHtml = uploadBtn ? uploadBtn.innerHTML : '';
      if (uploadBtn) {
        uploadBtn.disabled = true;
        uploadBtn.innerHTML = `<span class="material-symbols-outlined spin-icon">sync</span><span>Mengunggah PDF...</span>`;
      }

      try {
        const formData = new FormData();
        formData.append('file', file);
        const res = await fetch('/api/admin/upload-lab', { method: 'POST', body: formData });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Gagal mengunggah berkas .pdf.');

        if (lesObj) {
          lesObj.les.pdfUrl = data.url;
          lesObj.les.pdfFileName = data.originalName || data.fileName;
          renderModules();
        }
      } catch (err: any) {
        alert('Gagal mengunggah berkas PDF: ' + (err.message || 'Terjadi kesalahan sistem.'));
      } finally {
        if (uploadBtn) {
          uploadBtn.disabled = false;
          uploadBtn.innerHTML = originalHtml;
        }
        globalPdfUploader.value = '';
        activeLessonIdForPdfUpload = null;
      }
    });
  }

  function addModule(initialTitle = '') {
    moduleCount++;
    const modId = Date.now() + Math.floor(Math.random() * 1000);
    const modNumber = modulesState.length + 1;
    const defaultTitle = initialTitle || `Modul ${modNumber}: Pembahasan Pokok`;

    const newModule: ModuleData = {
      id: modId,
      title: defaultTitle,
      lessons: [
        {
          id: Date.now() + 1,
          title: `01. Konsep & Arsitektur Modul ${modNumber}`,
          type: 'theory',
          durationMinutes: 10,
          isEditorOpen: true,
          content: `## Pengantar Materi Modul ${modNumber}\n\nMateri ini membahas arsitektur dan prinsip kerja dasar.\n\n> [!NOTE]\n> Pastikan memahami konsep ini sebelum beralih ke simulasi Packet Tracer.\n`,
        },
        {
          id: Date.now() + 2,
          title: `02. Praktik Konfigurasi Modul ${modNumber}`,
          type: 'pkt_lab',
          durationMinutes: 30,
          isEditorOpen: true,
          pktUrl: '',
          driveUrl: '',
          fileName: `lab-modul-${modNumber}.pkt`,
          pdfUrl: '',
          pdfFileName: `panduan-lab-modul-${modNumber}.pdf`,
          content: `The network model in this Packet Tracer activity explores the configuration and verification of network devices.\n\nMost of the devices are already deployed and configured. Follow the instructions and verify connectivity between endpoints using ping test.`,
        },
        {
          id: Date.now() + 3,
          title: `03. Kuis Evaluasi Modul ${modNumber}`,
          type: 'quiz',
          durationMinutes: 15,
          isEditorOpen: true,
          passingScore: 67,
          quizQuestions: [
            {
              id: 1,
              question: `Apa fungsi utama dari topik yang dipelajari pada Modul ${modNumber}?`,
              options: [
                'Meneruskan paket data antar segmen jaringan yang berbeda',
                'Menyimpan konfigurasi startup di memori NVRAM router',
                'Melakukan enkripsi frame pada Physical Layer',
                'Mengatur alokasi tabel MAC address di switch',
              ],
              correctIndex: 0,
              explanation: `Materi pada Modul ${modNumber} membahas prinsip transmisi dan konfigurasi perangkat.`,
            },
          ],
        },
      ],
    };

    modulesState.push(newModule);
    renderModules();
    updatePreview();
  }

  function renderModules() {
    if (!modulesContainer) return;
    modulesContainer.innerHTML = '';

    modulesState.forEach((mod, modIdx) => {
      const moduleCard = document.createElement('div');
