                            </button>
                            <span class="or-text">atau tautan:</span>
                            <input
                              type="text"
                              class="les-pdf-url pkt-input"
                              placeholder="https://... atau /labs/panduan.pdf"
                              value="${escapeHtml(les.pdfUrl || '')}"
                              data-les-id="${les.id}"
                            />
                          </div>
                          <div class="file-status-indicator ${les.pdfUrl ? 'is-ready' : ''}">
                            <span class="material-symbols-outlined icon-check-status">${les.pdfUrl ? 'check_circle' : 'info'}</span>
                            <span class="status-msg">
                              ${les.pdfUrl
                                ? `Panduan PDF terpasang: <strong>${escapeHtml(les.pdfFileName || 'panduan.pdf')}</strong>`
                                : 'Opsional: Dapat diisi jika Anda memiliki dokumen langkah kerja PDF.'}
                            </span>
                          </div>
                        </div>
                      </div>

                      <div class="pkt-instructions-card">
                        <div class="les-toolbar">
                          <span class="toolbar-label">Uraian & Skenario Lab (Markdown):</span>
                          <button type="button" class="btn-tool btn-tool-upload" data-les-id="${les.id}" title="Unggah diagram topologi lab">
                            <span class="material-symbols-outlined icon-xs">add_photo_alternate</span>
                            <span>+ Diagram Topologi</span>
                          </button>
                          <button type="button" class="btn-tool btn-tool-cli" data-les-id="${les.id}" title="Sisipkan blok kode CLI verifikasi">
                            <span class="material-symbols-outlined icon-xs">terminal</span>
                            <span>+ Blok CLI Verifikasi</span>
                          </button>
                          <button type="button" class="btn-tool btn-tool-callout" data-les-id="${les.id}" title="Sisipkan catatan target lab">
                            <span class="material-symbols-outlined icon-xs">info</span>
                            <span>+ Catatan Target</span>
                          </button>
                        </div>
                        <textarea
                          class="les-md-textarea"
                          data-les-id="${les.id}"
                          placeholder="Tulis uraian skenario lab, instruksi pengerjaan, atau target praktikum di sini..."
                          rows="6"
                        >${escapeHtml(les.content || '')}</textarea>
                      </div>
                    </div>
                  ` : ''}

                  ${les.type === 'quiz' ? `
                    <div class="quiz-builder-card">
                      <div class="quiz-builder-header">
                        <div class="quiz-badge-wrap">
                          <span class="material-symbols-outlined icon-quiz">quiz</span>
                          <div>
                            <strong>Penyusun Soal Kuis Interaktif</strong>
                            <span>Tentukan pertanyaan, 4 pilihan ganda, dan tandai bulatan radio untuk kunci jawaban yang benar</span>
                          </div>
                        </div>
                        <div class="quiz-passing-score-wrap">
                          <label>Nilai Kelulusan (%):</label>
                          <input type="number" min="1" max="100" class="les-passing-score" data-les-id="${les.id}" value="${les.passingScore || 67}" />
                        </div>
                      </div>

                      <div class="quiz-questions-list" data-quiz-list="${les.id}">
                        ${(les.quizQuestions || []).map((q, qIdx) => `
                          <div class="quiz-question-card" data-q-id="${q.id}">
                            <div class="q-card-header">
                              <span class="q-index-badge">Soal #${qIdx + 1}</span>
                              ${(les.quizQuestions && les.quizQuestions.length > 1) ? `
                                <button type="button" class="btn-del-q" data-les-id="${les.id}" data-q-id="${q.id}" title="Hapus Soal Ini">
                                  <span class="material-symbols-outlined icon-xs">delete</span>
                                </button>
                              ` : ''}
                            </div>

                            <div class="q-field-group">
                              <label>Teks Pertanyaan <span class="req-star">*</span></label>
                              <input type="text" class="quiz-q-input" data-les-id="${les.id}" data-q-id="${q.id}" placeholder="Contoh: Apa fungsi utama protokol OSPF dalam perutean jaringan?" value="${escapeHtml(q.question)}" />
                            </div>

                            <div class="q-options-container">
                              <label class="q-options-label">Pilihan Ganda (Tandai bulatan radio pada opsi yang benar):</label>
                              <div class="quiz-options-grid">
                                ${['A', 'B', 'C', 'D'].map((letter, optIdx) => `
                                  <div class="quiz-opt-item ${q.correctIndex === optIdx ? 'correct' : ''}">
                                    <label class="opt-radio-label">
                                      <input
                                        type="radio"
                                        name="correct-q-${les.id}-${q.id}"
                                        class="quiz-radio-correct"
                                        data-les-id="${les.id}"
                                        data-q-id="${q.id}"
                                        data-opt-idx="${optIdx}"
                                        ${q.correctIndex === optIdx ? 'checked' : ''}
                                      />
                                      <span class="opt-letter">${letter}</span>
                                    </label>
                                    <input
                                      type="text"
                                      class="quiz-opt-text"
                                      data-les-id="${les.id}"
                                      data-q-id="${q.id}"
                                      data-opt-idx="${optIdx}"
                                      placeholder="Pilihan jawaban ${letter}..."
                                      value="${escapeHtml((q.options && q.options[optIdx]) || '')}"
                                    />
                                  </div>
                                `).join('')}
                              </div>
                            </div>

                            <div class="q-field-group">
                              <label>Penjelasan Kunci Jawaban (Opsional, muncul setelah kuis dinilai):</label>
                              <input type="text" class="quiz-q-explain" data-les-id="${les.id}" data-q-id="${q.id}" placeholder="Contoh: OSPF adalah protokol link-state yang menggunakan algoritma Dijkstra..." value="${escapeHtml(q.explanation || '')}" />
                            </div>
                          </div>
                        `).join('')}
                      </div>

                      <button type="button" class="btn-add-q" data-les-id="${les.id}">
                        <span class="material-symbols-outlined icon-sm">add_circle</span>
                        <span>+ Tambah Butir Soal</span>
                      </button>
                    </div>
                  ` : ''}
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;

      modulesContainer.appendChild(moduleCard);
    });

    // Event listeners
    attachModuleEventListeners();
  }

  function attachModuleEventListeners() {
    // Module title change
    document.querySelectorAll<HTMLInputElement>('.mod-title-input').forEach((input) => {
      input.addEventListener('input', (e) => {
        const card = (e.target as HTMLElement).closest('.module-builder-card');
        const modId = Number(card?.getAttribute('data-module-id'));
        const mod = modulesState.find((m) => m.id === modId);
        if (mod) mod.title = (e.target as HTMLInputElement).value;
        updatePreview();
      });
    });

    // Add lesson button
    document.querySelectorAll<HTMLButtonElement>('.btn-add-lesson').forEach((btn) => {
      btn.addEventListener('click', () => {
        const modId = Number(btn.getAttribute('data-mod-id'));
        const mod = modulesState.find((m) => m.id === modId);
        if (mod) {
          const lesNum = mod.lessons.length + 1;
          mod.lessons.push({
            id: Date.now() + Math.floor(Math.random() * 1000),
            title: `Materi Pelajaran ${lesNum}`,
            type: 'theory',
            durationMinutes: 15,
            isEditorOpen: true,
            content: `## Pengantar Materi\n\nTulis penjelasan materi di sini atau paste dokumentasi Markdown (.md) yang Anda miliki.\n`,
          });
          renderModules();
          updatePreview();
        }
      });
    });

    // Delete module button
    document.querySelectorAll<HTMLButtonElement>('.btn-del-mod').forEach((btn) => {
      btn.addEventListener('click', () => {
        const modId = Number(btn.getAttribute('data-mod-id'));
        const idx = modulesState.findIndex((m) => m.id === modId);
        if (idx !== -1 && modulesState.length > 1) {
          modulesState.splice(idx, 1);
          renderModules();
          updatePreview();
        }
      });
    });

    // Lesson title change
    document.querySelectorAll<HTMLInputElement>('.les-title-input').forEach((input) => {
      input.addEventListener('input', (e) => {
        const item = (e.target as HTMLElement).closest('.lesson-builder-item');
        const card = (e.target as HTMLElement).closest('.module-builder-card');
        const modId = Number(card?.getAttribute('data-module-id'));
        const lesId = Number(item?.getAttribute('data-lesson-id'));
        const mod = modulesState.find((m) => m.id === modId);
        const les = mod?.lessons.find((l) => l.id === lesId);
        if (les) les.title = (e.target as HTMLInputElement).value;
        updatePreview();
      });
    });

    // Lesson type change
    document.querySelectorAll<HTMLSelectElement>('.les-type-select').forEach((select) => {
      select.addEventListener('change', (e) => {
        const item = (e.target as HTMLElement).closest('.lesson-builder-item');
        const card = (e.target as HTMLElement).closest('.module-builder-card');
        const modId = Number(card?.getAttribute('data-module-id'));
        const lesId = Number(item?.getAttribute('data-lesson-id'));
        const mod = modulesState.find((m) => m.id === modId);
        const les = mod?.lessons.find((l) => l.id === lesId);
        if (les) {
          les.type = (e.target as HTMLSelectElement).value as any;
          if (les.type === 'pkt_lab') {
            if (!les.driveUrl) les.driveUrl = '';
            if (!les.fileName) les.fileName = `${slugify(les.title) || 'lab'}.pkt`;
            if (!les.content) {
              les.content = `## Instruksi Lab\n\n1. Unduh berkas **${les.fileName}** di atas.\n2. Buka pada Cisco Packet Tracer dan lakukan konfigurasi.\n`;
            }
          } else if (les.type === 'quiz') {
            if (!les.quizQuestions || les.quizQuestions.length === 0) {
              les.quizQuestions = [
                {
                  id: Date.now(),
                  question: 'Tuliskan butir soal evaluasi pemahaman di sini...',
                  options: ['Pilihan A', 'Pilihan B', 'Pilihan C', 'Pilihan D'],
                  correctIndex: 0,
                  explanation: 'Alasan mengapa pilihan ini benar.',
                },
              ];
            }
            if (!les.passingScore) les.passingScore = 67;
          } else if (les.type === 'theory' && !les.content) {
            les.content = `## Ringkasan Materi\n\nTulis isi materi di sini atau paste dokumentasi Markdown (.md).\n`;
          }
          renderModules();
          updatePreview();
        }
      });
    });

    // Toggle Content Editor Expand/Collapse
    document.querySelectorAll<HTMLButtonElement>('.btn-toggle-editor').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        const lesObj = findLesson(lesId);
        const panel = document.querySelector(`.les-editor-panel[data-editor-for="${lesId}"]`);
        const icon = btn.querySelector('.icon-toggle');
        const textSpan = btn.querySelector('.toggle-text');

        if (lesObj && panel) {
          lesObj.les.isEditorOpen = !lesObj.les.isEditorOpen;
          if (lesObj.les.isEditorOpen) {
            panel.classList.remove('is-closed');
            if (icon) icon.textContent = 'expand_less';
            if (textSpan) textSpan.textContent = 'Tutup Konten';
          } else {
            panel.classList.add('is-closed');
            if (icon) icon.textContent = 'expand_more';
            if (textSpan) textSpan.textContent = 'Buka Konten';
          }
        }
      });
    });

    // Delete lesson button
    document.querySelectorAll<HTMLButtonElement>('.btn-del-les').forEach((btn) => {
      btn.addEventListener('click', () => {
        const modId = Number(btn.getAttribute('data-mod-id'));
        const lesId = Number(btn.getAttribute('data-les-id'));
        const mod = modulesState.find((m) => m.id === modId);
        if (mod && mod.lessons.length > 1) {
          const lIdx = mod.lessons.findIndex((l) => l.id === lesId);
          if (lIdx !== -1) {
            mod.lessons.splice(lIdx, 1);
            renderModules();
            updatePreview();
          }
        }
      });
    });

    // Markdown Textarea change
    document.querySelectorAll<HTMLTextAreaElement>('.les-md-textarea').forEach((ta) => {
      ta.addEventListener('input', (e) => {
        const lesId = Number(ta.getAttribute('data-les-id'));
        const lesObj = findLesson(lesId);
        if (lesObj) lesObj.les.content = (e.target as HTMLTextAreaElement).value;
      });
    });

    // Trigger PKT file upload
    document.querySelectorAll<HTMLButtonElement>('.btn-tool-pkt-upload').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        activeLessonIdForPktUpload = lesId;
        if (globalPktUploader) globalPktUploader.click();
      });
    });

    // Trigger PDF file upload
    document.querySelectorAll<HTMLButtonElement>('.btn-tool-pdf-upload').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        activeLessonIdForPdfUpload = lesId;
        if (globalPdfUploader) globalPdfUploader.click();
      });
    });

    // PKT URL input change
    document.querySelectorAll<HTMLInputElement>('.les-pkt-url').forEach((input) => {
      input.addEventListener('input', (e) => {
        const lesId = Number(input.getAttribute('data-les-id'));
        const lesObj = findLesson(lesId);
        const val = (e.target as HTMLInputElement).value;
        if (lesObj) {
          lesObj.les.pktUrl = val;
          lesObj.les.driveUrl = val;
          if (!lesObj.les.fileName) {
            lesObj.les.fileName = `${slugify(lesObj.les.title) || 'lab'}.pkt`;
          }
        }
      });
    });

    // PDF URL input change
    document.querySelectorAll<HTMLInputElement>('.les-pdf-url').forEach((input) => {
      input.addEventListener('input', (e) => {
        const lesId = Number(input.getAttribute('data-les-id'));
        const lesObj = findLesson(lesId);
        const val = (e.target as HTMLInputElement).value;
        if (lesObj) {
          lesObj.les.pdfUrl = val;
          if (!lesObj.les.pdfFileName) {
            lesObj.les.pdfFileName = `${slugify(lesObj.les.title) || 'panduan'}.pdf`;
          }
        }
      });
    });

    // Passing Score change
    document.querySelectorAll<HTMLInputElement>('.les-passing-score').forEach((input) => {
      input.addEventListener('input', (e) => {
        const lesId = Number(input.getAttribute('data-les-id'));
        const lesObj = findLesson(lesId);
        if (lesObj) lesObj.les.passingScore = Number((e.target as HTMLInputElement).value) || 67;
      });
    });

    // Toolbar Tool Buttons: Upload Image
    document.querySelectorAll<HTMLButtonElement>('.btn-tool-upload').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        activeLessonIdForUpload = lesId;
        if (globalImageUploader) {
          globalImageUploader.click();
        }
      });
    });

    // Toolbar Tool Buttons: Cisco CLI Snippet
    document.querySelectorAll<HTMLButtonElement>('.btn-tool-cli').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        const textarea = document.querySelector(`.lesson-builder-item[data-lesson-id="${lesId}"] .les-md-textarea`) as HTMLTextAreaElement;
        if (textarea) {
          const cliSnippet = `\n\`\`\`cisco\nRouter> enable\nRouter# configure terminal\nRouter(config)# interface gigabitEthernet 0/0\nRouter(config-if)# ip address 192.168.1.1 255.255.255.0\nRouter(config-if)# no shutdown\n\`\`\`\n`;
          insertTextAtCursor(textarea, cliSnippet);
        }
      });
    });

    // Toolbar Tool Buttons: Callout Box
    document.querySelectorAll<HTMLButtonElement>('.btn-tool-callout').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        const textarea = document.querySelector(`.lesson-builder-item[data-lesson-id="${lesId}"] .les-md-textarea`) as HTMLTextAreaElement;
        if (textarea) {
          const calloutSnippet = `\n> [!NOTE]\n> Tulis catatan penting atau petunjuk konfigurasi di sini.\n`;
          insertTextAtCursor(textarea, calloutSnippet);
        }
      });
    });

    // Toolbar Tool Buttons: Heading 2
    document.querySelectorAll<HTMLButtonElement>('.btn-tool-heading').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        const textarea = document.querySelector(`.lesson-builder-item[data-lesson-id="${lesId}"] .les-md-textarea`) as HTMLTextAreaElement;
        if (textarea) {
          const headingSnippet = `\n## Subjudul Pembahasan Baru\n\n`;
          insertTextAtCursor(textarea, headingSnippet);
        }
      });
    });

    // Quiz Question Input change
    document.querySelectorAll<HTMLInputElement>('.quiz-q-input').forEach((input) => {
      input.addEventListener('input', (e) => {
        const lesId = Number(input.getAttribute('data-les-id'));
        const qId = Number(input.getAttribute('data-q-id'));
        const lesObj = findLesson(lesId);
        const q = lesObj?.les.quizQuestions?.find((item) => item.id === qId);
        if (q) q.question = (e.target as HTMLInputElement).value;
      });
    });

    // Quiz Option Text change
    document.querySelectorAll<HTMLInputElement>('.quiz-opt-text').forEach((input) => {
      input.addEventListener('input', (e) => {
        const lesId = Number(input.getAttribute('data-les-id'));
        const qId = Number(input.getAttribute('data-q-id'));
        const optIdx = Number(input.getAttribute('data-opt-idx'));
        const lesObj = findLesson(lesId);
        const q = lesObj?.les.quizQuestions?.find((item) => item.id === qId);
        if (q && q.options) {
          q.options[optIdx] = (e.target as HTMLInputElement).value;
        }
      });
    });

    // Quiz Radio Correct change
    document.querySelectorAll<HTMLInputElement>('.quiz-radio-correct').forEach((radio) => {
      radio.addEventListener('change', () => {
        const lesId = Number(radio.getAttribute('data-les-id'));
        const qId = Number(radio.getAttribute('data-q-id'));
        const optIdx = Number(radio.getAttribute('data-opt-idx'));
        const lesObj = findLesson(lesId);
        const q = lesObj?.les.quizQuestions?.find((item) => item.id === qId);
        if (q) {
          q.correctIndex = optIdx;
          const qCard = radio.closest('.quiz-question-card');
          if (qCard) {
            qCard.querySelectorAll('.quiz-opt-item').forEach((item, idx) => {
              if (idx === optIdx) {
                item.classList.add('correct');
              } else {
                item.classList.remove('correct');
              }
            });
          }
        }
      });
    });

    // Quiz Explanation change
    document.querySelectorAll<HTMLInputElement>('.quiz-q-explain').forEach((input) => {
      input.addEventListener('input', (e) => {
        const lesId = Number(input.getAttribute('data-les-id'));
        const qId = Number(input.getAttribute('data-q-id'));
        const lesObj = findLesson(lesId);
        const q = lesObj?.les.quizQuestions?.find((item) => item.id === qId);
        if (q) q.explanation = (e.target as HTMLInputElement).value;
      });
    });

    // Add Quiz Question Button
    document.querySelectorAll<HTMLButtonElement>('.btn-add-q').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        const lesObj = findLesson(lesId);
        if (lesObj) {
          if (!lesObj.les.quizQuestions) lesObj.les.quizQuestions = [];
          lesObj.les.quizQuestions.push({
            id: Date.now() + Math.floor(Math.random() * 1000),
            question: '',
            options: ['', '', '', ''],
            correctIndex: 0,
            explanation: '',
          });
          renderModules();
        }
      });
    });

    // Delete Quiz Question Button
    document.querySelectorAll<HTMLButtonElement>('.btn-del-q').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lesId = Number(btn.getAttribute('data-les-id'));
        const qId = Number(btn.getAttribute('data-q-id'));
        const lesObj = findLesson(lesId);
        if (lesObj && lesObj.les.quizQuestions && lesObj.les.quizQuestions.length > 1) {
          const qIdx = lesObj.les.quizQuestions.findIndex((item) => item.id === qId);
          if (qIdx !== -1) {
            lesObj.les.quizQuestions.splice(qIdx, 1);
            renderModules();
          }
        }
      });
    });
  }

  function updatePreview() {
    const title = titleInput.value.trim() || 'Judul Kursus Baru';
    const desc = descInput.value.trim() || 'Deskripsi singkat kursus akan tampil di sini...';
    const cat = catSelect.value.toUpperCase();
    const level = levelSelect.value;
    const duration = durationInput.value || '8';

    // Update Mock Course Card
    const mockTitle = document.getElementById('mock-title');
    const mockDesc = document.getElementById('mock-desc');
    const mockCat = document.getElementById('mock-cat-badge');
    const mockLevel = document.getElementById('mock-level-pill');
    const mockDur = document.getElementById('mock-duration');
    const mockLes = document.getElementById('mock-lesson-stat');

    if (mockTitle) mockTitle.textContent = title;
    if (mockDesc) mockDesc.textContent = desc;
    if (mockCat) mockCat.textContent = cat;
    if (mockLevel) mockLevel.textContent = level.charAt(0).toUpperCase() + level.slice(1);
    if (mockDur) mockDur.textContent = `${duration} Jam`;

    // Hitung counts
    let totalLessons = 0;
    let theoryCount = 0;
    let quizCount = 0;
    let labCount = 0;

    modulesState.forEach((mod) => {
      mod.lessons.forEach((les) => {
        totalLessons++;
        if (les.type === 'pkt_lab') labCount++;
        else if (les.type === 'quiz') quizCount++;
        else theoryCount++;
      });
    });

    if (mockLes) mockLes.textContent = `${totalLessons} materi`;

    // Hitung Total XP
    const xpTheory = Number(xpTheoryInput.value) || 15;
    const xpQuiz = Number(xpQuizInput.value) || 25;
    const xpLab = Number(xpLabInput.value) || 40;
    const xpBonus = Number(xpBonusInput.value) || 100;

    const totalXp = (theoryCount * xpTheory) + (quizCount * xpQuiz) + (labCount * xpLab) + xpBonus;

    const simModCount = document.getElementById('sim-module-count');
    const simLesCount = document.getElementById('sim-lesson-count');
    const simLabCount = document.getElementById('sim-lab-count');
    const simQuizCount = document.getElementById('sim-quiz-count');
    const simTotalXp = document.getElementById('sim-total-xp');

    if (simModCount) simModCount.textContent = `${modulesState.length} Bab`;
    if (simLesCount) simLesCount.textContent = `${totalLessons} Materi`;
    if (simLabCount) simLabCount.textContent = `${labCount} Lab`;
    if (simQuizCount) simQuizCount.textContent = `${quizCount} Kuis`;
    if (simTotalXp) simTotalXp.textContent = `${totalXp} XP`;

    // Proyeksi Pangkat Siswa Baru (Mulai dari Deck Cadet 0 XP -> dapat totalXp)
    const tierNameEl = document.getElementById('sim-tier-name');
    const tierDescEl = document.getElementById('sim-tier-desc');

    if (tierNameEl && tierDescEl) {
      if (totalXp >= 1500) {
        tierNameEl.textContent = 'Fleet Admiral';
        tierDescEl.textContent = 'Kursus tingkat master! Siswa yang menuntaskan kursus ini melompat jauh hingga peringkat puncak maritim.';
      } else if (totalXp >= 900) {
        tierNameEl.textContent = 'Fleet Commander';
        tierDescEl.textContent = 'Kursus advance dengan bobot materi sangat mendalam untuk mencetak perwira navigasi.';
      } else if (totalXp >= 500) {
        tierNameEl.textContent = 'Voyage Navigator';
        tierDescEl.textContent = 'Siswa baru yang menyelesaikan kursus ini langsung mencapai pangkat perwira Voyage Navigator!';
      } else if (totalXp >= 150) {
        tierNameEl.textContent = 'Network Helmsman';
        tierDescEl.textContent = 'Siswa baru yang menyelesaikan kursus ini akan langsung naik dari Deck Cadet menjadi Network Helmsman!';
      } else {
        tierNameEl.textContent = 'Deck Cadet';
        tierDescEl.textContent = 'Kursus pengantar cepat untuk memulai perolehan XP awal siswa.';
      }
    }
  }

  // Tambah modul pertama secara default
  addModule('Modul 1: Konsep & Implementasi Dasar');

  if (addModuleBtn) {
    addModuleBtn.addEventListener('click', () => addModule());
  }

  const addModuleBottomBtn = document.getElementById('btn-add-module-bottom');
  if (addModuleBottomBtn) {
    addModuleBottomBtn.addEventListener('click', () => addModule());
  }

  // Form Submission
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!submitBtn) return;

      const title = titleInput.value.trim();
      const slug = slugInput.value.trim() || slugify(title);
      const category = catSelect.value;
      const level = levelSelect.value;
      const durationHours = Number(durationInput.value) || 6;
      const description = descInput.value.trim();
      const status = (document.getElementById('course-status') as HTMLSelectElement).value;

      const xpTheory = Number(xpTheoryInput.value) || 15;
      const xpQuiz = Number(xpQuizInput.value) || 25;
      const xpLab = Number(xpLabInput.value) || 40;

      // Siapkan payload modules lengkap dengan konten Markdown, kuis, dan lab
      const payloadModules = modulesState.map((mod, modIdx) => ({
        title: mod.title,
        slug: slugify(mod.title),
        order: modIdx + 1,
        lessons: mod.lessons.map((les) => {
          let cleanPktName = (les.fileName || `${slugify(les.title)}.pkt`).trim();
          if (!cleanPktName.toLowerCase().endsWith('.pkt') && !cleanPktName.toLowerCase().endsWith('.pka')) {
            cleanPktName += '.pkt';
          }

          let cleanPdfName = (les.pdfFileName || `${slugify(les.title)}-panduan.pdf`).trim();
          if (!cleanPdfName.toLowerCase().endsWith('.pdf')) {
            cleanPdfName += '.pdf';
          }

          return {
            title: les.title,
            slug: slugify(les.title),
            type: les.type,
            durationMinutes: les.durationMinutes || 15,
            xp: les.type === 'pkt_lab' ? xpLab : les.type === 'quiz' ? xpQuiz : xpTheory,
            pktUrl: les.pktUrl || les.driveUrl || '',
            driveUrl: les.driveUrl || les.pktUrl || '',
            fileName: cleanPktName,
            pdfUrl: les.pdfUrl || '',
            pdfFileName: cleanPdfName,
            content: les.content || '',
            quizQuestions: les.quizQuestions || [],
            passingScore: les.passingScore || 67,
          };
        }),
      }));

      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <span class="material-symbols-outlined spin-icon">sync</span>
        <span>Menyusun Berkas Kursus & Konten...</span>
      `;
      if (errorMsg) {
        errorMsg.textContent = '';
        errorMsg.classList.add('hidden');
      }

      try {
        const res = await fetch('/api/admin/courses/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            title,
            slug,
            category,
            level,
            durationHours,
            description,
            status,
            modules: payloadModules,
          }),
        });

        const data = await res.json();
        if (!res.ok) {
          throw new Error(data.error || 'Gagal membuat kursus baru.');
        }

        // Tampilkan Modal Sukses
        const keystaticLink = document.getElementById('link-open-keystatic') as HTMLAnchorElement;
        const previewLink = document.getElementById('link-preview-web') as HTMLAnchorElement;
        const modalMsg = document.getElementById('success-modal-msg');

        if (keystaticLink) keystaticLink.href = data.keystaticUrl;
        if (previewLink) previewLink.href = data.learnUrl || data.previewUrl;
        if (modalMsg) {
          modalMsg.textContent = `Kursus '${data.title}' berhasil dibuat lengkap dengan ${data.totalLessonsCreated} berkas materi pembelajaran. Seluruh catatan Markdown, kuis interaktif, dan berkas lab Cisco Packet Tracer telah terbit dan siap diakses!`;
        }

        if (successModal) {
          successModal.showModal();
        }
      } catch (err: any) {
        if (errorMsg) {
          errorMsg.textContent = err.message || 'Terjadi kesalahan sistem saat membuat kursus.';
          errorMsg.classList.remove('hidden');
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = `
          <span class="material-symbols-outlined">rocket_launch</span>
          <span>Simpan Seluruh Kursus & Konten</span>
        `;
      }
    });
  }
</script>

