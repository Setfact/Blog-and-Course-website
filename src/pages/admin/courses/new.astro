          <div class="editor-toolbar-wrap">
            <span class="toolbar-label">Tombol Cepat:</span>
            <button type="button" class="btn-tool btn-tool-upload-image" title="Unggah foto langsung ke materi">
              <span class="material-symbols-outlined icon-xs">add_photo_alternate</span>
              <span>+ Unggah Foto / Gambar</span>
            </button>
            <button type="button" class="btn-tool btn-tool-cli" title="Sisipkan jendela perintah terminal Cisco">
              <span class="material-symbols-outlined icon-xs">terminal</span>
              <span>+ Blok CLI Cisco</span>
            </button>
            <button type="button" class="btn-tool btn-tool-callout" title="Sisipkan kotak catatan penting">
              <span class="material-symbols-outlined icon-xs">info</span>
              <span>+ Kotak Catatan (Callout)</span>
            </button>
            <button type="button" class="btn-tool btn-tool-topology" title="Sisipkan diagram topologi jaringan">
              <span class="material-symbols-outlined icon-xs">hub</span>
              <span>+ Diagram Topologi</span>
            </button>
            <button type="button" class="btn-tool btn-tool-heading" title="Sisipkan subjudul">
              <span class="material-symbols-outlined icon-xs">title</span>
              <span>+ Subjudul (##)</span>
            </button>
          </div>

          <div class="editor-tabs-bar">
            <button type="button" class="editor-subtab active tab-les-write">Tulis Markdown</button>
            <button type="button" class="editor-subtab tab-les-preview">Pratinjau Langsung</button>
          </div>

          <div class="editor-workspace-area">
            <textarea class="markdown-editor-box textarea-les-content" rows="18" placeholder="Tulis uraian materi atau paste catatan Markdown Anda di sini...">${escapeHtml(les.content || '')}</textarea>
            <div class="markdown-preview-box preview-les-content hidden"></div>
          </div>
        </div>
      `;
    }

    function renderLabEditorHtml(les: LessonItem): string {
      return `
        <div class="lab-workspace-card">
          <div class="lab-config-header">
            <span class="material-symbols-outlined icon-pkt">terminal</span>
            <div>
              <strong>Praktikum Simulasi Cisco Packet Tracer</strong>
              <p>Siswa dapat mengunduh berkas .pkt untuk dikonfigurasi di software Packet Tracer beserta panduan pengerjaan.</p>
            </div>
          </div>

          <div class="form-grid-two">
            <div class="form-group-full">
              <label class="field-label">Berkas Simulasi Packet Tracer (.pkt / .pka) <span class="req-star">*</span></label>
              <div class="input-with-button-row">
                <input type="text" class="studio-input input-pkt-url" placeholder="https://drive.google.com/... atau /labs/..." value="${escapeHtml(les.pktUrl || '')}" />
                <button type="button" class="btn-tool-upload-pkt btn-upload-pkt">
                  <span class="material-symbols-outlined icon-xs">upload_file</span>
                  <span>Unggah .pkt</span>
                </button>
              </div>
              <small class="field-hint">Masukkan tautan Google Drive atau pilih berkas langsung dari komputer.</small>
