    function attachLessonEditorEvents(les: LessonItem) {
      // Title change
      const titleInput = document.querySelector('.input-les-title') as HTMLInputElement | null;
      if (titleInput) {
        titleInput.addEventListener('input', (e) => {
          les.title = (e.target as HTMLInputElement).value;
          renderSyllabusTree();
        });
      }

      // Duration change
      const durInput = document.querySelector('.input-les-duration') as HTMLInputElement | null;
      if (durInput) {
        durInput.addEventListener('input', (e) => {
          les.durationMinutes = Number((e.target as HTMLInputElement).value) || 10;
        });
      }

      // Type change
      const typeSelect = document.querySelector('.select-les-type') as HTMLSelectElement | null;
      if (typeSelect) {
        typeSelect.addEventListener('change', (e) => {
          les.type = (e.target as HTMLSelectElement).value as any;
          if (les.type === 'quiz' && (!les.quizQuestions || les.quizQuestions.length === 0)) {
            les.quizQuestions = [
              {
                id: 1,
                question: 'Pertanyaan kuis baru?',
                options: ['Pilihan A (Benar)', 'Pilihan B', 'Pilihan C', 'Pilihan D'],
                correctIndex: 0,
                explanation: 'Penjelasan kunci jawaban.',
              },
            ];
          }
          renderSyllabusTree();
          renderActivePanel();
        });
      }

      // Markdown Textarea
      const textarea = document.querySelector('.textarea-les-content') as HTMLTextAreaElement | null;
      const previewBox = document.querySelector('.preview-les-content') as HTMLElement | null;
      const tabWrite = document.querySelector('.tab-les-write') as HTMLElement | null;
      const tabPreview = document.querySelector('.tab-les-preview') as HTMLElement | null;

      if (textarea) {
        textarea.addEventListener('input', () => {
          les.content = textarea.value;
          if (previewBox && !previewBox.classList.contains('hidden')) {
            previewBox.innerHTML = parseMarkdownToHtml(textarea.value);
          }
        });
      }

      if (tabWrite && tabPreview && textarea && previewBox) {
        tabWrite.addEventListener('click', () => {
          tabWrite.classList.add('active');
          tabPreview.classList.remove('active');
          textarea.classList.remove('hidden');
          previewBox.classList.add('hidden');
        });

        tabPreview.addEventListener('click', () => {
          tabPreview.classList.add('active');
          tabWrite.classList.remove('active');
          textarea.classList.add('hidden');
          previewBox.classList.remove('hidden');
          previewBox.innerHTML = parseMarkdownToHtml(textarea.value);
        });
      }

      // Tool buttons
      document.querySelectorAll<HTMLButtonElement>('.btn-tool-cli').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (textarea) {
            insertTextAtCursor(
              textarea,
              `\n<CommandBlock\n  title="Cisco IOS"\n  prompt="Router#"\n  command="show ip interface brief"\n  output="Interface                  IP-Address      OK? Method Status   Protocol\\nGigabitEthernet0/0/0       192.168.1.1     YES manual up       up"\n/>\n`
            );
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-tool-callout').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (textarea) {
            insertTextAtCursor(
              textarea,
              `\n<Callout type="info" title="Informasi Penting">\n  Tuliskan catatan penting atau tips teknis di sini.\n</Callout>\n`
            );
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-tool-topology').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (textarea) {
            insertTextAtCursor(
              textarea,
              `\n<TopologyDiagram\n  title="Topologi Latihan"\n  caption="Skema koneksi antara Switch dan Router"\n  leftLabel="LAN Pengguna"\n  centerLabel="Router Utama"\n  rightLabel="Server Internal"\n/>\n`
            );
          }
        });
      });

      document.querySelectorAll<HTMLButtonElement>('.btn-tool-heading').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (textarea) {
            insertTextAtCursor(textarea, `\n## Subjudul Pembahasan Baru\n\n`);
          }
        });
      });

      // Upload image button
      const hiddenImgInput = document.getElementById('studio-image-file') as HTMLInputElement | null;
      document.querySelectorAll<HTMLButtonElement>('.btn-tool-upload-image').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (hiddenImgInput) {
            hiddenImgInput.onchange = async () => {
              if (!hiddenImgInput.files || hiddenImgInput.files.length === 0) return;
              const file = hiddenImgInput.files[0];
              const formData = new FormData();
              formData.append('image', file);
              btn.disabled = true;
              btn.innerHTML = `<span class="material-symbols-outlined spin-icon">sync</span> Mengunggah...`;

              try {
                const res = await fetch('/api/admin/upload-image', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.url && textarea) {
                  insertTextAtCursor(textarea, `\n![${data.alt || 'gambar'}](${data.url})\n`);
                } else {
                  alert(data.error || 'Gagal mengunggah gambar.');
                }
              } catch {
                alert('Terjadi kesalahan jaringan.');
              } finally {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined icon-xs">add_photo_alternate</span> <span>+ Unggah Foto / Gambar</span>`;
                hiddenImgInput.value = '';
              }
            };
            hiddenImgInput.click();
          }
        });
      });

      // Upload PKT button
      const hiddenPktInput = document.getElementById('studio-pkt-file') as HTMLInputElement | null;
      document.querySelectorAll<HTMLButtonElement>('.btn-tool-upload-pkt').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (hiddenPktInput) {
            hiddenPktInput.onchange = async () => {
              if (!hiddenPktInput.files || hiddenPktInput.files.length === 0) return;
              const file = hiddenPktInput.files[0];
              const formData = new FormData();
              formData.append('file', file);
              btn.disabled = true;
              btn.innerHTML = `<span class="material-symbols-outlined spin-icon">sync</span> Mengunggah...`;

              try {
                const res = await fetch('/api/admin/upload-lab', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.url) {
                  const pktUrlInput = document.querySelector('.input-pkt-url') as HTMLInputElement | null;
                  if (pktUrlInput) pktUrlInput.value = data.url;
                  les.pktUrl = data.url;
                  les.fileNameDownloaded = data.fileName;
                } else {
                  alert(data.error || 'Gagal mengunggah berkas PKT.');
                }
              } catch {
                alert('Terjadi kesalahan jaringan.');
              } finally {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined icon-xs">upload_file</span> <span>Unggah .pkt</span>`;
                hiddenPktInput.value = '';
              }
            };
            hiddenPktInput.click();
          }
        });
      });

      // Upload PDF button
      const hiddenPdfInput = document.getElementById('studio-pdf-file') as HTMLInputElement | null;
      document.querySelectorAll<HTMLButtonElement>('.btn-tool-upload-pdf').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (hiddenPdfInput) {
            hiddenPdfInput.onchange = async () => {
              if (!hiddenPdfInput.files || hiddenPdfInput.files.length === 0) return;
              const file = hiddenPdfInput.files[0];
              const formData = new FormData();
              formData.append('file', file);
              btn.disabled = true;
              btn.innerHTML = `<span class="material-symbols-outlined spin-icon">sync</span> Mengunggah...`;

              try {
                const res = await fetch('/api/admin/upload-lab', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.url) {
                  const pdfUrlInput = document.querySelector('.input-pdf-url') as HTMLInputElement | null;
                  if (pdfUrlInput) pdfUrlInput.value = data.url;
                  les.pdfUrl = data.url;
                  les.pdfFileName = data.fileName;
                } else {
                  alert(data.error || 'Gagal mengunggah panduan PDF.');
                }
              } catch {
                alert('Terjadi kesalahan jaringan.');
              } finally {
                btn.disabled = false;
                btn.innerHTML = `<span class="material-symbols-outlined icon-xs">picture_as_pdf</span> <span>Unggah PDF</span>`;
                hiddenPdfInput.value = '';
              }
            };
            hiddenPdfInput.click();
          }
        });
      });

      // Lab input changes
      const pktUrlInput = document.querySelector('.input-pkt-url') as HTMLInputElement | null;
      if (pktUrlInput) {
        pktUrlInput.addEventListener('input', (e) => {
          les.pktUrl = (e.target as HTMLInputElement).value;
        });
      }

      const pdfUrlInput = document.querySelector('.input-pdf-url') as HTMLInputElement | null;
      if (pdfUrlInput) {
        pdfUrlInput.addEventListener('input', (e) => {
          les.pdfUrl = (e.target as HTMLInputElement).value;
        });
      }

      // Quiz events
      const passRateInput = document.querySelector('.input-quiz-pass') as HTMLInputElement | null;
      if (passRateInput) {
        passRateInput.addEventListener('input', (e) => {
          les.passingScore = Number((e.target as HTMLInputElement).value) || 67;
        });
      }

      document.querySelectorAll<HTMLInputElement>('.input-q-text').forEach((input) => {
        input.addEventListener('input', (e) => {
          const qIdx = Number(input.getAttribute('data-q-idx'));
          if (les.quizQuestions && les.quizQuestions[qIdx]) {
            les.quizQuestions[qIdx].question = (e.target as HTMLInputElement).value;
          }
        });
      });

      document.querySelectorAll<HTMLInputElement>('.radio-correct-opt').forEach((radio) => {
        radio.addEventListener('change', () => {
          const qIdx = Number(radio.getAttribute('data-q-idx'));
          const optIdx = Number(radio.getAttribute('data-opt-idx'));
          if (les.quizQuestions && les.quizQuestions[qIdx]) {
            les.quizQuestions[qIdx].correctIndex = optIdx;
            const parent = radio.closest('.options-grid');
            parent?.querySelectorAll('.opt-row').forEach((r, i) => {
              if (i === optIdx) r.classList.add('is-correct');
              else r.classList.remove('is-correct');
            });
          }
        });
      });

      document.querySelectorAll<HTMLInputElement>('.input-opt-text').forEach((input) => {
        input.addEventListener('input', (e) => {
          const qIdx = Number(input.getAttribute('data-q-idx'));
          const optIdx = Number(input.getAttribute('data-opt-idx'));
          if (les.quizQuestions && les.quizQuestions[qIdx]) {
            if (!les.quizQuestions[qIdx].options) les.quizQuestions[qIdx].options = [];
            les.quizQuestions[qIdx].options[optIdx] = (e.target as HTMLInputElement).value;
          }
        });
      });

      document.querySelectorAll<HTMLInputElement>('.input-q-explain').forEach((input) => {
        input.addEventListener('input', (e) => {
          const qIdx = Number(input.getAttribute('data-q-idx'));
          if (les.quizQuestions && les.quizQuestions[qIdx]) {
            les.quizQuestions[qIdx].explanation = (e.target as HTMLInputElement).value;
          }
        });
      });

      // Delete question
      document.querySelectorAll<HTMLButtonElement>('.btn-del-question').forEach((btn) => {
        btn.addEventListener('click', () => {
          const qIdx = Number(btn.getAttribute('data-q-idx'));
          if (les.quizQuestions && les.quizQuestions.length > 1) {
            les.quizQuestions.splice(qIdx, 1);
            renderActivePanel();
          }
        });
      });

      // Add question
      const addQBtn = document.getElementById('btn-add-question');
      if (addQBtn) {
        addQBtn.addEventListener('click', () => {
          if (!les.quizQuestions) les.quizQuestions = [];
          les.quizQuestions.push({
            id: Date.now(),
            question: `Pertanyaan kuis baru #${les.quizQuestions.length + 1}?`,
            options: ['Pilihan Jawaban A (Kunci Benar)', 'Pilihan Jawaban B', 'Pilihan Jawaban C', 'Pilihan Jawaban D'],
            correctIndex: 0,
            explanation: 'Pembahasan teknis jawaban yang benar.',
          });
          renderActivePanel();
        });
      }
    }

    // Top buttons and overview panel events
    const btnSelectSettings = document.getElementById('btn-select-course-settings');
    const btnSelectOverview = document.getElementById('btn-select-overview');
    const btnAddNewMod = document.getElementById('btn-add-new-module');

    btnSelectSettings?.addEventListener('click', () => {
      selectedTarget = { type: 'course-settings' };
      renderSyllabusTree();
      renderActivePanel();
    });

    btnSelectOverview?.addEventListener('click', () => {
      selectedTarget = { type: 'overview' };
      renderSyllabusTree();
      renderActivePanel();
    });

    btnAddNewMod?.addEventListener('click', () => {
      const newModOrder = modulesState.length + 1;
      const newModId = `${courseData.courseSlug}-${String(newModOrder).padStart(2, '0')}-modul-${newModOrder}`;
      const newModule: ModuleItem = {
        id: newModId,
        slug: newModId,
        title: `Modul ${newModOrder}: Topik Bahasan Baru`,
        order: newModOrder,
        description: '',
        lessons: [
          {
            id: Date.now(),
            slug: `pelajaran-1`,
            fileName: '',
            title: `01. Pengantar Modul ${newModOrder}`,
            type: 'theory',
            durationMinutes: 10,
            order: 1,
            content: `## Pendahuluan Modul ${newModOrder}\n\nTuliskan rangkuman dan sasaran pembelajaran modul ini.\n`,
          },
        ],
      };
      modulesState.push(newModule);
      selectedTarget = { type: 'lesson', modId: newModule.id, lesId: newModule.lessons[0].id };
      renderSyllabusTree();
      renderActivePanel();
    });

    // Overview Markdown Events
    const textareaOverview = document.getElementById('textarea-overview') as HTMLTextAreaElement | null;
    const previewOverview = document.getElementById('preview-overview') as HTMLElement | null;
    const subtabWriteOverview = document.getElementById('subtab-write-overview') as HTMLElement | null;
    const subtabPreviewOverview = document.getElementById('subtab-preview-overview') as HTMLElement | null;

    if (textareaOverview) {
      textareaOverview.addEventListener('input', () => {
        courseData.overviewContent = textareaOverview.value;
        if (previewOverview && !previewOverview.classList.contains('hidden')) {
          previewOverview.innerHTML = parseMarkdownToHtml(textareaOverview.value);
        }
      });
    }

    if (subtabWriteOverview && subtabPreviewOverview && textareaOverview && previewOverview) {
      subtabWriteOverview.addEventListener('click', () => {
        subtabWriteOverview.classList.add('active');
        subtabPreviewOverview.classList.remove('active');
        textareaOverview.classList.remove('hidden');
        previewOverview.classList.add('hidden');
      });

      subtabPreviewOverview.addEventListener('click', () => {
        subtabPreviewOverview.classList.add('active');
        subtabWriteOverview.classList.remove('active');
        textareaOverview.classList.add('hidden');
        previewOverview.classList.remove('hidden');
        previewOverview.innerHTML = parseMarkdownToHtml(textareaOverview.value);
      });
    }

    const toolUploadOverview = document.getElementById('tool-upload-overview');
    const toolCalloutOverview = document.getElementById('tool-callout-overview');
    const toolHeadingOverview = document.getElementById('tool-heading-overview');
    const hiddenImgInput = document.getElementById('studio-image-file') as HTMLInputElement | null;

    toolCalloutOverview?.addEventListener('click', () => {
      if (textareaOverview) {
        insertTextAtCursor(textareaOverview, `\n<Callout type="info" title="Selamat Datang!">\n  Selamat datang di kursus ini. Silakan ikuti seluruh silabus modul.\n</Callout>\n`);
      }
    });

    toolHeadingOverview?.addEventListener('click', () => {
      if (textareaOverview) {
        insertTextAtCursor(textareaOverview, `\n## Ringkasan Silabus\n\n`);
      }
    });

    toolUploadOverview?.addEventListener('click', () => {
      if (hiddenImgInput) {
        hiddenImgInput.onchange = async () => {
          if (!hiddenImgInput.files || hiddenImgInput.files.length === 0) return;
          const file = hiddenImgInput.files[0];
          const formData = new FormData();
          formData.append('image', file);
          try {
            const res = await fetch('/api/admin/upload-image', { method: 'POST', body: formData });
            const data = await res.json();
            if (data.url && textareaOverview) {
              insertTextAtCursor(textareaOverview, `\n![${data.alt || 'sampul'}](${data.url})\n`);
            }
          } catch {
            alert('Gagal mengunggah foto.');
          } finally {
            hiddenImgInput.value = '';
          }
        };
        hiddenImgInput.click();
      }
    });

    // Save All Course & Materials Action
    const saveBtn = document.getElementById('btn-save-course') as HTMLButtonElement | null;
    const saveBtnLabel = document.getElementById('save-btn-label');
    const banner = document.getElementById('studio-alert-banner');

    function showBanner(message: string, isError = false) {
      if (!banner) return;
      banner.className = `studio-banner ${isError ? 'banner-error' : 'banner-success'}`;
      banner.textContent = message;
      banner.classList.remove('hidden');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      if (!isError) {
        setTimeout(() => banner.classList.add('hidden'), 5000);
      }
    }

    if (saveBtn) {
      saveBtn.addEventListener('click', async () => {
        saveBtn.disabled = true;
        if (saveBtnLabel) saveBtnLabel.textContent = 'Menyimpan ke Server...';

        // Gather Course Settings
        const titleInput = document.getElementById('input-course-title') as HTMLInputElement | null;
        const catSelect = document.getElementById('input-course-category') as HTMLSelectElement | null;
        const levelSelect = document.getElementById('input-course-level') as HTMLSelectElement | null;
        const statusSelect = document.getElementById('input-course-status') as HTMLSelectElement | null;
        const durInput = document.getElementById('input-course-duration') as HTMLInputElement | null;
        const descInput = document.getElementById('input-course-desc') as HTMLTextAreaElement | null;

        const payload = {
          courseSlug: courseData.courseSlug,
          title: titleInput ? titleInput.value.trim() : courseData.title,
          category: catSelect ? catSelect.value : courseData.category,
          level: levelSelect ? levelSelect.value : courseData.level,
          status: statusSelect ? statusSelect.value : courseData.status,
          durationHours: durInput ? Number(durInput.value) || 6 : courseData.durationHours,
          description: descInput ? descInput.value.trim() : courseData.description,
          cover: courseData.cover,
          tools: courseData.tools,
          outcomes: courseData.outcomes,
          overviewContent: textareaOverview ? textareaOverview.value : courseData.overviewContent,
          modules: modulesState,
        };

        try {
          const res = await fetch('/api/admin/courses/update', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            showBanner(`Perubahan pada kursus '${payload.title}' dan seluruh materinya berhasil disimpan!`);
            const displayTitle = document.getElementById('display-course-title');
            if (displayTitle) displayTitle.textContent = payload.title;
            const displayBadge = document.getElementById('display-status-badge');
            if (displayBadge) {
              displayBadge.setAttribute('data-status', payload.status);
              displayBadge.textContent = payload.status === 'published' ? 'Terpublikasi' : payload.status === 'planned' ? 'Segera Hadir' : 'Draf';
            }
          } else {
            showBanner(data.error || 'Gagal menyimpan perubahan kursus.', true);
          }
        } catch (err: any) {
          showBanner('Terjadi gangguan jaringan saat menyimpan kursus.', true);
        } finally {
          saveBtn.disabled = false;
          if (saveBtnLabel) saveBtnLabel.textContent = 'Simpan Semua Perubahan';
        }
      });
    }

    // Initial render
    renderSyllabusTree();
    renderActivePanel();
  </script>

