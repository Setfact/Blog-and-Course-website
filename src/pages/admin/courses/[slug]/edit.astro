---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import fs from 'node:fs';
import path from 'node:path';
import yaml from 'yaml';

const { slug: courseSlug } = Astro.params;
const user = Astro.locals.user;
if (!user || user.role !== 'admin') {
  return Astro.redirect('/login');
}

if (!courseSlug) {
  return Astro.redirect('/admin/courses');
}

const projectRoot = process.cwd();
const coursesDir = path.join(projectRoot, 'src/content/courses');
const courseFilePath = path.join(coursesDir, `${courseSlug}.mdx`);

if (!fs.existsSync(courseFilePath)) {
  return Astro.redirect('/admin/courses');
}

// 1. Baca metadata kursus
const courseRaw = fs.readFileSync(courseFilePath, 'utf-8');
const courseMatch = courseRaw.match(/^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n([\s\S]*))?/);
const courseFrontmatter = courseMatch ? yaml.parse(courseMatch[1]) : {};
const courseIntro = courseMatch?.[2]?.trim() || '';

// 2. Baca overview lesson (index.mdx)
const docsCourseDir = path.join(projectRoot, 'src/content/docs', courseSlug);
const overviewPath = path.join(docsCourseDir, 'index.mdx');
let overviewFrontmatter: any = {};
let overviewBody = '';
if (fs.existsSync(overviewPath)) {
  try {
    const ovRaw = fs.readFileSync(overviewPath, 'utf-8');
    const ovMatch = ovRaw.match(/^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n([\s\S]*))?/);
    overviewFrontmatter = ovMatch ? yaml.parse(ovMatch[1]) : {};
    overviewBody = ovMatch?.[2]?.trim() || '';
  } catch {}
}

// 3. Baca modul kursus
const modulesDir = path.join(projectRoot, 'src/content/modules');
const rawModules: any[] = [];
if (fs.existsSync(modulesDir)) {
  try {
    const allModFiles = fs.readdirSync(modulesDir);
    for (const mf of allModFiles) {
      if (!mf.endsWith('.md') && !mf.endsWith('.mdx')) continue;
      try {
        const mRaw = fs.readFileSync(path.join(modulesDir, mf), 'utf-8');
        const mMatch = mRaw.match(/^---\r?\n([\s\S]*?)\r?\n---/);
        if (mMatch) {
          const parsed = yaml.parse(mMatch[1]);
          if (parsed?.course === courseSlug) {
            rawModules.push({
              id: mf.replace(/\.(md|mdx)$/, ''),
              slug: mf.replace(/\.(md|mdx)$/, ''),
              title: parsed.title || mf,
              order: Number(parsed.order) || 999,
              description: parsed.description || '',
            });
          }
        }
      } catch {}
    }
  } catch {}
}
rawModules.sort((a, b) => a.order - b.order);

// 4. Baca pelajaran (lessons) kursus
const rawLessons: any[] = [];
if (fs.existsSync(docsCourseDir)) {
  try {
    const allDocFiles = fs.readdirSync(docsCourseDir);
    for (const df of allDocFiles) {
      if (df === 'index.mdx' || df === 'index.md') continue;
      if (!df.endsWith('.md') && !df.endsWith('.mdx')) continue;
      try {
        const dRaw = fs.readFileSync(path.join(docsCourseDir, df), 'utf-8');
        const dMatch = dRaw.match(/^---\r?\n([\s\S]*?)\r?\n---(?:\r?\n([\s\S]*))?/);
        if (dMatch) {
          const parsed = yaml.parse(dMatch[1]);
          const body = dMatch[2]?.trim() || '';

          let type: 'theory' | 'pkt_lab' | 'quiz' = 'theory';
          let pktUrl = '';
          let driveUrl = '';
          let fileName = '';
          let pdfUrl = '';
          let pdfFileName = '';
          let passingScore = 67;
          let xp = 15;
          let quizQuestions: any[] = [];
          let cleanContent = body;

          if (body.includes('<PacketTracerLab')) {
            type = 'pkt_lab';
            xp = 40;
            const pktMatch = body.match(/pktUrl=(?:\{?"([^"]+)"\}?|\{([^\}]+)\})/);
            if (pktMatch) pktUrl = pktMatch[1] || pktMatch[2] || '';
            const fileMatch = body.match(/fileName=(?:\{?"([^"]+)"\}?|\{([^\}]+)\})/);
            if (fileMatch) fileName = fileMatch[1] || fileMatch[2] || '';
            const pdfMatch = body.match(/pdfUrl=(?:\{?"([^"]+)"\}?|\{([^\}]+)\})/);
            if (pdfMatch) pdfUrl = pdfMatch[1] || pdfMatch[2] || '';
            const pdfFileMatch = body.match(/pdfFileName=(?:\{?"([^"]+)"\}?|\{([^\}]+)\})/);
            if (pdfFileMatch) pdfFileName = pdfFileMatch[1] || pdfFileMatch[2] || '';
            const xpMatch = body.match(/xp=\{?(\d+)\}?/);
            if (xpMatch) xp = Number(xpMatch[1]);
            cleanContent = body.replace(/<PacketTracerLab[\s\S]*?\/>/, '').trim();
          } else if (body.includes('<LessonQuiz')) {
            type = 'quiz';
            xp = 25;
            const passMatch = body.match(/passingScore=\{?(\d+)\}?/);
            if (passMatch) passingScore = Number(passMatch[1]);
            const xpMatch = body.match(/xp=\{?(\d+)\}?/);
            if (xpMatch) xp = Number(xpMatch[1]);
            const qMatch = body.match(/questions=\{([\s\S]*?)\}\s*\/>/);
            if (qMatch) {
              try {
                quizQuestions = JSON.parse(qMatch[1]);
              } catch {}
            }
            cleanContent = body.replace(/<LessonQuiz[\s\S]*?\/>/, '').trim();
          }

          rawLessons.push({
            id: df.replace(/\.(md|mdx)$/, ''),
            fileName: df,
            slug: df.replace(/\.(md|mdx)$/, ''),
            moduleSlug: parsed.module || '',
            title: parsed.title || df,
            order: Number(parsed.order) || 999,
            durationMinutes: Number(parsed.durationMinutes) || 10,
            type,
            content: cleanContent,
            pktUrl,
            driveUrl,
            fileNameDownloaded: fileName,
            pdfUrl,
            pdfFileName,
            passingScore,
            xp,
            quizQuestions,
          });
        }
      } catch {}
    }
  } catch {}
}

// 5. Susun modul dan pelajaran
let initialModules = rawModules.map((mod) => {
  const modLessons = rawLessons
    .filter((l: any) => l.moduleSlug === mod.slug)
    .sort((a: any, b: any) => a.order - b.order);
  return {
    ...mod,
    lessons: modLessons,
  };
});

if (initialModules.length === 0) {
  initialModules = [
    {
      id: `${courseSlug}-01-modul-1`,
      slug: `${courseSlug}-01-modul-1`,
      title: 'Modul 1: Materi & Praktik',
      order: 1,
      description: '',
      lessons: rawLessons.sort((a: any, b: any) => a.order - b.order),
    },
  ];
} else {
  // Masukkan pelajaran yang belum terpetakan ke modul pertama
  const assigned = new Set(initialModules.flatMap((m: any) => m.lessons.map((l: any) => l.fileName)));
  const unassigned = rawLessons.filter((l: any) => !assigned.has(l.fileName));
  if (unassigned.length > 0) {
    initialModules[0].lessons.push(...unassigned);
  }
}

// Format deskripsi jika tersimpan sebagai objek teks terlokalisasi
let descriptionText = '';
if (typeof courseFrontmatter.description === 'string') {
  descriptionText = courseFrontmatter.description;
} else if (courseFrontmatter.description?.id) {
  descriptionText = courseFrontmatter.description.id;
}

const initialCourseData = {
  courseSlug,
  title: courseFrontmatter.title || courseSlug,
  category: courseFrontmatter.category || 'networking',
  level: courseFrontmatter.level || 'beginner',
  durationHours: Number(courseFrontmatter.durationHours) || 6,
  status: courseFrontmatter.status || 'draft',
  description: descriptionText,
  cover: courseFrontmatter.cover || '/images/courses/security-fundamentals.webp',
  tools: courseFrontmatter.tools || ['Cisco IOS', 'Cisco Packet Tracer'],
  outcomes: courseFrontmatter.outcomes || [],
  overviewTitle: overviewFrontmatter.title || `Pengantar: ${courseFrontmatter.title || courseSlug}`,
  overviewDuration: Number(overviewFrontmatter.durationMinutes) || 5,
  overviewContent: overviewBody || courseIntro || '',
  modules: initialModules,
};

const queryLesson = Astro.url.searchParams.get('lesson') || '';
---

<AdminLayout title={`Studio Editor: ${initialCourseData.title}`} activeSection="courses">
  <div class="studio-container" data-course-slug={courseSlug} data-focus-lesson={queryLesson}>
    <!-- Top Action Bar -->
    <header class="studio-topbar">
      <div class="topbar-left">
        <a href="/admin/courses" class="btn-back-link">
          <span class="material-symbols-outlined">arrow_back</span>
          <span>Kembali ke Manajemen Kursus</span>
        </a>
        <div class="course-header-meta">
          <h1 class="studio-course-title" id="display-course-title">{initialCourseData.title}</h1>
          <span class="status-badge" id="display-status-badge" data-status={initialCourseData.status}>
            {initialCourseData.status === 'published' ? 'Terpublikasi' : initialCourseData.status === 'planned' ? 'Segera Hadir' : 'Draf'}
          </span>
        </div>
      </div>

      <div class="topbar-right">
        <a href={`/courses/${courseSlug}`} target="_blank" rel="noopener noreferrer" class="btn-topbar-secondary" title="Buka Halaman Detail Kursus">
          <span class="material-symbols-outlined icon-sm">visibility</span>
          <span>Lihat di Web</span>
        </a>
        <a href={`/learn/${courseSlug}`} target="_blank" rel="noopener noreferrer" class="btn-topbar-secondary" title="Buka Player Siswa">
          <span class="material-symbols-outlined icon-sm">play_circle</span>
          <span>Player Siswa</span>
        </a>
        <a href={`/keystatic/collection/courses/item/${courseSlug}`} target="_blank" rel="noopener noreferrer" class="btn-topbar-subtle" title="Buka di Keystatic CMS (Cadangan)">
          <span class="material-symbols-outlined icon-sm">open_in_new</span>
          <span>Keystatic</span>
        </a>
        <button type="button" id="btn-save-course" class="btn-save-primary">
          <span class="material-symbols-outlined icon-sm">save</span>
          <span id="save-btn-label">Simpan Semua Perubahan</span>
        </button>
      </div>
    </header>

    <!-- Alert / Toast Banner -->
    <div id="studio-alert-banner" class="studio-banner hidden"></div>

    <!-- Main Studio Split View -->
    <div class="studio-workspace">
      <!-- Kolom Kiri: Navigasi Silabus (Daftar Bab & Pelajaran) -->
      <aside class="syllabus-sidebar">
        <div class="syllabus-sidebar-header">
          <div class="sidebar-title-row">
            <span class="material-symbols-outlined icon-syllabus">account_tree</span>
            <div>
              <h2 class="sidebar-heading">Silabus Kursus</h2>
              <span class="sidebar-subheading" id="sidebar-stats-label">Menghitung materi...</span>
            </div>
          </div>
          <button type="button" id="btn-select-course-settings" class="nav-item-btn" data-target="course-settings">
            <span class="material-symbols-outlined icon-sm">tune</span>
            <span>Pengaturan Informasi Kursus</span>
          </button>
          <button type="button" id="btn-select-overview" class="nav-item-btn" data-target="overview">
            <span class="material-symbols-outlined icon-sm">article</span>
            <span>Pengantar & Silabus (Overview)</span>
          </button>
        </div>

        <div class="syllabus-tree-container" id="syllabus-tree">
          <!-- Modul dan Pelajaran dirender via JavaScript -->
        </div>

        <div class="syllabus-sidebar-footer">
          <button type="button" id="btn-add-new-module" class="btn-add-module-outline">
            <span class="material-symbols-outlined icon-sm">add_circle</span>
            <span>Tambah Bab Modul Baru</span>
          </button>
        </div>
      </aside>

      <!-- Kolom Kanan: Canvas Editor Utama -->
      <main class="editor-canvas">
        <!-- Panel 1: Pengaturan Kursus -->
        <section id="panel-course-settings" class="editor-panel-section hidden">
          <div class="panel-card-header">
            <div class="panel-header-icon-box">
              <span class="material-symbols-outlined">tune</span>
            </div>
            <div>
              <h2 class="panel-title">Pengaturan Informasi Kursus</h2>
              <p class="panel-desc">Perbarui judul resmi, kategori, tingkat kemampuan, dan status publikasi kursus ini.</p>
            </div>
          </div>

          <div class="form-grid-two">
            <div class="form-group-full">
              <label for="input-course-title" class="field-label">Judul Kursus <span class="req-star">*</span></label>
              <input type="text" id="input-course-title" class="studio-input" value={initialCourseData.title} required />
            </div>

            <div class="form-group">
              <label for="input-course-category" class="field-label">Bidang Ilmu / Kategori <span class="req-star">*</span></label>
              <select id="input-course-category" class="studio-select">
                <option value="networking" selected={initialCourseData.category === 'networking'}>Jaringan Komputer (Networking)</option>
                <option value="linux" selected={initialCourseData.category === 'linux'}>Linux & Server Administration</option>
                <option value="automation" selected={initialCourseData.category === 'automation'}>Otomasi Jaringan & Python</option>
                <option value="iot" selected={initialCourseData.category === 'iot'}>Internet of Things (IoT)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="input-course-level" class="field-label">Tingkat Kemampuan <span class="req-star">*</span></label>
              <select id="input-course-level" class="studio-select">
                <option value="beginner" selected={initialCourseData.level === 'beginner'}>Pemula (Beginner)</option>
                <option value="intermediate" selected={initialCourseData.level === 'intermediate'}>Menengah (Intermediate)</option>
                <option value="advanced" selected={initialCourseData.level === 'advanced'}>Lanjutan (Advanced)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="input-course-status" class="field-label">Status Publikasi <span class="req-star">*</span></label>
              <select id="input-course-status" class="studio-select">
                <option value="published" selected={initialCourseData.status === 'published'}>Terpublikasi (Aktif di Web Siswa)</option>
                <option value="planned" selected={initialCourseData.status === 'planned'}>Segera Hadir (Planned / Coming Soon)</option>
                <option value="draft" selected={initialCourseData.status === 'draft'}>Draf (Hanya Terlihat oleh Admin)</option>
                <option value="archived" selected={initialCourseData.status === 'archived'}>Arsip (Disembunyikan)</option>
              </select>
            </div>

            <div class="form-group">
              <label for="input-course-duration" class="field-label">Estimasi Waktu Belajar (Jam)</label>
              <input type="number" id="input-course-duration" class="studio-input" min="1" max="200" value={initialCourseData.durationHours} />
            </div>

            <div class="form-group-full">
              <label for="input-course-desc" class="field-label">Deskripsi Singkat Kursus</label>
              <textarea id="input-course-desc" class="studio-textarea" rows="3" placeholder="Rangkuman kompetensi utama kursus ini...">{initialCourseData.description}</textarea>
            </div>
          </div>
        </section>

        <!-- Panel 2: Pengantar & Overview Kursus -->
        <section id="panel-overview" class="editor-panel-section hidden">
          <div class="panel-card-header">
            <div class="panel-header-icon-box">
              <span class="material-symbols-outlined">article</span>
            </div>
            <div>
              <h2 class="panel-title">Halaman Pengantar Kursus (Overview)</h2>
              <p class="panel-desc">Materi ini tampil sebagai sambutan pertama dan ringkasan silabus saat siswa membuka player belajar.</p>
            </div>
          </div>

          <div class="editor-toolbar-wrap">
            <span class="toolbar-label">Sisipkan Cepat:</span>
            <button type="button" class="btn-tool" id="tool-upload-overview" title="Unggah foto langsung ke materi pengantar">
              <span class="material-symbols-outlined icon-xs">add_photo_alternate</span>
              <span>+ Unggah Foto</span>
            </button>
            <button type="button" class="btn-tool" id="tool-callout-overview" title="Sisipkan kotak catatan pengantar">
              <span class="material-symbols-outlined icon-xs">info</span>
              <span>+ Kotak Catatan</span>
            </button>
            <button type="button" class="btn-tool" id="tool-heading-overview" title="Sisipkan subjudul bab">
              <span class="material-symbols-outlined icon-xs">title</span>
              <span>+ Subjudul (##)</span>
            </button>
          </div>

          <div class="editor-tabs-bar">
            <button type="button" class="editor-subtab active" id="subtab-write-overview">Tulis Markdown</button>
            <button type="button" class="editor-subtab" id="subtab-preview-overview">Pratinjau Tampilan</button>
          </div>

          <div class="editor-workspace-area">
            <textarea id="textarea-overview" class="markdown-editor-box" rows="16" placeholder="Tuliskan kata sambutan, prasyarat, atau panduan belajar kursus ini dalam format Markdown...">{initialCourseData.overviewContent}</textarea>
            <div id="preview-overview" class="markdown-preview-box hidden"></div>
          </div>
        </section>

        <!-- Panel 3: Editor Materi Pelajaran Aktif (Dynamic Lesson Editor) -->
        <section id="panel-lesson" class="editor-panel-section">
          <div id="lesson-editor-content">
            <!-- Konten editor materi aktif dirender via JavaScript -->
          </div>
        </section>
      </main>
    </div>

    <!-- Hidden Global File Inputs untuk Upload Cepat -->
    <input type="file" id="studio-image-file" accept="image/png,image/jpeg,image/webp,image/svg+xml" style="display: none;" />
    <input type="file" id="studio-pkt-file" accept=".pkt,.pka" style="display: none;" />
    <input type="file" id="studio-pdf-file" accept=".pdf" style="display: none;" />
  </div>

  <!-- Data Awal Kursus (Injeksi Aman SSR ke Klien) -->
  <script is:inline type="application/json" id="raw-initial-data" set:html={JSON.stringify(initialCourseData)}></script>

  <script>
    interface LessonItem {
      id: string | number;
      slug: string;
      fileName: string;
      title: string;
      type: 'theory' | 'pkt_lab' | 'quiz';
      durationMinutes: number;
      order: number;
      content: string;
      pktUrl?: string;
      driveUrl?: string;
      fileNameDownloaded?: string;
      pdfUrl?: string;
      pdfFileName?: string;
      tasks?: string[];
      passingScore?: number;
      xp?: number;
      quizQuestions?: Array<{
        id: number;
        question: string;
        options: string[];
        correctIndex: number;
        explanation: string;
      }>;
    }

    interface ModuleItem {
      id: string | number;
      slug: string;
      title: string;
      order: number;
      description: string;
      lessons: LessonItem[];
    }

    const rawDataEl = document.getElementById('raw-initial-data');
    const courseData = rawDataEl ? JSON.parse(rawDataEl.textContent || '{}') : {};

    let modulesState: ModuleItem[] = courseData.modules || [];
    let selectedTarget: { type: 'course-settings' | 'overview' | 'lesson'; modId?: string | number; lesId?: string | number } = {
      type: 'course-settings',
    };

    const container = document.querySelector('.studio-container') as HTMLElement;
    const focusLessonParam = container?.dataset.focusLesson || '';

    // Auto-select lesson if passed in query param
    if (focusLessonParam) {
      for (const mod of modulesState) {
        const found = mod.lessons.find((l) => l.slug === focusLessonParam || l.fileName === focusLessonParam || l.fileName.includes(focusLessonParam));
        if (found) {
          selectedTarget = { type: 'lesson', modId: mod.id, lesId: found.id };
          break;
        }
      }
    } else if (modulesState.length > 0 && modulesState[0].lessons.length > 0) {
      selectedTarget = { type: 'lesson', modId: modulesState[0].id, lesId: modulesState[0].lessons[0].id };
    }

    function escapeHtml(text: string): string {
      if (!text) return '';
      return text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function parseMarkdownToHtml(md: string): string {
      if (!md) return '<p class="empty-hint">Belum ada materi yang ditulis.</p>';
      let html = md;

      // Handle Callout
      html = html.replace(/<Callout\s+type="([^"]+)"(?:\s+title="([^"]*)")?>([\s\S]*?)<\/Callout>/g, (_, type, title, body) => {
        return `<div class="preview-callout callout-${type}">
          ${title ? `<strong>${title}</strong>` : ''}
          <div>${body}</div>
        </div>`;
      });

      // Handle CommandBlock
      html = html.replace(/<CommandBlock[\s\S]*?command="([^"]*)"[\s\S]*?(?:title="([^"]*)")?[\s\S]*?\/>/g, (_, cmd, title) => {
        return `<div class="preview-cli-block">
          ${title ? `<div class="cli-title">${title}</div>` : ''}
          <pre><code>${cmd}</code></pre>
        </div>`;
      });

      // Headings
      html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
      html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
      html = html.replace(/^# (.*$)/gim, '<h1>$1</h1>');

      // Images & Links
      html = html.replace(/!\[(.*?)\]\((.*?)\)/gim, '<img alt="$1" src="$2" class="preview-img" />');
      html = html.replace(/\[(.*?)\]\((.*?)\)/gim, '<a href="$2" target="_blank">$1</a>');

      // Bold & Italic
      html = html.replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>');
      html = html.replace(/\*(.*?)\*/gim, '<em>$1</em>');

      // Code blocks
      html = html.replace(/```([\s\S]*?)```/gim, '<pre><code>$1</code></pre>');

      // Line breaks to paragraphs
      html = html.replace(/\n\n+/g, '</p><p>');
      return `<p>${html}</p>`;
    }

    function insertTextAtCursor(textarea: HTMLTextAreaElement, text: string) {
      const start = textarea.selectionStart || 0;
      const end = textarea.selectionEnd || 0;
      const val = textarea.value;
      textarea.value = val.substring(0, start) + text + val.substring(end);
      const newPos = start + text.length;
      textarea.focus();
      textarea.setSelectionRange(newPos, newPos);
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // Render tree sidebar
    function renderSyllabusTree() {
      const treeEl = document.getElementById('syllabus-tree');
      const statsEl = document.getElementById('sidebar-stats-label');
      if (!treeEl) return;

      const totalLessons = modulesState.reduce((acc, m) => acc + m.lessons.length, 0);
      if (statsEl) {
        statsEl.textContent = `${modulesState.length} Bab Modul · ${totalLessons} Pelajaran`;
      }

      treeEl.innerHTML = '';

      modulesState.forEach((mod, modIdx) => {
        const modCard = document.createElement('div');
        modCard.className = 'tree-module-group';
        modCard.dataset.modId = String(mod.id);

        modCard.innerHTML = `
          <div class="tree-module-header">
            <div class="mod-header-title-box">
              <span class="mod-num-badge">Bab ${modIdx + 1}</span>
              <input type="text" class="mod-title-inline-input" value="${escapeHtml(mod.title)}" title="Klik untuk mengubah judul modul" />
            </div>
            <div class="mod-header-actions-inline">
              <button type="button" class="btn-tree-action btn-add-les-to-mod" data-mod-id="${mod.id}" title="Tambah materi ke bab ini">
                <span class="material-symbols-outlined icon-xs">add</span>
              </button>
              ${modulesState.length > 1 ? `
                <button type="button" class="btn-tree-action btn-del-mod" data-mod-id="${mod.id}" title="Hapus bab modul ini">
                  <span class="material-symbols-outlined icon-xs">delete</span>
                </button>
              ` : ''}
            </div>
          </div>

          <div class="tree-lessons-list">
            ${mod.lessons.map((les, lesIdx) => {
              const isSelected = selectedTarget.type === 'lesson' && String(selectedTarget.modId) === String(mod.id) && String(selectedTarget.lesId) === String(les.id);
              const typeClass = les.type === 'pkt_lab' ? 'pill-lab' : les.type === 'quiz' ? 'pill-quiz' : 'pill-theory';
              const typeText = les.type === 'pkt_lab' ? 'Lab PKT' : les.type === 'quiz' ? 'Kuis' : 'Teori';

              return `
                <div class="tree-lesson-item ${isSelected ? 'is-active' : ''}" data-mod-id="${mod.id}" data-les-id="${les.id}">
                  <div class="les-item-clickable" data-mod-id="${mod.id}" data-les-id="${les.id}">
                    <span class="les-num">${String(lesIdx + 1).padStart(2, '0')}</span>
                    <span class="les-title-label">${escapeHtml(les.title)}</span>
                    <span class="les-type-pill ${typeClass}">${typeText}</span>
                  </div>
                  ${mod.lessons.length > 1 ? `
                    <button type="button" class="btn-del-les-tree" data-mod-id="${mod.id}" data-les-id="${les.id}" title="Hapus materi ini">
                      <span class="material-symbols-outlined icon-xs">close</span>
                    </button>
                  ` : ''}
                </div>
              `;
            }).join('')}
          </div>
        `;

        treeEl.appendChild(modCard);
      });

      attachTreeEvents();
    }

    function attachTreeEvents() {
      // Mod title change
      document.querySelectorAll<HTMLInputElement>('.mod-title-inline-input').forEach((input) => {
        input.addEventListener('input', (e) => {
          const card = (e.target as HTMLElement).closest('.tree-module-group');
          const modId = card?.getAttribute('data-mod-id');
          const mod = modulesState.find((m) => String(m.id) === String(modId));
          if (mod) mod.title = (e.target as HTMLInputElement).value;
        });
      });

      // Add lesson to module
      document.querySelectorAll<HTMLButtonElement>('.btn-add-les-to-mod').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const modId = btn.getAttribute('data-mod-id');
          const mod = modulesState.find((m) => String(m.id) === String(modId));
          if (mod) {
            const newLesId = Date.now();
            const newLesson: LessonItem = {
              id: newLesId,
              slug: `pelajaran-${mod.lessons.length + 1}`,
              fileName: '',
              title: `Pelajaran Baru ${mod.lessons.length + 1}`,
              type: 'theory',
              durationMinutes: 10,
              order: mod.lessons.length + 1,
              content: `## Tujuan Pembelajaran\n\nMateri ini membahas konsep dan implementasi terapan.\n\n<Callout type="info" title="Catatan Pembuka">\n  Silakan pelajari langkah-langkah di bawah secara berurutan.\n</Callout>\n`,
            };
            mod.lessons.push(newLesson);
            selectedTarget = { type: 'lesson', modId: mod.id, lesId: newLesId };
            renderSyllabusTree();
            renderActivePanel();
          }
        });
      });

      // Delete module
      document.querySelectorAll<HTMLButtonElement>('.btn-del-mod').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (!confirm('Apakah Anda yakin ingin menghapus bab modul ini beserta seluruh materi di dalamnya?')) return;
          const modId = btn.getAttribute('data-mod-id');
          const idx = modulesState.findIndex((m) => String(m.id) === String(modId));
          if (idx !== -1 && modulesState.length > 1) {
            modulesState.splice(idx, 1);
            if (modulesState[0]?.lessons[0]) {
              selectedTarget = { type: 'lesson', modId: modulesState[0].id, lesId: modulesState[0].lessons[0].id };
            } else {
              selectedTarget = { type: 'course-settings' };
            }
            renderSyllabusTree();
            renderActivePanel();
          }
        });
      });

      // Click lesson item
      document.querySelectorAll<HTMLElement>('.les-item-clickable').forEach((el) => {
        el.addEventListener('click', () => {
          const modId = el.getAttribute('data-mod-id');
          const lesId = el.getAttribute('data-les-id');
          if (modId && lesId) {
            selectedTarget = { type: 'lesson', modId, lesId };
            renderSyllabusTree();
            renderActivePanel();
          }
        });
      });

      // Delete lesson
      document.querySelectorAll<HTMLButtonElement>('.btn-del-les-tree').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (!confirm('Hapus materi pelajaran ini?')) return;
          const modId = btn.getAttribute('data-mod-id');
          const lesId = btn.getAttribute('data-les-id');
          const mod = modulesState.find((m) => String(m.id) === String(modId));
          if (mod && mod.lessons.length > 1) {
            const lIdx = mod.lessons.findIndex((l) => String(l.id) === String(lesId));
            if (lIdx !== -1) {
              mod.lessons.splice(lIdx, 1);
              const nextLes = mod.lessons[0];
              selectedTarget = { type: 'lesson', modId: mod.id, lesId: nextLes.id };
              renderSyllabusTree();
              renderActivePanel();
            }
          }
        });
      });
    }

    // Render panel active
    function renderActivePanel() {
      const panelSettings = document.getElementById('panel-course-settings');
      const panelOverview = document.getElementById('panel-overview');
      const panelLesson = document.getElementById('panel-lesson');
      const lessonEditorContent = document.getElementById('lesson-editor-content');

      const btnSettings = document.getElementById('btn-select-course-settings');
      const btnOverview = document.getElementById('btn-select-overview');

      btnSettings?.classList.remove('is-active');
      btnOverview?.classList.remove('is-active');

      panelSettings?.classList.add('hidden');
      panelOverview?.classList.add('hidden');
      panelLesson?.classList.add('hidden');

      if (selectedTarget.type === 'course-settings') {
        btnSettings?.classList.add('is-active');
        panelSettings?.classList.remove('hidden');
      } else if (selectedTarget.type === 'overview') {
        btnOverview?.classList.add('is-active');
        panelOverview?.classList.remove('hidden');
      } else if (selectedTarget.type === 'lesson' && lessonEditorContent) {
        panelLesson?.classList.remove('hidden');

        const mod = modulesState.find((m) => String(m.id) === String(selectedTarget.modId));
        const les = mod?.lessons.find((l) => String(l.id) === String(selectedTarget.lesId));

        if (!les) {
          lessonEditorContent.innerHTML = '<p class="empty-hint">Pilih materi pelajaran dari silabus di sebelah kiri.</p>';
          return;
        }

        lessonEditorContent.innerHTML = `
          <div class="panel-card-header">
            <div class="panel-header-icon-box">
              <span class="material-symbols-outlined">${les.type === 'pkt_lab' ? 'terminal' : les.type === 'quiz' ? 'quiz' : 'menu_book'}</span>
            </div>
            <div class="panel-header-copy">
              <span class="panel-kicker">Bab: ${escapeHtml(mod?.title || 'Modul')}</span>
              <h2 class="panel-title">${escapeHtml(les.title)}</h2>
            </div>
          </div>

          <div class="lesson-meta-edit-grid">
            <div class="meta-field-group-wide">
              <label class="field-label">Judul Materi Pelajaran <span class="req-star">*</span></label>
              <input type="text" class="studio-input input-les-title" value="${escapeHtml(les.title)}" />
            </div>

            <div class="meta-field-group">
              <label class="field-label">Tipe Konten <span class="req-star">*</span></label>
              <select class="studio-select select-les-type">
                <option value="theory" ${les.type === 'theory' ? 'selected' : ''}>Teori / Pembahasan (Markdown)</option>
                <option value="pkt_lab" ${les.type === 'pkt_lab' ? 'selected' : ''}>Praktik Lab Packet Tracer (.pkt)</option>
                <option value="quiz" ${les.type === 'quiz' ? 'selected' : ''}>Kuis Evaluasi Interaktif</option>
              </select>
            </div>

            <div class="meta-field-group">
              <label class="field-label">Estimasi Waktu (Menit)</label>
              <input type="number" class="studio-input input-les-duration" value="${les.durationMinutes || 10}" min="1" max="180" />
            </div>
          </div>

          <!-- Body Editor Area Sesuai Tipe -->
          <div class="lesson-type-workspace">
            ${les.type === 'theory' ? renderTheoryEditorHtml(les) : ''}
            ${les.type === 'pkt_lab' ? renderLabEditorHtml(les) : ''}
            ${les.type === 'quiz' ? renderQuizEditorHtml(les) : ''}
          </div>
        `;

        attachLessonEditorEvents(les);
      }
    }

