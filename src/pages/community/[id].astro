---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../lib/supabase';
import { getPostById, getCommentsByPostId } from '../../lib/community';
import { getRankTier } from '../../lib/rank';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/community');
}

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const post = await getPostById(supabase, id, user.id);
if (!post) {
  return Astro.redirect('/community');
}

const comments = await getCommentsByPostId(supabase, id);
const canDelete = Boolean(user && (user.role === 'admin' || post.author_id === user.id));
const isPostAdminMod = Boolean(user && user.role === 'admin' && post.author_id !== user.id);
const canMarkSolution = Boolean(user && (user.role === 'admin' || post.author_id === user.id));
---

<BaseLayout title={post.title} description={`Diskusi komunitas: ${post.title}`}>
  <div class="page-shell post-detail-shell">
    <div class="post-detail-container">
      <!-- Back Navigation -->
      <a href="/community" class="back-link">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Kembali ke Feed Komunitas</span>
      </a>

      <!-- Main Post Card -->
      <article class="post-main-card">
        <header class="post-main-header">
          <div class="header-top-row">
            <span class="channel-pill">{post.channel?.name || post.channel_id}</span>
            {post.is_pinned && <span class="pinned-pill">Disematkan</span>}
            {post.is_solved && (
              <span class="post-solved-badge" title="Topik ini telah memiliki solusi / jawaban terbaik">
                <span class="material-symbols-outlined icon-solved">check_circle</span>
                <span>Terjawab</span>
              </span>
            )}
          </div>

          <h1 class="post-main-title">{post.title}</h1>

          <div class="author-meta-bar">
            <div class="author-avatar">
              {post.author?.avatar_url ? (
                <img src={post.author.avatar_url} alt={post.author.full_name} width="42" height="42" />
              ) : (
                <span>{(post.author?.full_name || 'U').slice(0, 1).toUpperCase()}</span>
              )}
            </div>
            <div class="author-details">
              <div class="name-row">
                <strong class="author-name">{post.author?.full_name || 'Siswa Phinisi'}</strong>
                {post.author?.role === 'admin' && <span class="role-admin-badge">Admin</span>}
                {(() => {
                  const postAuthorTier = getRankTier(post.author?.xp || 0);
                  return (
                    <span class="badge-rank-pill" style={`--tier-color: ${postAuthorTier.badgeColor};`} title={`Rank: ${postAuthorTier.name} (${post.author?.xp || 0} XP)`}>
                      <span class="material-symbols-outlined icon-rank-micro">{postAuthorTier.icon}</span>
                      <span>{postAuthorTier.name}</span>
                    </span>
                  );
                })()}
              </div>
              <span class="post-date">
                Diposting pada{' '}
                {new Date(post.created_at).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                })}
              </span>
            </div>
          </div>
        </header>

        <div class="post-main-content">
          <pre class="content-text">{post.content}</pre>
        </div>

        {post.image_url && (
          <div class="post-attached-image-wrap">
            <a href={post.image_url} target="_blank" rel="noopener noreferrer" class="post-attached-image-link" title="Buka gambar ukuran penuh di tab baru">
              <img src={post.image_url} alt={post.title} class="post-attached-img" />
            </a>
            <span class="image-caption">Lampiran Gambar (klik untuk membuka ukuran penuh)</span>
          </div>
        )}

        <footer class="post-main-footer">
          <div class="footer-left-actions">
            <button
              type="button"
              class:list={['upvote-btn', { active: post.has_upvoted }]}
              id="detail-upvote-btn"
              data-post-id={post.id}
            >
              <span class="material-symbols-outlined">thumb_up</span>
              <span id="detail-upvote-count">{post.upvotes_count}</span>
              <span>Upvote</span>
            </button>

            <span class="comment-count-indicator">
              <span class="material-symbols-outlined">mode_comment</span>
              <span>{comments.length} Komentar</span>
            </span>
          </div>

          {canDelete && (
            <button
              type="button"
              class:list={['delete-post-btn', { 'admin-mod-btn': isPostAdminMod }]}
              id="detail-delete-btn"
              data-post-id={post.id}
              data-is-admin-mod={isPostAdminMod ? 'true' : 'false'}
              title={
                isPostAdminMod
                  ? 'Hapus postingan ini sebagai wewenang moderasi Admin'
                  : 'Batalkan postingan buatan Anda'
              }
            >
              <span class="material-symbols-outlined">delete</span>
              <span>{isPostAdminMod ? 'Moderasi: Hapus' : 'Batalkan Postingan'}</span>
            </button>
          )}
        </footer>
      </article>

      <!-- Comments Section -->
      <section class="comments-section" aria-label="Kolom Komentar">
        <h2 class="comments-heading">Diskusi & Tanggapan ({comments.length})</h2>

        <!-- New Comment Form -->
        <form action="/api/community/comments" method="POST" class="comment-form">
          <input type="hidden" name="post_id" value={post.id} />
          <textarea
            name="content"
            rows="3"
            placeholder="Tulis balasan atau solusi Anda untuk topik ini..."
            required
            class="comment-textarea"
          ></textarea>
          <div class="comment-form-actions">
            <button type="submit" class="comment-submit-btn">Kirim Balasan</button>
          </div>
        </form>

        <!-- Comments List -->
        {comments.length === 0 ? (
          <div class="empty-comments">
            <p>Belum ada balasan pada topik ini. Jadilah yang pertama memberikan solusi!</p>
          </div>
        ) : (
          <div class="comments-list">
            {comments.map((comment) => {
              const isThisSolution = Boolean(post.is_solved && post.solved_comment_id === comment.id);
              const canDeleteComment = Boolean(user && (user.role === 'admin' || comment.author_id === user.id));
              const isCommentAdminMod = Boolean(user && user.role === 'admin' && comment.author_id !== user.id);

              return (
                <div class:list={['comment-item', { 'is-solution': isThisSolution }]} id={`comment-${comment.id}`}>
                  <div class="comment-avatar">
                    {comment.author?.avatar_url ? (
                      <img src={comment.author.avatar_url} alt={comment.author.full_name} width="34" height="34" />
                    ) : (
                      <span>{(comment.author?.full_name || 'U').slice(0, 1).toUpperCase()}</span>
                    )}
                  </div>
                  <div class="comment-body">
                    <div class="comment-header">
                      <div class="comment-author-name">
                        <strong>{comment.author?.full_name || 'Siswa Phinisi'}</strong>
                        {comment.author?.role === 'admin' && <span class="role-admin-badge">Admin</span>}
                        {(() => {
                          const commentAuthorTier = getRankTier(comment.author?.xp || 0);
                          return (
                            <span class="badge-rank-pill" style={`--tier-color: ${commentAuthorTier.badgeColor};`} title={`Rank: ${commentAuthorTier.name} (${comment.author?.xp || 0} XP)`}>
                              <span class="material-symbols-outlined icon-rank-micro">{commentAuthorTier.icon}</span>
                              <span>{commentAuthorTier.name}</span>
                            </span>
                          );
                        })()}
                        {isThisSolution && (
                          <span class="solution-badge" title="Telah ditandai sebagai solusi / jawaban terbaik (+50 XP)">
                            <span class="material-symbols-outlined icon-badge-check">check_circle</span>
                            <span>Jawaban Terbaik (+50 XP)</span>
                          </span>
                        )}
                      </div>
                      <div class="comment-header-meta">
                        <span class="comment-time">
                          {new Date(comment.created_at).toLocaleDateString('id-ID', {
                            day: 'numeric',
                            month: 'short',
                            hour: '2-digit',
                            minute: '2-digit',
                          })}
                        </span>

                        <div class="comment-actions">
                          {canMarkSolution && (
                            <button
                              type="button"
                              class:list={['btn-action-solution', { 'is-active': isThisSolution }]}
                              data-action="toggle-solution"
                              data-post-id={post.id}
                              data-comment-id={comment.id}
                              title={
                                isThisSolution
                                  ? 'Batalkan tanda solusi dari balasan ini'
                                  : 'Tandai balasan ini sebagai solusi terbaik (+50 XP untuk penjawab)'
                              }
                            >
                              <span class="material-symbols-outlined icon-act">
                                {isThisSolution ? 'check_circle' : 'task_alt'}
                              </span>
                              <span>{isThisSolution ? 'Solusi' : 'Tandai Solusi'}</span>
                            </button>
                          )}

                          {canDeleteComment && (
                            <button
                              type="button"
                              class:list={['btn-action-delete-comment', { 'admin-mod-btn': isCommentAdminMod }]}
                              data-action="delete-comment"
                              data-comment-id={comment.id}
                              data-is-admin-mod={isCommentAdminMod ? 'true' : 'false'}
                              title={
                                isCommentAdminMod
                                  ? 'Hapus komentar ini sebagai wewenang moderasi Admin'
                                  : 'Hapus komentar Anda'
                              }
                            >
                              <span class="material-symbols-outlined icon-act">delete</span>
                              <span>{isCommentAdminMod ? 'Moderasi' : 'Hapus'}</span>
                            </button>
                          )}
                        </div>
                      </div>
                    </div>
                    <div class="comment-content">
                      <pre class="comment-text">{comment.content}</pre>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        )}
      </section>
    </div>
  </div>

  <script>
    const upvoteBtn = document.getElementById('detail-upvote-btn');
    const countSpan = document.getElementById('detail-upvote-count');

    if (upvoteBtn) {
      upvoteBtn.addEventListener('click', async () => {
        const postId = upvoteBtn.dataset.postId;
        if (!postId) return;

        try {
          const res = await fetch('/api/community/upvote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ post_id: postId }),
          });
          const data = await res.json();
          if (data.success) {
            upvoteBtn.classList.toggle('active', data.hasUpvoted);
            if (countSpan) countSpan.textContent = String(data.count);
          }
        } catch (err) {
          console.error('Gagal upvote:', err);
        }
      });
    }

    const deleteBtn = document.getElementById('detail-delete-btn');
    if (deleteBtn) {
      deleteBtn.addEventListener('click', async () => {
        const postId = deleteBtn.dataset.postId;
        if (!postId) return;

        const isMod = deleteBtn.dataset.isAdminMod === 'true';
        const confirmMsg = isMod
          ? 'Apakah Anda yakin ingin menghapus postingan ini sebagai tindakan moderasi Admin? Tindakan ini tidak dapat dibatalkan.'
          : 'Apakah Anda yakin ingin membatalkan dan menghapus postingan ini? Tindakan ini tidak dapat dibatalkan.';

        const confirmed = window.confirm(confirmMsg);
        if (!confirmed) return;

        deleteBtn.setAttribute('disabled', 'true');
        deleteBtn.textContent = 'Menghapus...';

        try {
          const res = await fetch('/api/community/posts', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ post_id: postId }),
          });

          const data = await res.json().catch(() => ({}));
          if (res.ok && data.success) {
            window.location.href = '/community';
          } else {
            alert(data.error || 'Gagal menghapus postingan. Silakan coba lagi.');
            deleteBtn.removeAttribute('disabled');
            deleteBtn.innerHTML = `<span class="material-symbols-outlined">delete</span><span>${isMod ? 'Moderasi: Hapus' : 'Batalkan Postingan'}</span>`;
          }
        } catch (err) {
          console.error('Gagal menghapus postingan:', err);
          alert('Terjadi kesalahan koneksi saat menghapus postingan.');
          deleteBtn.removeAttribute('disabled');
          deleteBtn.innerHTML = `<span class="material-symbols-outlined">delete</span><span>${isMod ? 'Moderasi: Hapus' : 'Batalkan Postingan'}</span>`;
        }
      });
    }

    // Toggle Solution
    const solutionButtons = document.querySelectorAll('button[data-action="toggle-solution"]');
    solutionButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetBtn = btn as HTMLButtonElement;
        const postId = targetBtn.dataset.postId;
        const commentId = targetBtn.dataset.commentId;
        if (!postId || !commentId) return;

        targetBtn.disabled = true;
        try {
          const res = await fetch('/api/community/solution', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ post_id: postId, comment_id: commentId }),
          });

          const data = await res.json().catch(() => ({}));
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error || 'Gagal memperbarui status solusi.');
            targetBtn.disabled = false;
          }
        } catch (err) {
          console.error('Gagal memperbarui status solusi:', err);
          alert('Terjadi kesalahan koneksi saat memproses status solusi.');
          targetBtn.disabled = false;
        }
      });
    });

    // Delete Comment
    const deleteCommentButtons = document.querySelectorAll('button[data-action="delete-comment"]');
    deleteCommentButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const targetBtn = btn as HTMLButtonElement;
        const commentId = targetBtn.dataset.commentId;
        if (!commentId) return;

        const isMod = targetBtn.dataset.isAdminMod === 'true';
        const confirmMsg = isMod
          ? 'Apakah Anda yakin ingin menghapus komentar ini sebagai tindakan moderasi Admin?'
          : 'Apakah Anda yakin ingin menghapus komentar ini?';

        const confirmed = window.confirm(confirmMsg);
        if (!confirmed) return;

        targetBtn.disabled = true;
        try {
          const res = await fetch('/api/community/comments', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ comment_id: commentId }),
          });

          const data = await res.json().catch(() => ({}));
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.error || 'Gagal menghapus komentar.');
            targetBtn.disabled = false;
          }
        } catch (err) {
          console.error('Gagal menghapus komentar:', err);
          alert('Terjadi kesalahan koneksi saat menghapus komentar.');
          targetBtn.disabled = false;
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .post-detail-shell {
    padding-block: 2rem 4rem;
  }
  .post-detail-container {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 120ms ease;
  }
  .back-link:hover {
    color: var(--color-phinisi-700);
  }

  /* Main Post */
  .post-main-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 6px 24px rgba(8, 26, 58, 0.04);
  }
  .header-top-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .channel-pill {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--color-phinisi-700);
    background: var(--color-phinisi-50);
    padding: 0.25rem 0.6rem;
    border-radius: 0.45rem;
  }
  .pinned-pill {
    font-size: 0.72rem;
    font-weight: 800;
    color: #92400e;
    background: var(--color-gold-soft);
    padding: 0.25rem 0.6rem;
    border-radius: 0.45rem;
  }
  .post-solved-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    background: #dcfce7;
    color: #15803d;
    border: 1px solid #bbf7d0;
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.22rem 0.6rem;
    border-radius: 0.45rem;
  }
  .icon-solved {
    font-size: 0.95rem;
  }
  .post-main-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-navy);
    margin: 0 0 1.25rem 0;
    line-height: 1.35;
  }
  .author-meta-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  .author-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-phinisi-100);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-phinisi-700);
    font-size: 0.95rem;
  }
  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-details {
    display: flex;
    flex-direction: column;
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .author-name {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-navy);
  }
  .role-admin-badge {
    background: #fee2e2;
    color: #991b1b;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
  }
  .badge-rank-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tier-color, #0284c7) 12%, transparent);
    color: var(--tier-color, #0284c7);
    border: 1px solid color-mix(in srgb, var(--tier-color, #0284c7) 30%, transparent);
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .icon-rank-micro {
    font-size: 0.8rem;
  }
  .post-date {
    font-size: 0.74rem;
    color: var(--color-muted);
  }

  /* Content */
  .post-main-content {
    padding-block: 1.5rem;
  }
  .content-text {
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-ink);
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
  }

  /* Attached Image */
  .post-attached-image-wrap {
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .post-attached-image-link {
    display: block;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: #f8fafc;
    transition: box-shadow 150ms ease, border-color 150ms ease;
  }
  .post-attached-image-link:hover {
    border-color: var(--color-phinisi-400);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }
  .post-attached-img {
    display: block;
    max-width: 100%;
    max-height: 560px;
    width: auto;
    object-fit: contain;
    border-radius: 0.75rem;
  }
  .image-caption {
    font-size: 0.75rem;
    color: var(--color-muted);
    font-style: italic;
  }

  /* Footer */
  .post-main-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
    flex-wrap: wrap;
  }
  .footer-left-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .delete-post-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid #fecaca;
    border-radius: 0.65rem;
    background: #fef2f2;
    color: #b91c1c;
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 150ms ease;
  }
  .delete-post-btn:hover {
    background: #fee2e2;
    border-color: #f87171;
    color: #991b1b;
  }
  .delete-post-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .delete-post-btn.admin-mod-btn {
    background: #fff1f2;
    border-color: #fda4af;
    color: #be123c;
  }
  .delete-post-btn.admin-mod-btn:hover {
    background: #ffe4e6;
    border-color: #f43f5e;
    color: #9f1239;
  }
  .delete-post-btn span.material-symbols-outlined {
    font-size: 1.1rem;
  }
  .upvote-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: #ffffff;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 150ms ease;
  }
  .upvote-btn:hover {
    background: var(--color-phinisi-50);
    color: var(--color-phinisi-700);
  }
  .upvote-btn.active {
    background: var(--color-phinisi-100);
    border-color: var(--color-phinisi-400);
    color: var(--color-phinisi-700);
  }
  .comment-count-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* Comments */
  .comments-section {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .comments-heading {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .comment-textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.85rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.5;
    outline: none;
    resize: vertical;
