---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createSupabaseServerClient } from '../../lib/supabase';
import { getPostById, getCommentsByPostId } from '../../lib/community';

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/community');
}

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const post = await getPostById(supabase, id, user.id);
if (!post) {
  return Astro.redirect('/community');
}

const comments = await getCommentsByPostId(supabase, id);
---

<BaseLayout title={post.title} description={`Diskusi komunitas: ${post.title}`}>
  <div class="page-shell post-detail-shell">
    <div class="post-detail-container">
      <!-- Back Navigation -->
      <a href="/community" class="back-link">
        <span class="material-symbols-outlined">arrow_back</span>
        <span>Kembali ke Feed Komunitas</span>
      </a>

      <!-- Main Post Card -->
      <article class="post-main-card">
        <header class="post-main-header">
          <div class="header-top-row">
            <span class="channel-pill">{post.channel?.name || post.channel_id}</span>
            {post.is_pinned && <span class="pinned-pill">Disematkan</span>}
          </div>

          <h1 class="post-main-title">{post.title}</h1>

          <div class="author-meta-bar">
            <div class="author-avatar">
              {post.author?.avatar_url ? (
                <img src={post.author.avatar_url} alt={post.author.full_name} width="42" height="42" />
              ) : (
                <span>{(post.author?.full_name || 'U').slice(0, 1).toUpperCase()}</span>
              )}
            </div>
            <div class="author-details">
              <div class="name-row">
                <strong class="author-name">{post.author?.full_name || 'Siswa Phinisi'}</strong>
                {post.author?.role === 'admin' && <span class="role-admin-badge">Admin</span>}
              </div>
              <span class="post-date">
                Diposting pada{' '}
                {new Date(post.created_at).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric',
                  hour: '2-digit',
                  minute: '2-digit',
                })}
              </span>
            </div>
          </div>
        </header>

        <div class="post-main-content">
          <pre class="content-text">{post.content}</pre>
        </div>

        <footer class="post-main-footer">
          <button
            type="button"
            class:list={['upvote-btn', { active: post.has_upvoted }]}
            id="detail-upvote-btn"
            data-post-id={post.id}
          >
            <span class="material-symbols-outlined">thumb_up</span>
            <span id="detail-upvote-count">{post.upvotes_count}</span>
            <span>Upvote</span>
          </button>

          <span class="comment-count-indicator">
            <span class="material-symbols-outlined">mode_comment</span>
            <span>{comments.length} Komentar</span>
          </span>
        </footer>
      </article>

      <!-- Comments Section -->
      <section class="comments-section" aria-label="Kolom Komentar">
        <h2 class="comments-heading">Diskusi & Tanggapan ({comments.length})</h2>

        <!-- New Comment Form -->
        <form action="/api/community/comments" method="POST" class="comment-form">
          <input type="hidden" name="post_id" value={post.id} />
          <textarea
            name="content"
            rows="3"
            placeholder="Tulis balasan atau solusi Anda untuk topik ini..."
            required
            class="comment-textarea"
          ></textarea>
          <div class="comment-form-actions">
            <button type="submit" class="comment-submit-btn">Kirim Balasan</button>
          </div>
        </form>

        <!-- Comments List -->
        {comments.length === 0 ? (
          <div class="empty-comments">
            <p>Belum ada balasan pada topik ini. Jadilah yang pertama memberikan solusi!</p>
          </div>
        ) : (
          <div class="comments-list">
            {comments.map((comment) => (
              <div class="comment-item">
                <div class="comment-avatar">
                  {comment.author?.avatar_url ? (
                    <img src={comment.author.avatar_url} alt={comment.author.full_name} width="34" height="34" />
                  ) : (
                    <span>{(comment.author?.full_name || 'U').slice(0, 1).toUpperCase()}</span>
                  )}
                </div>
                <div class="comment-body">
                  <div class="comment-header">
                    <div class="comment-author-name">
                      <strong>{comment.author?.full_name || 'Siswa Phinisi'}</strong>
                      {comment.author?.role === 'admin' && <span class="role-admin-badge">Admin</span>}
                    </div>
                    <span class="comment-time">
                      {new Date(comment.created_at).toLocaleDateString('id-ID', {
                        day: 'numeric',
                        month: 'short',
                        hour: '2-digit',
                        minute: '2-digit',
                      })}
                    </span>
                  </div>
                  <div class="comment-content">
                    <pre class="comment-text">{comment.content}</pre>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </section>
    </div>
  </div>

  <script>
    const upvoteBtn = document.getElementById('detail-upvote-btn');
    const countSpan = document.getElementById('detail-upvote-count');

    if (upvoteBtn) {
      upvoteBtn.addEventListener('click', async () => {
        const postId = upvoteBtn.dataset.postId;
        if (!postId) return;

        try {
          const res = await fetch('/api/community/upvote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ post_id: postId }),
          });
          const data = await res.json();
          if (data.success) {
            upvoteBtn.classList.toggle('active', data.hasUpvoted);
            if (countSpan) countSpan.textContent = String(data.count);
          }
        } catch (err) {
          console.error('Gagal upvote:', err);
        }
      });
    }
  </script>
</BaseLayout>

<style>
  .post-detail-shell {
    padding-block: 2rem 4rem;
  }
  .post-detail-container {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-muted);
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    transition: color 120ms ease;
  }
  .back-link:hover {
    color: var(--color-phinisi-700);
  }

  /* Main Post */
  .post-main-card {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 6px 24px rgba(8, 26, 58, 0.04);
  }
  .header-top-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .channel-pill {
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--color-phinisi-700);
    background: var(--color-phinisi-50);
    padding: 0.25rem 0.6rem;
    border-radius: 0.45rem;
  }
  .pinned-pill {
    font-size: 0.72rem;
    font-weight: 800;
    color: #92400e;
    background: var(--color-gold-soft);
    padding: 0.25rem 0.6rem;
    border-radius: 0.45rem;
  }
  .post-main-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--color-navy);
    margin: 0 0 1.25rem 0;
    line-height: 1.35;
  }
  .author-meta-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  .author-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-phinisi-100);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-phinisi-700);
    font-size: 0.95rem;
  }
  .author-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .author-details {
    display: flex;
    flex-direction: column;
  }
  .name-row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .author-name {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-navy);
  }
  .role-admin-badge {
    background: #fee2e2;
    color: #991b1b;
    font-size: 0.6rem;
    font-weight: 800;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
  }
  .post-date {
    font-size: 0.74rem;
    color: var(--color-muted);
  }

  /* Content */
  .post-main-content {
    padding-block: 1.5rem;
  }
  .content-text {
    font-family: var(--font-body);
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--color-ink);
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
  }

  /* Footer */
  .post-main-footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-line);
  }
  .upvote-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
    background: #ffffff;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 150ms ease;
  }
  .upvote-btn:hover {
    background: var(--color-phinisi-50);
    color: var(--color-phinisi-700);
  }
  .upvote-btn.active {
    background: var(--color-phinisi-100);
    border-color: var(--color-phinisi-400);
    color: var(--color-phinisi-700);
  }
  .comment-count-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }

  /* Comments */
  .comments-section {
    background: #ffffff;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .comments-heading {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0;
  }
  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .comment-textarea {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 0.85rem;
    font-family: var(--font-body);
    font-size: 0.88rem;
    line-height: 1.5;
    outline: none;
    resize: vertical;
  }
  .comment-textarea:focus {
    border-color: var(--color-phinisi-500);
  }
  .comment-form-actions {
    display: flex;
    justify-content: flex-end;
  }
  .comment-submit-btn {
    background: var(--color-phinisi-600);
    color: #ffffff;
    border: none;
    border-radius: 0.75rem;
    padding: 0.6rem 1.25rem;
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .comment-submit-btn:hover {
    background: var(--color-phinisi-700);
  }
  .empty-comments {
    padding: 1.5rem;
    text-align: center;
    color: var(--color-muted);
    font-size: 0.85rem;
    background: var(--color-section);
    border-radius: 0.85rem;
  }
  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .comment-item {
    display: flex;
    gap: 0.85rem;
    padding: 1.15rem;
    background: var(--color-section);
    border-radius: 1rem;
  }
  .comment-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-phinisi-200);
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--color-phinisi-800);
    font-size: 0.8rem;
    flex-shrink: 0;
  }
  .comment-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .comment-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .comment-author-name {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.82rem;
    color: var(--color-navy);
  }
  .comment-time {
    font-size: 0.7rem;
    color: var(--color-muted);
  }
  .comment-text {
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-ink);
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
