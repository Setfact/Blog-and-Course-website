---
import BaseLayout from '../layouts/BaseLayout.astro';
import { isSupabaseConfigured, getSupabaseUrl, getSupabaseAnonKey } from '../lib/supabase';

const user = Astro.locals.user;
const redirectParam = Astro.url.searchParams.get('redirect') || '/dashboard';
const errorParam = Astro.url.searchParams.get('error');

if (user) {
  return Astro.redirect(redirectParam);
}

const supabaseReady = isSupabaseConfigured();
const supabaseUrl = getSupabaseUrl();
const supabaseAnonKey = getSupabaseAnonKey();

let bannerMessage = '';
if (redirectParam.startsWith('/community')) {
  bannerMessage = 'Silakan masuk dengan akun Google untuk bergabung ke Komunitas Siswa Phinisi Learn.';
} else if (redirectParam.startsWith('/admin')) {
  bannerMessage = 'Halaman Administrator memerlukan login dengan akun berwenang.';
}
---

<BaseLayout title="Masuk" description="Masuk ke Phinisi Learn untuk mengakses komunitas, menyimpan progres belajar, dan meraih badge.">
  <div
    class="login-wrapper"
    id="login-page-root"
    data-supabase-url={supabaseUrl}
    data-supabase-key={supabaseAnonKey}
    data-redirect={redirectParam}
  >
    <div class="login-card">
      <div class="card-header">
        <a href="/" class="brand-link" aria-label="Kembali ke Beranda">
          <img src="/Logo Phinisi Learn.png" alt="Phinisi Learn" width="160" height="54" />
        </a>
        <h1 class="login-title">Masuk ke Akun Anda</h1>
        <p class="login-subtitle">Akses komunitas teknis, simpan progres belajar lintas perangkat, dan kumpulkan poin XP.</p>
      </div>

      <!-- Auth Processing Spinner -->
      <div id="auth-loading-state" class="loading-box" style="display: none;">
        <div class="spinner"></div>
        <p>Memverifikasi sesi Google Anda, mohon tunggu...</p>
      </div>

      {bannerMessage && (
        <div class="info-alert" role="status">
          <span class="material-symbols-outlined icon">info</span>
          <p>{bannerMessage}</p>
        </div>
      )}

      {errorParam && (
        <div class="error-alert" role="alert">
          <span class="material-symbols-outlined icon">error</span>
          <p>{decodeURIComponent(errorParam)}</p>
        </div>
      )}

      {!supabaseReady ? (
        <div class="config-alert">
          <span class="material-symbols-outlined icon">warning</span>
          <div>
            <strong>Konfigurasi Diperlukan</strong>
            <p>Variabel <code>PUBLIC_SUPABASE_URL</code> dan <code>PUBLIC_SUPABASE_ANON_KEY</code> belum diisi pada file <code>.env</code>.</p>
            <p class="helper-text">Isi kredensial Supabase Anda untuk mengaktifkan fitur Google OAuth.</p>
          </div>
        </div>
      ) : (
        <div class="action-wrap" id="login-actions">
          <button type="button" id="btn-google-login" class="google-btn">
            <svg class="google-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Lanjutkan dengan Google</span>
          </button>

          <p class="admin-hint">
            <span class="material-symbols-outlined">shield_person</span>
            <span>Akun Superadmin: <strong>calvinum26@gmail.com</strong></span>
          </p>
        </div>
      )}

      <div class="card-footer">
        <p>Dengan masuk, Anda menyetujui <a href="/terms">Ketentuan Layanan</a> dan <a href="/privacy">Kebijakan Privasi</a> Phinisi Learn.</p>
      </div>
    </div>
  </div>

  <script>
    import { createBrowserClient } from '@supabase/ssr';

    const root = document.getElementById('login-page-root');
    const supabaseUrl = root?.dataset.supabaseUrl;
    const supabaseKey = root?.dataset.supabaseKey;
    const targetRedirect = root?.dataset.redirect || '/dashboard';
    const loadingBox = document.getElementById('auth-loading-state');
    const actionsBox = document.getElementById('login-actions');
    const googleBtn = document.getElementById('btn-google-login');

    if (supabaseUrl && supabaseKey) {
      const supabase = createBrowserClient(supabaseUrl, supabaseKey);

      // Fungsi untuk sinkronisasi token ke backend session
      const syncSessionAndRedirect = async (accessToken: string, refreshToken: string) => {
        if (loadingBox) loadingBox.style.display = 'flex';
        if (actionsBox) actionsBox.style.display = 'none';

        try {
          const res = await fetch('/api/auth/session', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              access_token: accessToken,
              refresh_token: refreshToken,
            }),
          });
          const data = await res.json();
          if (data.success) {
            window.location.replace(targetRedirect);
            return;
          }
        } catch (err) {
          console.error('Gagal sinkronisasi sesi:', err);
        }

        if (loadingBox) loadingBox.style.display = 'none';
        if (actionsBox) actionsBox.style.display = 'flex';
      };

      // 1. Periksa apakah URL memuat access_token di fragment hash (#access_token=...)
      const hash = window.location.hash;
      if (hash && hash.includes('access_token=')) {
        const params = new URLSearchParams(hash.replace(/^#/, ''));
        const accessToken = params.get('access_token');
        const refreshToken = params.get('refresh_token');

        if (accessToken && refreshToken) {
          syncSessionAndRedirect(accessToken, refreshToken);
        }
      } else {
        // 2. Periksa apakah browser sudah memiliki sesi aktif
        supabase.auth.getSession().then(({ data: { session } }) => {
          if (session?.access_token && session?.refresh_token) {
            syncSessionAndRedirect(session.access_token, session.refresh_token);
          }
        });
      }

      // 3. Listener tombol login Google
      if (googleBtn) {
        googleBtn.addEventListener('click', async () => {
          if (googleBtn instanceof HTMLButtonElement) googleBtn.disabled = true;
          if (loadingBox) loadingBox.style.display = 'flex';
          if (actionsBox) actionsBox.style.display = 'none';

          const callbackUrl = `${window.location.origin}/api/auth/callback?redirect=${encodeURIComponent(targetRedirect)}`;

          const { data, error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo: callbackUrl,
              queryParams: {
                access_type: 'offline',
                prompt: 'consent',
              },
            },
          });

          if (error) {
            alert('Gagal memulai login Google: ' + error.message);
            if (googleBtn instanceof HTMLButtonElement) googleBtn.disabled = false;
            if (loadingBox) loadingBox.style.display = 'none';
            if (actionsBox) actionsBox.style.display = 'flex';
          }
        });
      }
    }
  </script>
</BaseLayout>

<style>
  .login-wrapper {
    display: flex;
    min-height: calc(100vh - 180px);
    align-items: center;
    justify-content: center;
    padding: 2.5rem 1.25rem;
    background: radial-gradient(circle at 50% 20%, var(--color-section) 0%, var(--color-canvas) 85%);
  }
  .login-card {
    width: 100%;
    max-width: 460px;
    border: 1px solid var(--color-line);
    border-radius: 1.5rem;
    background: #ffffff;
    padding: 2.5rem 2rem;
    box-shadow: 0 12px 35px -8px rgba(8, 26, 58, 0.08);
  }
  .card-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }
  .brand-link {
    display: inline-block;
    margin-bottom: 1.25rem;
  }
  .brand-link img {
    display: block;
    margin: 0 auto;
    object-fit: contain;
  }
  .login-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 0.5rem 0;
  }
  .login-subtitle {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }
  .loading-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    background: var(--color-phinisi-50);
    border: 1px solid var(--color-phinisi-200);
    border-radius: 1rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }
  .loading-box p {
    margin: 0;
    font-size: 0.84rem;
    color: var(--color-phinisi-800);
    font-weight: 600;
  }
  .spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--color-phinisi-200);
    border-top-color: var(--color-phinisi-600);
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .info-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 0.85rem;
    background: var(--color-phinisi-50);
    border: 1px solid var(--color-phinisi-200);
    color: var(--color-phinisi-800);
    font-size: 0.82rem;
    margin-bottom: 1.5rem;
  }
  .error-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 0.85rem;
    background: var(--color-danger-soft);
    border: 1px solid #f8b4b4;
    color: var(--color-danger);
    font-size: 0.82rem;
    margin-bottom: 1.5rem;
  }
  .config-alert {
    display: flex;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: 0.85rem;
    background: var(--color-gold-soft);
    border: 1px solid #f6d28b;
    color: #7a5100;
    font-size: 0.82rem;
    margin-bottom: 1.5rem;
  }
  .config-alert strong {
    display: block;
    font-size: 0.88rem;
    margin-bottom: 0.25rem;
  }
  .config-alert code {
    background: rgba(0, 0, 0, 0.06);
    padding: 0.15rem 0.35rem;
    border-radius: 0.3rem;
    font-family: var(--font-mono);
  }
  .config-alert .helper-text {
    margin: 0.35rem 0 0 0;
    font-size: 0.76rem;
  }
  .icon {
    font-size: 1.25rem;
    flex-shrink: 0;
  }
  .action-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }
  .google-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.9rem;
    background: #ffffff;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    transition: all 150ms ease;
  }
  .google-btn:hover {
    background: var(--color-phinisi-50);
    border-color: var(--color-phinisi-300);
    box-shadow: 0 4px 12px rgba(20, 91, 215, 0.12);
  }
  .google-icon {
    flex-shrink: 0;
  }
  .admin-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.75rem;
  }
  .admin-hint .material-symbols-outlined {
    font-size: 1rem;
    color: var(--color-phinisi-600);
  }
  .card-footer {
    border-top: 1px solid var(--color-line);
    padding-top: 1.25rem;
    text-align: center;
  }
  .card-footer p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }
  .card-footer a {
    color: var(--color-phinisi-700);
    text-decoration: underline;
  }
</style>
